#pragma kernel SetupMeshDrawArgs

#include "CSCommon.cginc"

RWStructuredBuffer<APICParticle> _ApicParticle;
RWStructuredBuffer<int> _ApicMassInt;
RWStructuredBuffer<int> _ApicVelIntX;
RWStructuredBuffer<int> _ApicVelIntY;
RWStructuredBuffer<int> _ApicVelIntZ;
RWStructuredBuffer<float> _ApicDivergence;
RWStructuredBuffer<float> _ApicPressure_W;
StructuredBuffer<SWECell> _SweState_R;
RWStructuredBuffer<int> _DeltaHInt;
RWStructuredBuffer<int> _DeltaHuInt;
RWStructuredBuffer<int> _DeltaHvInt;
RWStructuredBuffer<float> _PcgR;       
RWStructuredBuffer<float> _PcgP;       
RWStructuredBuffer<float> _PcgQ;       
RWStructuredBuffer<float> _PcgPrecon;  
RWStructuredBuffer<uint> _PcgDotResult; 
RWStructuredBuffer<float> _PcgScalars; 
AppendStructuredBuffer<uint> _ActiveParticleList_W;
StructuredBuffer<uint> _ActiveParticleList_R;
ByteAddressBuffer _ActiveParticleCount; 
RWStructuredBuffer<uint> _ParticleDispatchArgs;
RWStructuredBuffer<uint> _DrawArgsBuffer;
Texture2D<float> TerrainHeightMap;
Texture2D<float4> FFT_DispLOD0;
Texture2D<float4> FFT_DispLOD1;
Texture2D<float4> FFT_DispLOD2;
float FFT_Size0, FFT_Size1, FFT_Size2;

uint max_particles;
float horizontal_momentum_transfer;
float vertical_momentum_to_wave;

SamplerState sampler_LinearRepeat {
    Filter = MIN_MAG_MIP_LINEAR;
    AddressU = Wrap;
    AddressV = Wrap;
};

// ==========================================
// ヘルパー関数
// ==========================================
float GetFFTSurfaceY(float2 worldPos) {
    float2 uv0 = worldPos / FFT_Size0;
    float2 uv1 = worldPos / FFT_Size1;
    float2 uv2 = worldPos / FFT_Size2;
    float y0 = FFT_DispLOD0.SampleLevel(sampler_LinearRepeat, uv0, 0).y;
    float y1 = FFT_DispLOD1.SampleLevel(sampler_LinearRepeat, uv1, 0).y;
    float y2 = FFT_DispLOD2.SampleLevel(sampler_LinearRepeat, uv2, 0).y;
    return y0 + y1 + y2;
}

// APICの原点を海面(0m)からグリッドの高さ半分だけ下げた位置にする
inline float3 GetAPICOrigin() {
    return float3(
        _WorldOffset.x,
        _WorldOffset.y,
        - (_ApicGridRes.z * 0.5f) * _dxApic
    );
}

// Bスプライン補間
inline float3 QuadraticBSpline(float3 x) {
    float3 abs_x = abs(x);
    return (abs_x < 0.5f) ? (0.75f - abs_x * abs_x) : ((abs_x < 1.5f) ? (0.5f * (1.5f - abs_x) * (1.5f - abs_x)) : 0.0f);
}

inline uint FlattenIndex(uint3 id) {
    return id.z * (_ApicGridRes.x * _ApicGridRes.y) + id.y * _ApicGridRes.x + id.x;
}

inline float4 GetSWEBoundaryInfo(uint3 apic_id) {
    float3 apic_origin = GetAPICOrigin();
    float2 cell_world_pos = apic_origin.xy + (float2(apic_id.x, apic_id.y) + 0.5f) * _dxApic;
    float2 swe_local_pos = cell_world_pos - _WorldOffset;
    
    int swe_x = clamp((int)floor(swe_local_pos.x / _dxSwe), 0, (int)_SweGridRes.x - 1);
    int swe_y = clamp((int)floor(swe_local_pos.y / _dxSwe), 0, (int)_SweGridRes.y - 1);
    
    float smoothed_h = 0.0f; float smoothed_hu = 0.0f; float smoothed_hv = 0.0f; float weight_sum = 0.0f;
    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            int nx = clamp(swe_x + i, 0, (int)_SweGridRes.x - 1);
            int ny = clamp(swe_y + j, 0, (int)_SweGridRes.y - 1);
            SWECell n_swe = _SweState_R[ny * _SweGridRes.x + nx];
            float w = (i == 0 && j == 0) ? 4.0f : ((abs(i) + abs(j) == 1) ? 2.0f : 1.0f);
            smoothed_h += n_swe.h * w; smoothed_hu += n_swe.hu * w; smoothed_hv += n_swe.hv * w; weight_sum += w;
        }
    }
    smoothed_h /= weight_sum; smoothed_hu /= weight_sum; smoothed_hv /= weight_sum;

    float z_bottom = apic_origin.z + apic_id.z * _dxApic;

    int flipped_y = (int)_SweGridRes.y - 1 - swe_y;
    float b_c = TerrainHeightMap.Load(int3(swe_x, flipped_y, 0)).r;
    float fft_y = GetFFTSurfaceY(cell_world_pos);
    float swe_surface_y = b_c + smoothed_h + fft_y;

    float phi = clamp((swe_surface_y - z_bottom) / _dxApic, 0.0f, 1.0f);
    float theta = 1.0f - phi;
    float u_swe = (smoothed_h > 0.001f) ? smoothed_hu / smoothed_h : 0.0f;
    float v_swe = (smoothed_h > 0.001f) ? smoothed_hv / smoothed_h : 0.0f;
    return float4(u_swe, v_swe, 0.0f, theta);
}

inline bool IsObstacle(uint3 id) {
    float3 apic_origin = GetAPICOrigin();
    float2 cell_world_pos = apic_origin.xy + (float2(id.x, id.y) + 0.5f) * _dxApic;
    float2 swe_local_pos = cell_world_pos - _WorldOffset;
    int swe_x = clamp((int)floor(swe_local_pos.x / _dxSwe), 0, (int)_SweGridRes.x - 1);
    int swe_y = clamp((int)floor(swe_local_pos.y / _dxSwe), 0, (int)_SweGridRes.y - 1);
    
    int flipped_y = (int)_SweGridRes.y - 1 - swe_y;
    float b_c = TerrainHeightMap.Load(int3(swe_x, flipped_y, 0)).r;
    float z_bottom = apic_origin.z + id.z * _dxApic;
    
    // SWEの水深(h_swe)は含めず、純粋な地形のみを障害物とする
    return z_bottom <= b_c;
}

inline float GetData(RWStructuredBuffer<int> velBuffer, uint3 id, uint axis, float defaultValue) {
    if (id[axis] >= (uint)_ApicGridRes[axis] - 1 || id[axis] <= 0 || IsObstacle(id)) return defaultValue;
    return asfloat(velBuffer[FlattenIndex(id)]);
}

inline float GetData(RWStructuredBuffer<float> velBuffer, uint3 id, uint axis, float defaultValue) {
    if (id[axis] >= (uint)_ApicGridRes[axis] - 1 || IsObstacle(id)) return defaultValue;
    return asfloat(velBuffer[FlattenIndex(id)]);
}

// ==========================================
// 初期化カーネル
// ==========================================
[numthreads(8, 8, 8)]
void ClearApicGrid (uint3 id : SV_DispatchThreadID) {
    if (any(id >= (uint3)_ApicGridRes)) return;
    uint idx = FlattenIndex(id);
    _ApicMassInt[idx] = 0; _ApicVelIntX[idx] = 0; _ApicVelIntY[idx] = 0; _ApicVelIntZ[idx] = 0;
    _ApicDivergence[idx] = 0.0f; _ApicPressure_W[idx] = 0.0f;
}

[numthreads(64, 1, 1)]
void BuildActiveList(uint3 id : SV_DispatchThreadID) {
    if (id.x >= max_particles) return;
    if (_ApicParticle[id.x].mass > 0.0f) _ActiveParticleList_W.Append(id.x);
}

[numthreads(1, 1, 1)]
void SetupDispatchArgs(uint3 id : SV_DispatchThreadID) {
    _ParticleDispatchArgs[0] = (_ParticleDispatchArgs[0] + 63) / 64; 
    _ParticleDispatchArgs[1] = 1; _ParticleDispatchArgs[2] = 1; 
}

[numthreads(1, 1, 1)]
void SetupMeshDrawArgs(uint3 id : SV_DispatchThreadID) {
    _DrawArgsBuffer[1] = _ActiveParticleCount.Load(0) * 3; 
}

// ==========================================
// APICメイン
// ==========================================
[numthreads(64, 1, 1)]
void Advect (uint3 id : SV_DispatchThreadID) {
    uint count = _ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    uint index = _ActiveParticleList_R[id.x];
    APICParticle p = _ApicParticle[index];
    if (p.mass <= 0.0f) return;

    p.velocity.z -= GRAVITY * _dtApic;
    p.position += p.velocity * _dtApic;

    float3 apic_origin = GetAPICOrigin();
    float3 min_bounds = apic_origin;
    float3 max_bounds = apic_origin + float3(_ApicGridRes.x, _ApicGridRes.y, _ApicGridRes.z) * _dxApic;

    // 地形（Terrain）との衝突判定と摩擦
    float2 swe_local_pos = p.position.xy - _WorldOffset;
    int swe_x = clamp((int)floor(swe_local_pos.x / _dxSwe), 0, (int)_SweGridRes.x - 1);

    int flipped_y = (int)_SweGridRes.y - 1 - clamp((int)floor(swe_local_pos.y / _dxSwe), 0, (int)_SweGridRes.y - 1);
    float b_c = TerrainHeightMap.Load(int3(swe_x, flipped_y, 0)).r;

    // パーティクルが地面より下に潜ったら、地面の上に押し上げて減速させる
    if (p.position.z < b_c) {
        p.position.z = b_c + 0.01f;
        p.velocity.z = max(0.0f, p.velocity.z * -0.3f); 
        p.velocity.x *= 0.5f; 
        p.velocity.y *= 0.5f;
    }

    float margin = 0.1f;
    if (any(p.position < min_bounds + margin) ||any( p.position > max_bounds - margin)) {
        p.mass = 0.0f;
    }

    _ApicParticle[index] = p;
}

// APICからSWE
[numthreads(64, 1, 1)]
void Condense (uint3 id : SV_DispatchThreadID) {
    uint count = _ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    uint index = _ActiveParticleList_R[id.x];
    uint p_len, p_stride;
    _ApicParticle.GetDimensions(p_len, p_stride);
    if (index >= p_len) return;

    APICParticle p = _ApicParticle[index];
    if (p.mass <= 0.0f) return;

    int grid_w = _SweGridRes.x;
    int grid_h = _SweGridRes.y;
    float2 swe_local_pos = p.position.xy - _WorldOffset;
    float2 swe_pos = swe_local_pos / _dxSwe;
    int2 center_idx = (int2)floor(swe_pos);
    int cx_center = clamp(center_idx.x, 0, grid_w - 1);
    int cy_center = clamp(center_idx.y, 0, grid_h - 1);

    p.age += _dtApic;

    uint flat_center = cy_center * grid_w + cx_center;

    int flipped_y = (int)_SweGridRes.y - 1 - cy_center;
    float b_c = TerrainHeightMap.Load(int3(cx_center, flipped_y, 0)).r;
    float2 cell_world_pos = _WorldOffset + float2(cx_center, cy_center) * _dxSwe;
    float fft_y = GetFFTSurfaceY(cell_world_pos);
    float current_surface_z = b_c + _SweState_R[flat_center].h + fft_y;

    // Z軸で判定; 着水時の勢い（velocity.z）が強い場合は吸収させず、波として残す
    if (p.position.z <= current_surface_z && p.age > 0.1f && p.velocity.z < 2.0f)
    {
        float total_weight = 0.0f;
        [unroll]
        for (int i = -1; i <= 1; i++) {
            [unroll]
            for (int j = -1; j <= 1; j++) {
                int2 cell_idx = center_idx + int2(i, j);
                float2 cell_center = (float2)cell_idx + 0.5f;
                float2 d_pos = swe_pos - cell_center;
                float dist_sq = dot(d_pos, d_pos);
                float weight = max(0.0f, 1.0f - dist_sq * 0.5f);
                total_weight += weight;
            }
        }

        if (total_weight > 0.0f)
        {
            float swe_cell_area = _dxSwe * _dxSwe;
            [unroll]
            for (int i = -1; i <= 1; i++) {
                [unroll]
                for (int j = -1; j <= 1; j++) {
                    int2 cell_idx = center_idx + int2(i, j);
                    float2 cell_center = (float2)cell_idx + 0.5f;
                    float2 d_pos = swe_pos - cell_center; 
                    float dist_sq = dot(d_pos, d_pos);
                    float weight = max(0.0f, 1.0f - dist_sq * 0.5f) / total_weight;

                    float2 radial_dir = cell_center - swe_pos;
                    float r_len = max(length(radial_dir), 0.001f);
                    radial_dir /= r_len; 

                    int safe_x = clamp(cell_idx.x, 0, grid_w - 1);
                    int safe_y = clamp(cell_idx.y, 0, grid_w - 1);
                    uint flat_idx = safe_y * grid_w + safe_x;

                    float delta_hu_mass = p.mass * p.velocity.x * weight * horizontal_momentum_transfer;
                    float delta_hv_mass = p.mass * p.velocity.y * weight * horizontal_momentum_transfer;
                    float impact_energy = vertical_momentum_to_wave * p.mass * abs(p.velocity.z) * weight;
                    float current_h = max(_SweState_R[flat_idx].h, 0.01f);

                    float depth_factor = saturate(current_h / 1.0f); 

                    float delta_hu_wave = impact_energy * radial_dir.x * depth_factor;
                    float delta_hv_wave = impact_energy * radial_dir.y * depth_factor;

                    float delta_h = (p.mass * weight) / swe_cell_area;
                    float delta_hu = (delta_hu_mass + delta_hu_wave) / swe_cell_area;
                    float delta_hv = (delta_hv_mass + delta_hv_wave) / swe_cell_area;

                    InterlockedAdd(_DeltaHInt[flat_idx],  (int)(delta_h * ATOMIC_SCALE));
                    InterlockedAdd(_DeltaHuInt[flat_idx], (int)(delta_hu * ATOMIC_SCALE));
                    InterlockedAdd(_DeltaHvInt[flat_idx], (int)(delta_hv * ATOMIC_SCALE));
                }
            }
        }
        p.mass = 0.0f;
    }
    _ApicParticle[index] = p;
}

[numthreads(64, 1, 1)]
void P2G (uint3 id : SV_DispatchThreadID) {
    uint count = _ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    uint index = _ActiveParticleList_R[id.x];
    APICParticle p = _ApicParticle[index];
    if (p.mass <= 0.0f) return;

    float3 apic_origin = GetAPICOrigin();
    float3 local_pos = p.position - apic_origin;
    float3 grid_pos = (local_pos / _dxApic) - 0.5f;
    int3 base_idx = (int3)floor(grid_pos + 0.5f);

    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            [unroll]
            for (int k = -1; k <= 1; k++) {
                int3 cell_idx = clamp(base_idx + int3(i, j, k), 0, _ApicGridRes.x - 1);

                float3 d_pos = grid_pos - (float3)cell_idx;
                float3 weight_vec = QuadraticBSpline(d_pos);
                float weight = weight_vec.x * weight_vec.y * weight_vec.z;

                if (weight > 0.0f) {
                    float mass_contrib = p.mass * weight;

                    // アフィン速度 v_affine = C * d_pos
                    float3 affine_v = float3(dot(p.c1, d_pos), dot(p.c2, d_pos), dot(p.c3, d_pos));
                    
                    // 転写される運動量 = 質量 * (速度 + アフィン速度)
                    float3 momentum_contrib = mass_contrib * (p.velocity + affine_v);
                    
                    uint flat_idx = FlattenIndex(cell_idx);
                    
                    int add_mass = (int)(mass_contrib * ATOMIC_SCALE);
                    int add_velX = (int)(momentum_contrib.x * ATOMIC_SCALE);
                    int add_velY = (int)(momentum_contrib.y * ATOMIC_SCALE);
                    int add_velZ = (int)(momentum_contrib.z * ATOMIC_SCALE);

                    InterlockedAdd(_ApicMassInt[flat_idx], add_mass);
                    InterlockedAdd(_ApicVelIntX[flat_idx], add_velX);
                    InterlockedAdd(_ApicVelIntY[flat_idx], add_velY);
                    InterlockedAdd(_ApicVelIntZ[flat_idx], add_velZ);
                }
            }
        }
    }
}

[numthreads(8, 8, 8)]
void NormalizeVel (uint3 id : SV_DispatchThreadID) {
    if (any(id >= (uint3)_ApicGridRes)) return;
    uint idx = FlattenIndex(id);
    
    float mass = (float)_ApicMassInt[idx] / ATOMIC_SCALE;
    
    if (mass > 0.0001f) {
        float vx = ((float)_ApicVelIntX[idx] / ATOMIC_SCALE) / mass;
        float vy = ((float)_ApicVelIntY[idx] / ATOMIC_SCALE) / mass;
        float vz = ((float)_ApicVelIntZ[idx] / ATOMIC_SCALE) / mass;
        
        _ApicVelIntX[idx] = asint(vx);
        _ApicVelIntY[idx] = asint(vy);
        _ApicVelIntZ[idx] = asint(vz);
    } else {
        _ApicVelIntX[idx] = 0; 
        _ApicVelIntY[idx] = 0; 
        _ApicVelIntZ[idx] = 0;
    }
}

[numthreads(8, 8, 8)]
void Divergence (uint3 id : SV_DispatchThreadID) {
    if (any(id >= (uint3)_ApicGridRes) || IsObstacle(id)) return;
    uint idx = FlattenIndex(id);

    float4 center_info = GetSWEBoundaryInfo(id);
    float theta_c = center_info.w;

    if (asfloat(_ApicMassInt[idx]) < 0.0001f || theta_c < 0.001f) {
        _ApicDivergence[idx] = 0.0f;
        return;
    }

    float vR = GetData(_ApicVelIntX, id + uint3(1, 0, 0), 0, 0.0f);
    float vL = GetData(_ApicVelIntX, id - uint3(1, 0, 0), 0, 0.0f);
    float vU = GetData(_ApicVelIntY, id + uint3(0, 1, 0), 1, 0.0f);
    float vD = GetData(_ApicVelIntY, id - uint3(0, 1, 0), 1, 0.0f);
    float vF = GetData(_ApicVelIntZ, id + uint3(0, 0, 1), 2, 0.0f);
    float vB = GetData(_ApicVelIntZ, id - uint3(0, 0, 1), 2, 0.0f);

    float div = (vR - vL + vU - vD + vF - vB) / (2.0f * _dxApic);
    
    // thetaはSWEの境界を考慮した係数
    _ApicDivergence[idx] = -(_dxApic * _dxApic / _dtApic) * div * theta_c;
}

[numthreads(64, 1, 1)]
void G2P (uint3 id : SV_DispatchThreadID) {
    uint count = _ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    uint index = _ActiveParticleList_R[id.x];
    APICParticle p = _ApicParticle[index];
    if (p.mass <= 0.0f) return;

    // APIC空間のオフセット
    float3 apic_origin = GetAPICOrigin();
    float3 local_pos = p.position - apic_origin;
    float3 grid_pos = (local_pos / _dxApic) - 0.5f;
    int3 base_idx = (int3)floor(grid_pos + 0.5f);

    float3 pic_velocity = 0.0f; float3 new_c1 = 0.0f; float3 new_c2 = 0.0f; float3 new_c3 = 0.0f;

    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            [unroll]
            for (int k = -1; k <= 1; k++) {
                int3 cell_idx = clamp(base_idx + int3(i, j, k), 0, _ApicGridRes.x - 1);

                uint flat_idx = FlattenIndex(cell_idx);

                float3 corrected_vel = 0.0f;
                float3 vel_star = float3(asfloat(_ApicVelIntX[flat_idx]), asfloat(_ApicVelIntY[flat_idx]), asfloat(_ApicVelIntZ[flat_idx]));

                // もしセル自体が障害物なら、そこから流体の圧力は受け取らない（速度0）
                if (IsObstacle(cell_idx)) {
                    corrected_vel = vel_star;
                } else {
                    float p_center_raw = _ApicPressure_W[flat_idx];

                    float pR = max(0.0f, GetData(_ApicPressure_W, cell_idx + uint3(1, 0, 0), 0, p_center_raw));
                    float pL = max(0.0f, GetData(_ApicPressure_W, cell_idx - uint3(1, 0, 0), 0, p_center_raw));
                    float pU = max(0.0f, GetData(_ApicPressure_W, cell_idx + uint3(0, 1, 0), 1, p_center_raw));
                    float pD = max(0.0f, GetData(_ApicPressure_W, cell_idx - uint3(0, 1, 0), 1, p_center_raw));
                    float pF = max(0.0f, GetData(_ApicPressure_W, cell_idx + uint3(0, 0, 1), 2, p_center_raw));
                    float pB = max(0.0f, GetData(_ApicPressure_W, cell_idx - uint3(0, 0, 1), 2, p_center_raw));
                    
                    float3 grad_p = float3(pR - pL, pU - pD, pF - pB) / (2.0f * _dxApic);
                    float3 vel_star = float3(asfloat(_ApicVelIntX[flat_idx]), asfloat(_ApicVelIntY[flat_idx]), asfloat(_ApicVelIntZ[flat_idx]));
                    
                    corrected_vel = vel_star - _dtApic * grad_p;
                }

                float3 d_pos = grid_pos - (float3)cell_idx;
                float3 weight_vec = QuadraticBSpline(d_pos);
                float weight = weight_vec.x * weight_vec.y * weight_vec.z;
                pic_velocity += corrected_vel * weight;

                new_c1 += weight * corrected_vel.x * d_pos;
                new_c2 += weight * corrected_vel.y * d_pos;
                new_c3 += weight * corrected_vel.z * d_pos;
            }
        }
    }

    float margin = 0.5f; 
    if (any(grid_pos < margin) || any(grid_pos > _ApicGridRes - 1.0f - margin)) {
        new_c1 = 0.0f; new_c2 = 0.0f; new_c3 = 0.0f;
    }

    p.velocity = pic_velocity;
    p.c1 = new_c1 * 4.0f; p.c2 = new_c2 * 4.0f; p.c3 = new_c3 * 4.0f;
    _ApicParticle[index] = p;
}

// ==========================================
// 共役CG関連
// ==========================================
[numthreads(8,8,8)]
void BuildDiag(uint3 id : SV_DispatchThreadID) {
    if (any(id >= (uint3)_ApicGridRes)) return;
    int flatIdx = FlattenIndex(id);

    if (_ApicMassInt[flatIdx] == 0 || IsObstacle(id)) { _PcgPrecon[flatIdx] = 0.0f; return; }

    float diag = 0;
    if (id.x > 0 && !IsObstacle(id - uint3(1, 0, 0))) diag += 1.0f;
    if (id.x < (uint)_ApicGridRes.x - 1 && !IsObstacle(id + uint3(1, 0, 0))) diag += 1.0f;
    if (id.y > 0 && !IsObstacle(id - uint3(0, 1, 0))) diag += 1.0f;
    if (id.y < (uint)_ApicGridRes.y - 1 && !IsObstacle(id + uint3(0, 1, 0))) diag += 1.0f;
    if (id.z > 0 && !IsObstacle(id - uint3(0, 0, 1))) diag += 1.0f;
    if (id.z < (uint)_ApicGridRes.z - 1 && !IsObstacle(id + uint3(0, 0, 1))) diag += 1.0f;

    _PcgPrecon[flatIdx] = (diag > 0) ? (1.0f / diag) : 0.0f;
}

[numthreads(8, 8, 8)]
void InitCG(uint3 id : SV_DispatchThreadID) {
    if (any(id >= (uint3)_ApicGridRes)) return;
    int flatIdx = FlattenIndex(id);

    if (_ApicMassInt[flatIdx] == 0 || IsObstacle(id)) { 
        _ApicPressure_W[flatIdx] = 0;
        _PcgR[flatIdx] = 0; _PcgP[flatIdx] = 0; _PcgQ[flatIdx] = 0;
        return; 
    }

    _ApicPressure_W[flatIdx] = 0; 
    float r = _ApicDivergence[flatIdx]; 
    _PcgR[flatIdx] = r; _PcgP[flatIdx] = r * _PcgPrecon[flatIdx]; 
    _PcgQ[flatIdx] = 0;
}

// Preconを掛ける内積
groupshared float shared_dot[512];
[numthreads(8, 8, 8)]
void DotProductPrecon(uint3 id : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex) {
    shared_dot[groupIndex] = 0.0f;
    GroupMemoryBarrierWithGroupSync();

    if (all(id < (uint3)_ApicGridRes)) {
        int flatIdx = FlattenIndex(id);
        
        // 質量があり、地形ではないセルのみ計算
        if (_ApicMassInt[flatIdx] > 0 && !IsObstacle(id)) {
            shared_dot[groupIndex] = _PcgR[flatIdx] * _PcgR[flatIdx] * _PcgPrecon[flatIdx];
        }
    }
    GroupMemoryBarrierWithGroupSync();

    for (uint s = 256; s > 0; s >>= 1) {
        if (groupIndex < s) {
            shared_dot[groupIndex] += shared_dot[groupIndex + s];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (groupIndex == 0) {
        AtomicAddFloat(_PcgDotResult, 0, shared_dot[0]);
    }
}

// 汎用内積
[numthreads(8, 8, 8)]
void DotProductGeneric(uint3 id : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex)  {
    shared_dot[groupIndex] = 0.0f;
    GroupMemoryBarrierWithGroupSync();

    if (all(id < (uint3)_ApicGridRes)) {
        int flatIdx = FlattenIndex(id);
        if (_ApicMassInt[flatIdx] > 0 && !IsObstacle(id)) {
            shared_dot[groupIndex] = _PcgP[flatIdx] * _PcgQ[flatIdx];
        }
    }
    GroupMemoryBarrierWithGroupSync();

    for (uint s = 256; s > 0; s >>= 1) {
        if (groupIndex < s) {
            shared_dot[groupIndex] += shared_dot[groupIndex + s];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (groupIndex == 0) {
        AtomicAddFloat(_PcgDotResult, 0, shared_dot[0]);
    }
}

[numthreads(1, 1, 1)]
void InitRTr(uint3 id : SV_DispatchThreadID) {
    _PcgScalars[0] = asfloat(_PcgDotResult[0]); 
    _PcgDotResult[0] = 0; 
}

[numthreads(8,8,8)]
void ApplyA(uint3 id : SV_DispatchThreadID) {
    if (any(id >= (uint3)_ApicGridRes)) return;
    int flatIdx = FlattenIndex(id);
   
    if (_ApicMassInt[flatIdx] == 0 || IsObstacle(id)) { _PcgQ[flatIdx] = 0; return; }

    float center = _PcgP[flatIdx];
    float result = 0.0f;
    
    result += (center - GetData(_PcgP, id + uint3(1, 0, 0), 0, 0.0f));
    result += (center - GetData(_PcgP, id - uint3(1, 0, 0), 0, 0.0f));
    result += (center - GetData(_PcgP, id + uint3(0, 1, 0), 1, 0.0f));
    result += (center - GetData(_PcgP, id - uint3(0, 1, 0), 1, 0.0f));
    result += (center - GetData(_PcgP, id + uint3(0, 0, 1), 2, 0.0f));
    result += (center - GetData(_PcgP, id - uint3(0, 0, 1), 2, 0.0f));
    
    _PcgQ[flatIdx] = result;
}

[numthreads(1, 1, 1)]
void CalculateAlpha(uint3 id : SV_DispatchThreadID) {
    float dAd = asfloat(_PcgDotResult[0]); 
    _PcgScalars[1] = dAd;
    _PcgScalars[2] = (dAd > 1e-15f) ? (_PcgScalars[0] / dAd) : 0.0f; 
    _PcgDotResult[0] = 0; 
}

[numthreads(8, 8, 8)]
void UpdatePR(uint3 id : SV_DispatchThreadID) {
    if (any(id >= (uint3)_ApicGridRes) || IsObstacle(id)) return;
    int flatIdx = FlattenIndex(id);
    if (_ApicMassInt[flatIdx] == 0) return;
    float alpha = _PcgScalars[2];
    _ApicPressure_W[flatIdx] += alpha * _PcgP[flatIdx];
    _PcgR[flatIdx] -= alpha * _PcgQ[flatIdx];
}

[numthreads(1, 1, 1)]
void CalculateBeta(uint3 id : SV_DispatchThreadID) {
    float rTrNew = asfloat(_PcgDotResult[0]);
    _PcgScalars[3] = rTrNew / (_PcgScalars[0] + 1e-10f); 
    _PcgScalars[4] = _PcgScalars[0]; 
    _PcgScalars[0] = rTrNew; 
    _PcgDotResult[0] = 0;
}

[numthreads(8, 8, 8)]
void UpdateD(uint3 id : SV_DispatchThreadID) {
    if (any(id >= (uint3)_ApicGridRes) || IsObstacle(id)) return;
    int flatIdx = FlattenIndex(id);
    if (_ApicMassInt[flatIdx] == 0) return;
    _PcgP[flatIdx] = _PcgR[flatIdx] * _PcgPrecon[flatIdx] + _PcgScalars[3] * _PcgP[flatIdx];
}