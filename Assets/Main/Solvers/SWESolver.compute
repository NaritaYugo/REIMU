#pragma kernel ClearIntermediates
#pragma kernel InitSwe
#pragma kernel UpdateSwe
#pragma kernel Sublimate
#pragma kernel ApplyCondensation
#pragma kernel InteractSwe
#pragma kernel ShiftSweGrid

#include "CSCommon.cginc"

StructuredBuffer<SWECell> SWE_State_Read;
RWStructuredBuffer<SWECell> SWE_State_Write;
RWStructuredBuffer<APICParticle> APIC_Particle_Buffer;
RWStructuredBuffer<uint> ParticleCounter;
RWStructuredBuffer<int> Delta_H_Buffer;
RWStructuredBuffer<int> Delta_HU_Buffer;
RWStructuredBuffer<int> Delta_HV_Buffer;

Texture2D<float4> FFT_DispLOD0;
Texture2D<float4> FFT_DispLOD1;
Texture2D<float4> FFT_DispLOD2;
float FFT_Size0, FFT_Size1, FFT_Size2;
Texture2D<float> TerrainHeightMap;

uint sweTileSize; 
uint2 tileCount;  
uint max_particles;
float fr_threshold;
float grad_threshold;
float laplacian_threshold;
float conversion_rate_multiplier;
float push_z_multiplier;
float splash_velocity_multiplier;
int2 shift_amount;

float2 mouse_pos;
float2 mouse_dir;
float mouse_radius;
float mouse_force;
int mouse_active;

SamplerState sampler_LinearRepeat {
    Filter = MIN_MAG_MIP_LINEAR;
    AddressU = Wrap;
    AddressV = Wrap;
};

// ==========================================
// ヘルパー関数
// ==========================================
inline float random(float2 uv) { return frac(sin(dot(uv, float2(12.9898f, 78.233f))) * 43758.5453f); }

// MinModリミッター
inline float  MinMod(float  a, float  b) {return 0.5f * (sign(a) + sign(b)) * min(abs(a), abs(b));}
inline float2 MinMod(float2 a, float2 b) {return 0.5f * (sign(a) + sign(b)) * min(abs(a), abs(b));}
inline float3 MinMod(float3 a, float3 b) {return 0.5f * (sign(a) + sign(b)) * min(abs(a), abs(b));}

float GetBedElevation(int ix, int iy) {
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y;
    ix = clamp(ix, 0, grid_w - 1);
    iy = clamp(iy, 0, grid_h - 1);
    
    return TerrainHeightMap.Load(int3(ix, iy, 0)).r;
}

float3 GetFFTState(float2 worldPos, float bed_elevation) {
    float2 uv0 = worldPos / FFT_Size0;
    float2 uv1 = worldPos / FFT_Size1;
    float2 uv2 = worldPos / FFT_Size2;

    float4 d0 = FFT_DispLOD0.SampleLevel(sampler_LinearRepeat, uv0, 0);
    float4 d1 = FFT_DispLOD1.SampleLevel(sampler_LinearRepeat, uv1, 0);
    float4 d2 = FFT_DispLOD2.SampleLevel(sampler_LinearRepeat, uv2, 0);

    float2 disp = float2(d0.x + d1.x + d2.x, d0.z + d1.z + d2.z);
    float2 samplePos = worldPos - disp;
    
    uv0 = samplePos / FFT_Size0;
    uv1 = samplePos / FFT_Size1;
    uv2 = samplePos / FFT_Size2;

    d0 = FFT_DispLOD0.SampleLevel(sampler_LinearRepeat, uv0, 0);
    d1 = FFT_DispLOD1.SampleLevel(sampler_LinearRepeat, uv1, 0);
    d2 = FFT_DispLOD2.SampleLevel(sampler_LinearRepeat, uv2, 0);

    float surface_y = d0.y + d1.y + d2.y;
    float h_fft = max(0.0f, surface_y - bed_elevation);
    return float3(h_fft, 0.0f, 0.0f);
}

float3 GetSWEState(int cx, int cy) {
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y;
    
    if (cx < 0 || cx >= grid_w || cy < 0 || cy >= grid_h) {
        // 境界のセルの状態をそのままコピーして波を逃がす
        int clamp_x = clamp(cx, 0, grid_w - 1);
        int clamp_y = clamp(cy, 0, grid_h - 1);
        SWECell edge_cell = SWE_State_Read[clamp_y * grid_w + clamp_x];
        return float3(edge_cell.h, edge_cell.hu, edge_cell.hv);
    }
    SWECell cell = SWE_State_Read[cy * grid_w + cx];
    return float3(cell.h, cell.hu, cell.hv);
}

inline float2 GetVelocity(float h, float hu, float hv) {
    if (h < H_MIN) return float2(0.0f, 0.0f);
    
    float h2 = h * h;
    float den = h2 + max(h2, 1e-6f);
    return float2((2.0f * h * hu) / den, (2.0f * h * hv) / den);
}

// フラックス
inline float3 ComputeFlux(float h, float u, float v) { 
    float q = h * u; 
    return float3(q, q * u + 0.5f * GRAVITY * h * h, q * v); 
}

// HLL近似リーマンソルバ
inline float3 HLL_Flux(float3 UL, float3 UR) {
    float2 vL = GetVelocity(UL.x, UL.y, UL.z);
    float2 vR = GetVelocity(UR.x, UR.y, UR.z);
    
    // 波の伝播速度 (Gravity Wave Speed) c = sqrt(g * h)
    float cL = sqrt(GRAVITY * max(0.0f, UL.x));
    float cR = sqrt(GRAVITY * max(0.0f, UR.x));
    float sL, sR;

    // Wet/Dry(水/陸) 状態に応じた波の速度の予測
    if (UL.x <= H_MIN && UR.x <= H_MIN) {
        sL = 0.0f; sR = 0.0f;
    } else if (UL.x <= H_MIN) { // 左が陸、右が水
        sL = vR.x - 2.0f * cR;
        sR = vR.x + cR;
    } else if (UR.x <= H_MIN) { // 左が水、右が陸
        sL = vL.x - cL;
        sR = vL.x + 2.0f * cL;
    } else { // 両方水
        sL = min(vL.x - cL, vR.x - cR);
        sR = max(vL.x + cL, vR.x + cR);
    }

    float3 FL = ComputeFlux(UL.x, vL.x, vL.y);
    float3 FR = ComputeFlux(UR.x, vR.x, vR.y);

    // HLLフラックスの評価式
    // 波が左に逃げるならFL、右ならFR、挟まれていれば中間状態を計算
    if (sL >= 0.0f) return FL;
    else if (sR <= 0.0f) return FR;
    else if (sR > sL) return (sR * FL - sL * FR + sL * sR * (UR - UL)) / (sR - sL);
    else return float3(0.0f, 0.0f, 0.0f);
}

// 1次元軸方向のフラックスとソースタームを計算する汎用関数
inline void ComputeAxisFlux(
    float3 U_M2, float3 U_M1, float3 U_0, float3 U_P1, float3 U_P2, 
    float B_M1, float B_0, float B_P1,
    out float3 flux_pos, out float3 flux_neg, out float source_term
) {
    float2 V_M2 = GetVelocity(U_M2.x, U_M2.y, U_M2.z);
    float2 V_M1 = GetVelocity(U_M1.x, U_M1.y, U_M1.z);
    float2 V_0  = GetVelocity(U_0.x,  U_0.y,  U_0.z);
    float2 V_P1 = GetVelocity(U_P1.x, U_P1.y, U_P1.z);
    float2 V_P2 = GetVelocity(U_P2.x, U_P2.y, U_P2.z);

    // 勾配計算 (MinMod)
    float slopeH_M1 = MinMod(U_M1.x - U_M2.x, U_0.x  - U_M1.x);
    float slopeH_0  = MinMod(U_0.x  - U_M1.x, U_P1.x - U_0.x);
    float slopeH_P1 = MinMod(U_P1.x - U_0.x,  U_P2.x - U_P1.x);

    float2 slopeV_M1 = MinMod(V_M1 - V_M2, V_0  - V_M1);
    float2 slopeV_0  = MinMod(V_0  - V_M1, V_P1 - V_0);
    float2 slopeV_P1 = MinMod(V_P1 - V_0,  V_P2 - V_P1);

    // 水深が浅い場合の勾配制限
    if (U_0.x < 0.01f) {
        slopeH_0 = 0.0f;
        slopeV_0 = float2(0.0f, 0.0f);
    } else if (U_M1.x < 0.01f || U_P1.x < 0.01f) {
        slopeV_0 = float2(0.0f, 0.0f);
    }

    // セル境界の Eta
    float Eta_pos_L = U_0.x  + 0.5f * slopeH_0  + B_0;
    float Eta_pos_R = U_P1.x - 0.5f * slopeH_P1 + B_P1;
    float Eta_neg_L = U_M1.x + 0.5f * slopeH_M1 + B_M1;
    float Eta_neg_R = U_0.x  - 0.5f * slopeH_0  + B_0;

    // 地形高の最大値 (静水圧再構築)
    float B_pos = max(B_0, B_P1);
    float B_neg = max(B_M1, B_0);

    // 再構築された水深 h と流速 V
    float h_pos_L = max(0.0f, Eta_pos_L - B_pos);
    float h_pos_R = max(0.0f, Eta_pos_R - B_pos);
    float h_neg_L = max(0.0f, Eta_neg_L - B_neg);
    float h_neg_R = max(0.0f, Eta_neg_R - B_neg);

    float2 V_pos_L = V_0  + 0.5f * slopeV_0;
    float2 V_pos_R = V_P1 - 0.5f * slopeV_P1;
    float2 V_neg_L = V_M1 + 0.5f * slopeV_M1;
    float2 V_neg_R = V_0  - 0.5f * slopeV_0;

    // フラックス計算 (HLL_Fluxのみを使用)
    flux_pos = HLL_Flux(float3(h_pos_L, h_pos_L * V_pos_L), float3(h_pos_R, h_pos_R * V_pos_R));
    flux_neg = HLL_Flux(float3(h_neg_L, h_neg_L * V_neg_L), float3(h_neg_R, h_neg_R * V_neg_R));

    // 地形の壁判定 (フラックス遮断)
    float Eta_M1 = U_M1.x + B_M1;
    float Eta_0  = U_0.x  + B_0;
    float Eta_P1 = U_P1.x + B_P1;

    if (flux_pos.x > 0.0f && Eta_0 <= B_P1) flux_pos = float3(0.0f, 0.0f, 0.0f);
    if (flux_pos.x < 0.0f && Eta_P1 <= B_0) flux_pos = float3(0.0f, 0.0f, 0.0f);
    if (flux_neg.x > 0.0f && Eta_M1 <= B_0) flux_neg = float3(0.0f, 0.0f, 0.0f);
    if (flux_neg.x < 0.0f && Eta_0 <= B_M1) flux_neg = float3(0.0f, 0.0f, 0.0f);

    // 重力ソースターム
    float h_0_pos = max(0.0f, Eta_pos_L - B_0);
    float h_0_neg = max(0.0f, Eta_neg_R - B_0);
    
    source_term = 0.5f * GRAVITY * (h_pos_L * h_pos_L - h_neg_R * h_neg_R)
                - 0.5f * GRAVITY * (h_0_pos * h_0_pos - h_0_neg * h_0_neg);
}

// ==========================================
// カーネル
// ==========================================
[numthreads(8, 8, 1)]
void InitSwe(uint3 id : SV_DispatchThreadID) {
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y;
    if (id.x >= (uint)grid_w || id.y >= (uint)grid_h) return;

    uint index = id.y * grid_w + id.x;

    float B_C = GetBedElevation(id.x, id.y);
    float rest_water_level = 0.0f; 
    
    float initial_h = max(rest_water_level - B_C, 0.0f); 

    SWECell cell;
    cell.h = initial_h;
    cell.hu = 0.0f;
    cell.hv = 0.0f;
    cell.foam = 0.0f;
    SWE_State_Write[index] = cell;
}

[numthreads(8, 8, 1)]
void UpdateSwe (uint3 id : SV_DispatchThreadID) {
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y; 
    int ix = (int)id.x;
    int iy = (int)id.y;
    if (ix >= grid_w || iy >= grid_h) return;

    uint index = iy * grid_w + ix;
    SWECell current = SWE_State_Read[index];
    float3 U_C = float3(current.h, current.hu, current.hv);
    float B_C = GetBedElevation(ix, iy);

    // 1段隣のセル状態を取得
    float3 U_L = GetSWEState(ix - 1, iy);
    float3 U_R = GetSWEState(ix + 1, iy);
    float3 U_B = GetSWEState(ix, iy - 1);
    float3 U_T = GetSWEState(ix, iy + 1);

    float B_L = GetBedElevation(ix - 1, iy);
    float B_R = GetBedElevation(ix + 1, iy);
    float B_B = GetBedElevation(ix, iy - 1);
    float B_T = GetBedElevation(ix, iy + 1);

    // X方向
    float3 fluxX_right, fluxX_left;
    float source_X;
    ComputeAxisFlux(
        GetSWEState(ix - 2, iy), U_L, U_C, U_R, GetSWEState(ix + 2, iy),
        B_L, B_C, B_R, fluxX_right, fluxX_left, source_X
    );

    // Y方向(スウィズル)
    float3 fluxY_up, fluxY_down;
    float source_Y;
    ComputeAxisFlux(
        GetSWEState(ix, iy - 2).xzy, U_B.xzy, U_C.xzy, U_T.xzy, GetSWEState(ix, iy + 2).xzy,
        B_B, B_C, B_T, fluxY_up, fluxY_down, source_Y
    );
    fluxY_up = fluxY_up.xzy;
    fluxY_down = fluxY_down.xzy;

    // 状態の更新 (保存則)
    float dtdx = _dtSwe / _dxSwe;
    current.h  += -dtdx * (fluxX_right.x - fluxX_left.x) - dtdx * (fluxY_up.x - fluxY_down.x);
    current.hu += -dtdx * (fluxX_right.y - fluxX_left.y) - dtdx * (fluxY_up.y - fluxY_down.y) + dtdx * source_X;
    current.hv += -dtdx * (fluxX_right.z - fluxX_left.z) - dtdx * (fluxY_up.z - fluxY_down.z) + dtdx * source_Y;

    // Wet / Dry 境界処理 (摩擦と減衰)
    float new_h  = current.h;
    float new_hu = current.hu;
    float new_hv = current.hv;

    float n_manning = 0.01f;
    float2 vel = GetVelocity(new_h, new_hu, new_hv);
    float speed = length(vel);
    
    float safe_h = max(new_h, 0.05f);
    float friction = (GRAVITY * n_manning * n_manning * speed) / pow(safe_h, 0.3333f);
    float damp = 1.0f / (1.0f + _dtSwe * max(0.0f, friction));
    new_hu *= damp;
    new_hv *= damp;

    float c = sqrt(GRAVITY * max(new_h, 0.001f));
    float max_safe_speed = max(0.0f, (0.2f * _dxSwe / _dtSwe) - c);
    if (speed > max_safe_speed) {
        float excess_speed = speed - max_safe_speed;
        float drag = max(0.0f, 1.0f - _dtSwe * excess_speed * excess_speed * 0.1f);
        new_hu *= drag; 
        new_hv *= drag;
    }

    float sponge_width = 12.0f; 
    float dist_x = min((float)ix, (float)(grid_w - 1 - ix));
    float dist_y = min((float)iy, (float)(grid_h - 1 - iy));
    float alpha = smoothstep(0.0f, 1.0f, min(dist_x, dist_y) / sponge_width);

    if (alpha < 1.0f) {
        float rest_h = max(0.0f - B_C, 0.0f);
        new_h += (rest_h - new_h) * (1.0f - alpha) * _dtSwe * 2.0f;
        new_hu *= (0.95f + 0.05f * alpha);
        new_hv *= (0.95f + 0.05f * alpha);
    }

    if (new_h < 0.005f) {
        new_hu = 0.0f;
        new_hv = 0.0f;
    }

    // 泡の生成と移流
    float safe_dx_foam = max(_dxSwe, 0.001f);
    float Eta_L = U_L.x + B_L;
    float Eta_R = U_R.x + B_R;
    float Eta_B = U_B.x + B_B;
    float Eta_T = U_T.x + B_T;
    float Eta_C = U_C.x + B_C;
    
    float laplacian_Eta_foam = (Eta_L + Eta_R + Eta_T + Eta_B - 4.0f * Eta_C) / (safe_dx_foam * safe_dx_foam);
    float foam_gen_mask = smoothstep(0.01f, 0.05f, new_h);

    float crest_foam = (laplacian_Eta_foam < -1.5f) ? (-laplacian_Eta_foam * _dtSwe * 0.5f) : 0.0f;
    float shore_foam = (new_h > 0.02f && new_h < 0.3f && speed > 0.8f) ? (speed * _dtSwe * 1.5f) : 0.0f;
    crest_foam *= pow(alpha, 4.0f) * foam_gen_mask; 
    shore_foam *= alpha * foam_gen_mask;

    float2 back_pos = float2(ix, iy) - vel * (_dtSwe / _dxSwe);
    int bx = clamp(round(back_pos.x), 0, grid_w - 1);
    int by = clamp(round(back_pos.y), 0, grid_h - 1);
    float advected_foam = SWE_State_Read[by * grid_w + bx].foam;

    float new_foam = advected_foam + crest_foam + shore_foam;
    float foam_decay = exp(-(0.5f + smoothstep(0.05f, 0.0f, new_h) * 20.0f) * _dtSwe); 
    new_foam *= foam_decay;

    if (new_h < 0.01f) {
        new_foam = max(0.0f, new_foam - _dtSwe * 5.0f);
    }

    // 結果の書き込み
    SWECell nextState;
    nextState.h  = max(new_h, 0.0f);
    nextState.hu = (nextState.h > H_MIN) ? new_hu : 0.0f;
    nextState.hv = (nextState.h > H_MIN) ? new_hv : 0.0f;
    nextState.foam = min(new_foam, 5.0f);
    SWE_State_Write[index] = nextState;
}

// SWEからAPIC
[numthreads(8, 8, 1)]
void Sublimate (uint3 id : SV_DispatchThreadID) {
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y;
    int ix = (int)id.x;
    int iy = (int)id.y;
    if (ix >= grid_w || iy >= (int)_SweGridRes.y) return;

    uint index = iy * grid_w + ix;
    SWECell current = SWE_State_Read[index];

    int margin = 14; 
    if (ix < margin || ix >= grid_w - margin || iy < margin || iy >= grid_h - margin) {
        SWE_State_Write[index] = current; return;
    }

    float h_min = _dxSwe * 0.5f;
    if (current.h <= h_min + 0.1f) {
        SWE_State_Write[index] = current; return;
    }

    float speed_sq = current.hu * current.hu + current.hv * current.hv;
    float h_sq = current.h * current.h;
    
    // フルード数で簡易判定して早期リターン
    float fr_sq_threshold = fr_threshold * fr_threshold;
    if (speed_sq < fr_sq_threshold * GRAVITY * current.h) { 
        SWE_State_Write[index] = current; 
        return; 
    }

    float smooth_h = 0.0f; float smooth_hu = 0.0f; float smooth_hv = 0.0f; float weight_sum = 0.0f;
    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            int nx = clamp(ix + i, 0, grid_w - 1);
            int ny = clamp(iy + j, 0, grid_w - 1);
            SWECell n_swe = SWE_State_Read[ny * grid_w + nx];
            float w = (i == 0 && j == 0) ? 0.25f : ((abs(i) + abs(j) == 1) ? 0.125f : 0.0625f);
            smooth_h += n_swe.h * w; smooth_hu += n_swe.hu * w; smooth_hv += n_swe.hv * w; weight_sum += w;
        }
    }
    smooth_h /= weight_sum; smooth_hu /= weight_sum; smooth_hv /= weight_sum;

    float safe_dx = max(_dxSwe, 0.001f);
    float safe_h = max(smooth_h, 0.001f);

    SWECell cL = SWE_State_Read[iy * grid_w + max(ix - 1, 0)];
    SWECell cR = SWE_State_Read[iy * grid_w + min(ix + 1, grid_w - 1)];
    SWECell cD = SWE_State_Read[max(iy - 1, 0) * grid_w + ix];
    SWECell cU = SWE_State_Read[min(iy + 1, grid_w - 1) * grid_w + ix];

    float u_c = smooth_hu / safe_h;
    float v_c = smooth_hv / safe_h;

    float B_L = GetBedElevation(max(ix - 1, 0), iy);
    float B_R = GetBedElevation(min(ix + 1, grid_w - 1), iy);
    float B_D = GetBedElevation(ix, max(iy - 1, 0));
    float B_U = GetBedElevation(ix, min(iy + 1, grid_h - 1));
    float B_C = GetBedElevation(ix, iy);

    float Eta_L = cL.h + B_L;
    float Eta_R = cR.h + B_R;
    float Eta_D = cD.h + B_D;
    float Eta_U = cU.h + B_U;
    float Eta_C = current.h + B_C;

    float dEta_dx = (Eta_R - Eta_L) / (2.0f * safe_dx);
    float dEta_dy = (Eta_U - Eta_D) / (2.0f * safe_dx);
    float grad_mag = sqrt(max(0.0f, dEta_dx * dEta_dx + dEta_dy * dEta_dy));
    
    float laplacian_Eta = (Eta_L + Eta_R + Eta_D + Eta_U - 4.0f * Eta_C) / (safe_dx * safe_dx);
    
    float speed = sqrt(max(0.0f, u_c * u_c + v_c * v_c));
    float fr = speed / sqrt(GRAVITY * safe_h);

    // 昇華(砕波)の判定条件
    // 1. 水面の勾配が閾値以上
    // 2. 波の尖り具合(ラプラシアン)がマイナスの閾値以下
    // 3. フルード数が閾値以上
    bool is_breaking = false;
    if (grad_mag > grad_threshold) is_breaking = true;          
    if (laplacian_Eta < laplacian_threshold) is_breaking = true; // laplacian_h から変更
    if (fr > fr_threshold) is_breaking = true;

    if (is_breaking)
    {
        float conversion_rate = 1.0f - exp(-conversion_rate_multiplier * _dtSwe); 
        float delta_h = (current.h - h_min) * conversion_rate;
        if (delta_h < 0.05f) { SWE_State_Write[index] = current; return; }

        float sublimated_mass = delta_h * safe_dx * safe_dx; 
        uint count = (uint)max(1.0f, sublimated_mass);
        count = min(count, 50);

        float mass_per_particle = sublimated_mass / max(1.0f, (float)count);

        uint p_len, p_stride;
        APIC_Particle_Buffer.GetDimensions(p_len, p_stride);
        if (p_len == 0) p_len = 1000000;
        
        uint start_idx;
        InterlockedAdd(ParticleCounter[0], count, start_idx);
        uint spawned_count = 0;

        // 質量保存を満たすように生成すべき粒子数を逆算
        for (uint i = 0; i < count; i++)
        {
            uint p_idx = (start_idx + i) % p_len;
            if (APIC_Particle_Buffer[p_idx].mass > 0.001f) continue; 

            APICParticle p = (APICParticle)0;
            p.mass = mass_per_particle;
            p.age = 0.0f;

            float rx = frac(sin((ix + i) * 12.9898f + iy * 78.233f) * 43758.5453f);
            float ry = frac(sin(ix * 93.989f  + (iy + i) * 67.345f) * 43758.5453f);
            float rz = frac(sin((ix * iy) * 45.123f + i * 13.567f) * 43758.5453f);

            p.position.x = _SweWorldOffset.x + ((float)ix + rx) * _dxSwe;
            p.position.y = _SweWorldOffset.y + ((float)iy + ry) * _dxSwe;
            float B_C = GetBedElevation(ix, iy);
            float spawn_base_z = B_C + current.h - delta_h; 
            p.position.z = spawn_base_z + rz * delta_h;

            float2 flow_dir = float2(u_c, v_c);
            float flow_speed = length(flow_dir);
            if (flow_speed > 0.001f) flow_dir /= flow_speed;
            else flow_dir = float2(0.0f, 0.0f);

            // 連続の式を利用して鉛直速度を計算
            float c_wave = sqrt(9.81f * safe_h);
            float curl_boost = c_wave * 0.8f; 
            float push_z = clamp(max(0.0f, -laplacian_Eta) * push_z_multiplier, 0.0f, c_wave);

            p.velocity.x = u_c + flow_dir.x * curl_boost + (rx - 0.5f) * 2.0f * _dxSwe; 
            p.velocity.y = v_c + flow_dir.y * curl_boost + (ry - 0.5f) * 2.0f * _dxSwe;
            p.velocity.z = push_z + (rz * splash_velocity_multiplier) * c_wave; 
            p.c1 = float3(0,0,0); p.c2 = float3(0,0,0); p.c3 = float3(0,0,0);

            APIC_Particle_Buffer[p_idx] = p;
            spawned_count++;
        }

        float actual_sublimated_mass = mass_per_particle * (float)spawned_count;
        float actual_delta_h = actual_sublimated_mass / (safe_dx * safe_dx);
        current.h -= actual_delta_h;
        float remain_ratio = (current.h > 0.001f) ? (current.h / (current.h + actual_delta_h)) : 0.0f;
        current.hu *= remain_ratio;
        current.hv *= remain_ratio;
    }
    SWE_State_Write[index] = current;
}

[numthreads(8, 8, 1)]
void ApplyCondensation (uint3 id : SV_DispatchThreadID) {
    if (any(id.xy >= (uint2)_SweGridRes)) return;
    uint index = id.y * _SweGridRes.x + id.x;

    SWECell current = SWE_State_Read[index];
    
    // 整数倍してアトミック加算していたので、ATOMIC_SCALEで割って戻す
    float delta_h = (float)Delta_H_Buffer[index] / ATOMIC_SCALE;
    current.h  += delta_h;
    current.hu += (float)Delta_HU_Buffer[index] / ATOMIC_SCALE;
    current.hv += (float)Delta_HV_Buffer[index] / ATOMIC_SCALE;

    SWE_State_Write[index] = current;
}

[numthreads(8, 8, 1)]
void InteractSwe (uint3 id : SV_DispatchThreadID) {
    if (any(id.xy >= (uint2)_SweGridRes)) return;

    uint index = id.y * _SweGridRes.x + id.x;
    SWECell current = SWE_State_Read[index];

    if (mouse_active == 1)
    {
        float2 cell_world_pos = _SweWorldOffset + float2(id.x, id.y) * _dxSwe;
        if (distance(cell_world_pos, mouse_pos) < mouse_radius)
        {
            if (current.h > 0.01f) {
                current.hu += mouse_dir.x * mouse_force * _dtApic * current.h;
                current.hv += mouse_dir.y * mouse_force * _dtApic * current.h;
            }
        }
    }

    SWE_State_Write[index] = current;
}

[numthreads(8, 8, 1)]
void ShiftSweGrid(uint3 id : SV_DispatchThreadID) {
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y;
    int ix = (int)id.x;
    int iy = (int)id.y;
    if (ix >= grid_w || iy >= grid_h) return;

    int src_x = ix + shift_amount.x;
    int src_y = iy + shift_amount.y;
    uint dst_index = iy * grid_w + ix;
    SWECell nextState;

    if (src_x >= 0 && src_x < grid_w && src_y >= 0 && src_y < grid_h) {
    nextState = SWE_State_Read[src_y * grid_w + src_x];
    } else {
        float new_B = GetBedElevation(ix, iy);
        float2 cellWorldPos = _SweWorldOffset + float2(ix, iy) * _dxSwe;
        float3 fft = GetFFTState(cellWorldPos, new_B);
        
        // 陸地に入った場合は H_MIN ではなく 0.0f にする
        nextState.h = max(fft.x, 0.0f); 
        nextState.hu = 0.0f;
        nextState.hv = 0.0f;
        nextState.foam = 0.0f;
    }
    SWE_State_Write[dst_index] = nextState;
}

[numthreads(8, 8, 1)]
void ClearIntermediates (uint3 id : SV_DispatchThreadID) {
    if (any(id.xy >= (uint2)_SweGridRes)) return;
    
    uint index = id.y * _SweGridRes.x + id.x;
    
    // 中間バッファを 0 で初期化
    Delta_H_Buffer[index] = 0;
    Delta_HU_Buffer[index] = 0;
    Delta_HV_Buffer[index] = 0;
}