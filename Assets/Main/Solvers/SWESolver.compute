#pragma kernel ClearIntermediateBuffers
#pragma kernel InitSWE
#pragma kernel UpdateSWE
#pragma kernel SublimateSWEtoAPIC
#pragma kernel ApplyCondensation
#pragma kernel InteractSWE
#pragma kernel ShiftSWEGrid

#include "CSCommon.cginc"

StructuredBuffer<SWECell> SWE_State_Read;
RWStructuredBuffer<SWECell> SWE_State_Write;
RWStructuredBuffer<APICParticle> APIC_Particle_Buffer;
RWStructuredBuffer<uint> ParticleCounter;
RWStructuredBuffer<int> Delta_H_Buffer;
RWStructuredBuffer<int> Delta_HU_Buffer;
RWStructuredBuffer<int> Delta_HV_Buffer;

Texture2D<float4> FFT_DispLOD0;
Texture2D<float4> FFT_DispLOD1;
Texture2D<float4> FFT_DispLOD2;
float FFT_Size0, FFT_Size1, FFT_Size2;
Texture2D<float> TerrainHeightMap;

uint sweTileSize; 
uint2 tileCount;  
uint max_particles;
float fr_threshold;
float grad_threshold;
float laplacian_threshold;
float conversion_rate_multiplier;
float push_z_multiplier;
float splash_velocity_multiplier;
int2 shift_amount;

float2 mouse_pos;
float2 mouse_dir;
float mouse_radius;
float mouse_force;
int mouse_active;

SamplerState sampler_LinearRepeat
{
    Filter = MIN_MAG_MIP_LINEAR;
    AddressU = Wrap;
    AddressV = Wrap;
};

// ==========================================
// ヘルパー関数群
// ==========================================

float GetBedElevation(int ix, int iy)
{
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y;
    ix = clamp(ix, 0, grid_w - 1);
    iy = clamp(iy, 0, grid_h - 1);
    
    return TerrainHeightMap.Load(int3(ix, iy, 0)).r;
}

float3 GetFFTState(float2 worldPos, float bed_elevation)
{
    float2 uv0 = worldPos / FFT_Size0;
    float2 uv1 = worldPos / FFT_Size1;
    float2 uv2 = worldPos / FFT_Size2;

    float4 d0 = FFT_DispLOD0.SampleLevel(sampler_LinearRepeat, uv0, 0);
    float4 d1 = FFT_DispLOD1.SampleLevel(sampler_LinearRepeat, uv1, 0);
    float4 d2 = FFT_DispLOD2.SampleLevel(sampler_LinearRepeat, uv2, 0);

    float2 disp = float2(d0.x + d1.x + d2.x, d0.z + d1.z + d2.z);
    float2 samplePos = worldPos - disp;
    
    uv0 = samplePos / FFT_Size0;
    uv1 = samplePos / FFT_Size1;
    uv2 = samplePos / FFT_Size2;

    d0 = FFT_DispLOD0.SampleLevel(sampler_LinearRepeat, uv0, 0);
    d1 = FFT_DispLOD1.SampleLevel(sampler_LinearRepeat, uv1, 0);
    d2 = FFT_DispLOD2.SampleLevel(sampler_LinearRepeat, uv2, 0);

    float surface_y = d0.y + d1.y + d2.y;
    float h_fft = max(0.0f, surface_y - bed_elevation);
    return float3(h_fft, 0.0f, 0.0f);
}

float3 GetSWEState(int cx, int cy)
{
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y;
    
    if (cx < 0 || cx >= grid_w || cy < 0 || cy >= grid_h) 
    {
        // 境界のセルの状態をそのままコピーして波を逃がす
        int clamp_x = clamp(cx, 0, grid_w - 1);
        int clamp_y = clamp(cy, 0, grid_h - 1);
        SWECell edge_cell = SWE_State_Read[clamp_y * grid_w + clamp_x];
        return float3(edge_cell.h, edge_cell.hu, edge_cell.hv);
    }
    SWECell cell = SWE_State_Read[cy * grid_w + cx];
    return float3(cell.h, cell.hu, cell.hv);
}

inline float random(float2 uv) { return frac(sin(dot(uv, float2(12.9898f, 78.233f))) * 43758.5453f); }

// MinModリミッター
inline float MinMod(float a, float b) {
    float sign_a = sign(a);
    float sign_b = sign(b);
    float min_abs = min(abs(a), abs(b));
    return 0.5f * (sign_a + sign_b) * min_abs;
}

inline float2 MinMod(float2 a, float2 b) {
    float2 sign_a = sign(a);
    float2 sign_b = sign(b);
    float2 min_abs = min(abs(a), abs(b));
    return 0.5f * (sign_a + sign_b) * min_abs;
}

inline float3 MinMod(float3 a, float3 b) {
    float3 sign_a = sign(a);
    float3 sign_b = sign(b);
    float3 min_abs = min(abs(a), abs(b));
    return 0.5f * (sign_a + sign_b) * min_abs;
}

inline float2 GetVelocity(float h, float hu, float hv) {
    if (h < H_MIN) return float2(0.0f, 0.0f);
    
    float h2 = h * h;
    float den = h2 + max(h2, 1e-6f);
    return float2((2.0f * h * hu) / den, (2.0f * h * hv) / den);
}

// フラックス
inline float3 ComputeFluxX(float h, float u, float v) { 
    float q = h * u; 
    return float3(q, q * u + 0.5f * G * h * h, q * v); 
}

inline float3 ComputeFluxY(float h, float u, float v) { 
    float q = h * v; 
    return float3(q, q * u, q * v + 0.5f * G * h * h); 
}

// HLL近似リーマンソルバ
inline float3 HLL_FluxX(float3 UL, float3 UR)
{
    float2 vL = GetVelocity(UL.x, UL.y, UL.z);
    float2 vR = GetVelocity(UR.x, UR.y, UR.z);
    
    // 波の伝播速度 (Gravity Wave Speed) c = sqrt(g * h)
    float cL = sqrt(G * max(0.0f, UL.x));
    float cR = sqrt(G * max(0.0f, UR.x));
    float sL, sR;

    // Wet/Dry(水/陸) 状態に応じた波の速度の予測
    if (UL.x <= H_MIN && UR.x <= H_MIN) {
        sL = 0.0f; sR = 0.0f;
    } else if (UL.x <= H_MIN) { // 左が陸、右が水
        sL = vR.x - 2.0f * cR;
        sR = vR.x + cR;
    } else if (UR.x <= H_MIN) { // 左が水、右が陸
        sL = vL.x - cL;
        sR = vL.x + 2.0f * cL;
    } else { // 両方水
        sL = min(vL.x - cL, vR.x - cR);
        sR = max(vL.x + cL, vR.x + cR);
    }

    float3 FL = ComputeFluxX(UL.x, vL.x, vL.y);
    float3 FR = ComputeFluxX(UR.x, vR.x, vR.y);

    // HLLフラックスの評価式
    // 波が左に逃げるならFL、右ならFR、挟まれていれば中間状態を計算
    if (sL >= 0.0f) return FL;
    else if (sR <= 0.0f) return FR;
    else if (sR > sL) return (sR * FL - sL * FR + sL * sR * (UR - UL)) / (sR - sL);
    else return float3(0.0f, 0.0f, 0.0f);
}

inline float3 HLL_FluxY(float3 UB, float3 UT)
{
    float2 vB = GetVelocity(UB.x, UB.y, UB.z);
    float2 vT = GetVelocity(UT.x, UT.y, UT.z);
    float cB = sqrt(G * max(0.0f, UB.x));
    float cT = sqrt(G * max(0.0f, UT.x));
    float sL, sR;

    if (UB.x <= H_MIN && UT.x <= H_MIN) {
        sL = 0.0f; sR = 0.0f;
    } else if (UB.x <= H_MIN) {
        sL = vT.y - 2.0f * cT;
        sR = vT.y + cT;
    } else if (UT.x <= H_MIN) {
        sL = vB.y - cB;
        sR = vB.y + 2.0f * cB;
    } else {
        sL = min(vB.y - cB, vT.y - cT);
        sR = max(vB.y + cB, vT.y + cT);
    }

    float3 FB = ComputeFluxY(UB.x, vB.x, vB.y);
    float3 FT = ComputeFluxY(UT.x, vT.x, vT.y);

    if (sL >= 0.0f) return FB;
    else if (sR <= 0.0f) return FT;
    else if (sR > sL) return (sR * FB - sL * FT + sL * sR * (UT - UB)) / (sR - sL);
    else return float3(0.0f, 0.0f, 0.0f);
}

[numthreads(8, 8, 1)]
void InitSWE(uint3 id : SV_DispatchThreadID)
{
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y;
    if (id.x >= (uint)grid_w || id.y >= (uint)grid_h) return;

    uint index = id.y * grid_w + id.x;

    float B_C = GetBedElevation(id.x, id.y);
    float rest_water_level = 0.0f; 
    
    float initial_h = max(rest_water_level - B_C, 0.0f); 

    SWECell cell;
    cell.h = initial_h;
    cell.hu = 0.0f;
    cell.hv = 0.0f;
    cell.foam = 0.0f;
    SWE_State_Write[index] = cell;
}

// ==========================================
// メイン演算カーネル (UpdateSWE)
// ==========================================
[numthreads(8, 8, 1)]
void UpdateSWE (uint3 id : SV_DispatchThreadID)
{
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y; 
    int ix = (int)id.x;
    int iy = (int)id.y;
    if (ix >= grid_w || iy >= grid_h) return;

    uint index = iy * grid_w + ix;
    float2 cell_world_pos = swe_world_offset + float2(ix, iy) * _dxSwe;
    SWECell current = SWE_State_Read[index];
    float B_C = GetBedElevation(ix, iy); // 中心セルの地形高を1回だけ取る

    // 各セルのワールド座標と地形高を渡し、極力テクスチャフェッチをさせない
    float3 U_LL = GetSWEState(ix - 2, iy);
    float3 U_L  = GetSWEState(ix - 1, iy);
    float3 U_C  = float3(current.h, current.hu, current.hv);
    float3 U_R  = GetSWEState(ix + 1, iy);
    float3 U_RR = GetSWEState(ix + 2, iy);

    float3 U_BB = GetSWEState(ix, iy - 2);
    float3 U_B  = GetSWEState(ix, iy - 1);
    float3 U_T  = GetSWEState(ix, iy + 1);
    float3 U_TT = GetSWEState(ix, iy + 2);

    // ==========================================================
    // 1. 各セルの絶対水面高 (Eta) を計算
    // 水深(h)ではなく、海抜に相当する絶対水面高(Eta = h + B)で勾配を計算する
    // これにより静水状態で波が発生しないようにする。
    // ==========================================================
    float B_L = GetBedElevation(ix - 1, iy);
    float B_R = GetBedElevation(ix + 1, iy);
    float B_B = GetBedElevation(ix, iy - 1);
    float B_T = GetBedElevation(ix, iy + 1);

    float Eta_C = U_C.x + B_C;

    // X方向の Eta
    float Eta_LL = U_LL.x + GetBedElevation(ix - 2, iy);
    float Eta_L  = U_L.x  + B_L;
    float Eta_R  = U_R.x  + B_R;
    float Eta_RR = U_RR.x + GetBedElevation(ix + 2, iy);

    // Y方向の Eta
    float Eta_BB = U_BB.x + GetBedElevation(ix, iy - 2);
    float Eta_B  = U_B.x  + B_B;
    float Eta_T  = U_T.x  + B_T;
    float Eta_TT = U_TT.x + GetBedElevation(ix, iy + 2);

    // ==========================================================
    // 2. Eta と 流速(V) の傾きを計算 (MUSCL スキーム)
    // 空間2次精度を達成するため、セル内の値が一様ではなく傾きを持っていると仮定する。
    // 波の尖りを保つため、MinModリミッターで極値をカットする。
    // ==========================================================
    float2 V_LL = GetVelocity(U_LL.x, U_LL.y, U_LL.z);
    float2 V_L  = GetVelocity(U_L.x,  U_L.y,  U_L.z);
    float2 V_C  = GetVelocity(U_C.x,  U_C.y,  U_C.z);
    float2 V_R  = GetVelocity(U_R.x,  U_R.y,  U_R.z);
    float2 V_RR = GetVelocity(U_RR.x, U_RR.y, U_RR.z);

    float2 V_BB = GetVelocity(U_BB.x, U_BB.y, U_BB.z);
    float2 V_B  = GetVelocity(U_B.x,  U_B.y,  U_B.z);
    float2 V_T  = GetVelocity(U_T.x,  U_T.y,  U_T.z);
    float2 V_TT = GetVelocity(U_TT.x, U_TT.y, U_TT.z);

    float slopeHX_L = MinMod(U_L.x - U_LL.x, U_C.x - U_L.x);
    float slopeHX_C = MinMod(U_C.x - U_L.x,  U_R.x - U_C.x);
    float slopeHX_R = MinMod(U_R.x - U_C.x,  U_RR.x - U_R.x);

    float slopeHY_B = MinMod(U_B.x - U_BB.x, U_C.x - U_B.x);
    float slopeHY_C = MinMod(U_C.x - U_B.x,  U_T.x - U_C.x);
    float slopeHY_T = MinMod(U_T.x - U_C.x,  U_TT.x - U_T.x);

    float2 slopeVX_L = MinMod(V_L - V_LL, V_C - V_L);
    float2 slopeVX_C = MinMod(V_C - V_L,  V_R - V_C);
    float2 slopeVX_R = MinMod(V_R - V_C,  V_RR - V_R);

    float2 slopeVY_B = MinMod(V_B - V_BB, V_C - V_B);
    float2 slopeVY_C = MinMod(V_C - V_B,  V_T - V_C);
    float2 slopeVY_T = MinMod(V_T - V_C,  V_TT - V_T);

    // 水深が極端に浅い場合（1cm未満）、全ての勾配をゼロにしてフラットな水面として扱う
    if (U_C.x < 0.01f) {
        slopeHX_C = 0.0f;
        slopeHY_C = 0.0f;
        slopeVX_C = float2(0.0f, 0.0f);
        slopeVY_C = float2(0.0f, 0.0f);
    } else {
        // 既存の流速制限（周囲が浅い場合）
        if (U_L.x < 0.01f || U_R.x < 0.01f) slopeVX_C = float2(0.0f, 0.0f);
        if (U_B.x < 0.01f || U_T.x < 0.01f) slopeVY_C = float2(0.0f, 0.0f);
    }

    // ==========================================================
    // 3. セル境界の Eta と 流速(V) を予測
    // セルの中心から境界に向かって勾配を半歩(0.5)進めた値を予測する。
    // ==========================================================
    // 境界のHを予測してから、地形Bを足してEtaを逆算する
    float h_right_face_L_raw = U_C.x + 0.5f * slopeHX_C;
    float h_right_face_R_raw = U_R.x - 0.5f * slopeHX_R;
    float h_left_face_L_raw  = U_L.x + 0.5f * slopeHX_L;
    float h_left_face_R_raw  = U_C.x - 0.5f * slopeHX_C;

    float Eta_right_face_L = h_right_face_L_raw + B_C;
    float Eta_right_face_R = h_right_face_R_raw + B_R;
    float Eta_left_face_L  = h_left_face_L_raw  + B_L;
    float Eta_left_face_R  = h_left_face_R_raw  + B_C;

    float h_top_face_B_raw = U_C.x + 0.5f * slopeHY_C;
    float h_top_face_T_raw = U_T.x - 0.5f * slopeHY_T;
    float h_bottom_face_B_raw = U_B.x + 0.5f * slopeHY_B;
    float h_bottom_face_T_raw = U_C.x - 0.5f * slopeHY_C;

    float Eta_top_face_B = h_top_face_B_raw + B_C;
    float Eta_top_face_T = h_top_face_T_raw + B_T;
    float Eta_bottom_face_B = h_bottom_face_B_raw + B_B;
    float Eta_bottom_face_T = h_bottom_face_T_raw + B_C;

    // 流速予測はそのまま
    float2 V_right_face_L  = V_C + 0.5f * slopeVX_C;
    float2 V_right_face_R  = V_R - 0.5f * slopeVX_R;
    float2 V_left_face_L   = V_L + 0.5f * slopeVX_L;
    float2 V_left_face_R   = V_C - 0.5f * slopeVX_C;

    float2 V_top_face_B  = V_C + 0.5f * slopeVY_C;
    float2 V_top_face_T  = V_T - 0.5f * slopeVY_T;
    float2 V_bottom_face_B  = V_B + 0.5f * slopeVY_B;
    float2 V_bottom_face_T  = V_C - 0.5f * slopeVY_C;

    // ==========================================================
    // 4. 静水圧再構築（水深 h の逆算）
    // 境界位置での新しい水深 h = max(0, Eta - B) を再計算する。
    // (Hydrostatic Reconstruction)
    // ==========================================================
    // X方向
    float B_right_face = max(B_C, B_R);
    float B_left_face  = max(B_L, B_C);

    float h_right_face_L = max(0.0f, Eta_right_face_L - B_right_face);
    float h_right_face_R = max(0.0f, Eta_right_face_R - B_right_face);
    float h_left_face_L  = max(0.0f, Eta_left_face_L - B_left_face);
    float h_left_face_R  = max(0.0f, Eta_left_face_R - B_left_face);

    // Y方向
    float B_top_face    = max(B_C, B_T);
    float B_bottom_face = max(B_B, B_C);

    float h_top_face_B = max(0.0f, Eta_top_face_B - B_top_face);
    float h_top_face_T = max(0.0f, Eta_top_face_T - B_top_face);
    float h_bottom_face_B = max(0.0f, Eta_bottom_face_B - B_bottom_face);
    float h_bottom_face_T = max(0.0f, Eta_bottom_face_T - B_bottom_face);

    // ==========================================================
    // 5. Fluxの計算と適用
    // 予測した境界の左右(上下)の状態を使って、HLLソルバで流出入量を求める
    // ==========================================================
    float3 UL_right = float3(h_right_face_L, h_right_face_L * V_right_face_L);
    float3 UR_right = float3(h_right_face_R, h_right_face_R * V_right_face_R);
    float3 UL_left  = float3(h_left_face_L,  h_left_face_L  * V_left_face_L);
    float3 UR_left  = float3(h_left_face_R,  h_left_face_R  * V_left_face_R);

    float3 UB_top = float3(h_top_face_B, h_top_face_B * V_top_face_B);
    float3 UT_top = float3(h_top_face_T, h_top_face_T * V_top_face_T);
    float3 UB_bottom = float3(h_bottom_face_B, h_bottom_face_B * V_bottom_face_B);
    float3 UT_bottom = float3(h_bottom_face_T, h_bottom_face_T * V_bottom_face_T);

    float3 fluxX_right = HLL_FluxX(UL_right, UR_right);
    float3 fluxX_left  = HLL_FluxX(UL_left, UR_left);
    float3 fluxY_up    = HLL_FluxY(UB_top, UT_top);
    float3 fluxY_down  = HLL_FluxY(UB_bottom, UT_bottom);

    // --- 地形の壁判定によるフラックスの遮断 ---
    // 流れる先の地形高(B)が、流れる元の水面高(Eta)より高い場合は物理的な壁として流れをゼロにする。

    // X方向
    if (fluxX_right.x > 0.0f && Eta_C <= B_R) fluxX_right = float3(0.0f, 0.0f, 0.0f); // C -> R をブロック
    if (fluxX_right.x < 0.0f && Eta_R <= B_C) fluxX_right = float3(0.0f, 0.0f, 0.0f); // R -> C をブロック

    if (fluxX_left.x > 0.0f && Eta_L <= B_C)  fluxX_left = float3(0.0f, 0.0f, 0.0f);  // L -> C をブロック
    if (fluxX_left.x < 0.0f && Eta_C <= B_L)  fluxX_left = float3(0.0f, 0.0f, 0.0f);  // C -> L をブロック

    // Y方向
    if (fluxY_up.x > 0.0f && Eta_C <= B_T)    fluxY_up = float3(0.0f, 0.0f, 0.0f);    // C -> T をブロック
    if (fluxY_up.x < 0.0f && Eta_T <= B_C)    fluxY_up = float3(0.0f, 0.0f, 0.0f);    // T -> C をブロック

    if (fluxY_down.x > 0.0f && Eta_B <= B_C)  fluxY_down = float3(0.0f, 0.0f, 0.0f);  // B -> C をブロック
    if (fluxY_down.x < 0.0f && Eta_C <= B_B)  fluxY_down = float3(0.0f, 0.0f, 0.0f);  // C -> B をブロック

    // フラックスの差分から状態を更新 (保存則の適用)
    // U_next = U_current - (dt / dx) * (Flux_right - Flux_left) - (dt / dy) * (Flux_top - Flux_bottom)
    float dtdx = dt_swe / _dxSwe;
    float3 dU = -dtdx * (fluxX_right - fluxX_left) - dtdx * (fluxY_up - fluxY_down);

    current.h  += dU.x;
    current.hu += dU.y;
    current.hv += dU.z;

    // ==========================================================
    // 6. 静水圧再構築の重力 (Well-Balanced Source Term)
    // 傾斜した地形において、重力によって水が流れ落ちる力を運動量に追加する。
    // これがないと、斜面にある静水が勝手に動き出してしまう。
    // ==========================================================
    float h_C_right_X = max(0.0f, Eta_right_face_L - B_C);
    float h_C_left_X  = max(0.0f, Eta_left_face_R  - B_C);
    float h_C_top_Y    = max(0.0f, Eta_top_face_B - B_C);
    float h_C_bottom_Y = max(0.0f, Eta_bottom_face_T - B_C);

    float source_X = 0.5f * G * (h_right_face_L * h_right_face_L - h_left_face_R * h_left_face_R)
                   - 0.5f * G * (h_C_right_X * h_C_right_X       - h_C_left_X * h_C_left_X);

    float source_Y = 0.5f * G * (h_top_face_B * h_top_face_B     - h_bottom_face_T * h_bottom_face_T)
                   - 0.5f * G * (h_C_top_Y * h_C_top_Y           - h_C_bottom_Y * h_C_bottom_Y);

    current.hu += dtdx * source_X;
    current.hv += dtdx * source_Y;
    
    // ==========================================================
    // 7. Wet / Dry 境界処理 (摩擦と減衰)
    // 極端に浅い水深でのゼロ除算や異常加速を防ぐ安定化処理
    // ==========================================================
    float new_h  = current.h;
    float new_hu = current.hu;
    float new_hv = current.hv;

    // マニングの粗度係数(n)を用いた底面摩擦力の計算
    float n_manning = 0.01f; 
    float2 vel = GetVelocity(new_h, new_hu, new_hv);
    float speed = length(vel);
    
    float safe_h = max(new_h, 0.05f); // 0.05m(5cm)より浅い場合は、摩擦力をそれ以上強くしない
    float friction = (G * n_manning * n_manning * speed) / pow(safe_h, 0.3333f);
    float damp = 1.0f / (1.0f + dt_swe * max(0.0f, friction)); // maxで保護
    new_hu *= damp; 
    new_hv *= damp;

    float c = sqrt(G * max(new_h, 0.001f));
    float max_safe_speed = max(0.0f, (0.2f * _dxSwe / dt_swe) - c);
    
    if (speed > max_safe_speed) {
        float excess_speed = speed - max_safe_speed;
        float drag = max(0.0f, 1.0f - dt_swe * excess_speed * excess_speed * 0.1f);
        new_hu *= drag; 
        new_hv *= drag;
    }

    float sponge_width = 12.0f; 
    float dist_x = min((float)ix, (float)(grid_w - 1 - ix));
    float dist_y = min((float)iy, (float)(grid_h - 1 - iy));
    float dist = min(dist_x, dist_y);
    float alpha = smoothstep(0.0f, 1.0f, dist / sponge_width);

    float2 cellWorldPos = swe_world_offset + float2(ix, iy) * _dxSwe;
    if (alpha < 1.0f) {
        // 陸地（B_C > 0）のときは H_MIN ではなく完全に 0.0f を目標値にする
        float rest_h = max(0.0f - B_C, 0.0f); 
        
        float relaxation_rate = 2.0f;
        new_h += (rest_h - new_h) * (1.0f - alpha) * dt_swe * relaxation_rate;
        
        new_hu *= (0.95f + 0.05f * alpha);
        new_hv *= (0.95f + 0.05f * alpha);
    }
    // 極めて薄い水膜（5mm未満）は、斜面での異常加速を防ぐため速度を完全に殺す
    // 質量（new_h）は維持されるためブラックホール現象は起きず、水は陸地に張り付いて静止する
    if (new_h < 0.005f) 
    {
        new_hu = 0.0f;
        new_hv = 0.0f;
    }

    // ==========================================================
    // 8. 泡 (Foam) の生成と移流・減衰
    // 波の尖り具合(ラプラシアン)や流速をもとに白波を発生させ、速度場に従って移流させる
    // ==========================================================
    float safe_dx_foam = max(_dxSwe, 0.001f);
    float laplacian_Eta_foam = (Eta_L + Eta_R + Eta_T + Eta_B - 4.0f * Eta_C) / (safe_dx_foam * safe_dx_foam);

    // 地形の凸凹を波と誤認しないよう、水深が浅い場所（5cm未満）では泡の新規発生を殺すマスク
    float foam_gen_mask = smoothstep(0.01f, 0.05f, new_h);

    float crest_foam = (laplacian_Eta_foam < -1.5f) ? (-laplacian_Eta_foam * dt_swe * 0.5f) : 0.0f;
    float shore_foam = (new_h > 0.02f && new_h < 0.3f && speed > 0.8f) ? (speed * dt_swe * 1.5f) : 0.0f;

    crest_foam *= pow(alpha, 4.0f) * foam_gen_mask; 
    shore_foam *= alpha * foam_gen_mask;

    // セミラグランジュ法による泡の移流
    float2 back_pos = float2(ix, iy) - vel * (dt_swe / _dxSwe);
    int bx = clamp(round(back_pos.x), 0, grid_w - 1);
    int by = clamp(round(back_pos.y), 0, grid_h - 1);
    float advected_foam = SWE_State_Read[by * grid_w + bx].foam;

    float new_foam = advected_foam + crest_foam + shore_foam;
    
    // 泡の減衰
    float base_decay = 0.5f; 
    float shallow_decay_boost = smoothstep(0.05f, 0.00f, new_h) * 20.0f; 
    float foam_decay = exp(-(base_decay + shallow_decay_boost) * dt_swe); 
    new_foam *= foam_decay;

    if (new_h < 0.01f) 
    {
        new_foam = max(0.0f, new_foam - dt_swe * 5.0f);
    }

    SWECell nextState;
    nextState.h  = max(new_h, 0.0f);
    nextState.hu = (nextState.h > H_MIN) ? new_hu : 0.0f;
    nextState.hv = (nextState.h > H_MIN) ? new_hv : 0.0f;
    nextState.foam = min(new_foam, 5.0f);
    SWE_State_Write[index] = nextState;
}

// ==========================================
// 昇華カーネル (SWE -> APIC)
// ==========================================
[numthreads(8, 8, 1)]
void SublimateSWEtoAPIC (uint3 id : SV_DispatchThreadID)
{
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y;
    int ix = (int)id.x;
    int iy = (int)id.y;
    if (ix >= grid_w || iy >= (int)_SweGridRes.y) return;

    uint index = iy * grid_w + ix;
    SWECell current = SWE_State_Read[index];

    int margin = 14; 
    if (ix < margin || ix >= grid_w - margin || iy < margin || iy >= grid_h - margin) {
        SWE_State_Write[index] = current; return;
    }

    float h_min = _dxSwe * 0.5f;
    if (current.h <= h_min + 0.1f) {
        SWE_State_Write[index] = current; return;
    }

    // 重い計算（3x3平滑化や地形フェッチ）の前に、流速や深さだけで簡易的に弾く
    float speed_sq = current.hu * current.hu + current.hv * current.hv;
    float h_sq = current.h * current.h;
    
    // フルード数(fr)の2乗による簡易判定
    // speed / sqrt(g*h) > fr_threshold  =>  speed^2 / (g*h) > fr^2  => speed^2 > fr^2 * g * h
    float fr_sq_threshold = fr_threshold * fr_threshold;
    if (speed_sq < fr_sq_threshold * G * current.h) { 
        SWE_State_Write[index] = current; 
        return; 
    }

    float smooth_h = 0.0f; float smooth_hu = 0.0f; float smooth_hv = 0.0f; float weight_sum = 0.0f;
    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            int nx = clamp(ix + i, 0, grid_w - 1);
            int ny = clamp(iy + j, 0, grid_w - 1);
            SWECell n_swe = SWE_State_Read[ny * grid_w + nx];
            float w = (i == 0 && j == 0) ? 0.25f : ((abs(i) + abs(j) == 1) ? 0.125f : 0.0625f);
            smooth_h += n_swe.h * w; smooth_hu += n_swe.hu * w; smooth_hv += n_swe.hv * w; weight_sum += w;
        }
    }
    smooth_h /= weight_sum; smooth_hu /= weight_sum; smooth_hv /= weight_sum;

    float safe_dx = max(_dxSwe, 0.001f);
    float safe_h = max(smooth_h, 0.001f);

    SWECell cL = SWE_State_Read[iy * grid_w + max(ix - 1, 0)];
    SWECell cR = SWE_State_Read[iy * grid_w + min(ix + 1, grid_w - 1)];
    SWECell cD = SWE_State_Read[max(iy - 1, 0) * grid_w + ix];
    SWECell cU = SWE_State_Read[min(iy + 1, grid_w - 1) * grid_w + ix];

    float u_c = smooth_hu / safe_h;
    float v_c = smooth_hv / safe_h;

    float B_L = GetBedElevation(max(ix - 1, 0), iy);
    float B_R = GetBedElevation(min(ix + 1, grid_w - 1), iy);
    float B_D = GetBedElevation(ix, max(iy - 1, 0));
    float B_U = GetBedElevation(ix, min(iy + 1, grid_h - 1));
    float B_C = GetBedElevation(ix, iy);

    float Eta_L = cL.h + B_L;
    float Eta_R = cR.h + B_R;
    float Eta_D = cD.h + B_D;
    float Eta_U = cU.h + B_U;
    float Eta_C = current.h + B_C;

    float dEta_dx = (Eta_R - Eta_L) / (2.0f * safe_dx);
    float dEta_dy = (Eta_U - Eta_D) / (2.0f * safe_dx);
    float grad_mag = sqrt(max(0.0f, dEta_dx * dEta_dx + dEta_dy * dEta_dy));
    
    float laplacian_Eta = (Eta_L + Eta_R + Eta_D + Eta_U - 4.0f * Eta_C) / (safe_dx * safe_dx);
    
    float speed = sqrt(max(0.0f, u_c * u_c + v_c * v_c));
    float fr = speed / sqrt(G * safe_h);

    // 昇華(砕波)の判定条件
    // 1. 水面の勾配 (Gradient) が閾値以上
    // 2. 波の尖り具合 (Laplacian) がマイナスの閾値以下（凹から凸へ突き上げている）
    // 3. フルード数 (Fr) が閾値以上
    bool is_breaking = false;
    if (grad_mag > grad_threshold) is_breaking = true;          
    if (laplacian_Eta < laplacian_threshold) is_breaking = true; // laplacian_h から変更
    if (fr > fr_threshold) is_breaking = true;

    if (is_breaking)
    {
        float conversion_rate = 1.0f - exp(-conversion_rate_multiplier * dt_swe); 
        float delta_h = (current.h - h_min) * conversion_rate;
        if (delta_h < 0.05f) { SWE_State_Write[index] = current; return; }

        float sublimated_mass = delta_h * safe_dx * safe_dx; 
        uint count = (uint)max(1.0f, sublimated_mass / base_mass);
        count = min(count, 50);

        float mass_per_particle = sublimated_mass / max(1.0f, (float)count);

        uint p_len, p_stride;
        APIC_Particle_Buffer.GetDimensions(p_len, p_stride);
        if (p_len == 0) p_len = 1000000;
        
        uint start_idx;
        InterlockedAdd(ParticleCounter[0], count, start_idx);
        uint spawned_count = 0;

        // 質量保存を満たすように生成すべき粒子数を逆算する
        for (uint i = 0; i < count; i++)
        {
            uint p_idx = (start_idx + i) % p_len;
            if (APIC_Particle_Buffer[p_idx].mass > 0.001f) continue; 

            APICParticle p = (APICParticle)0;
            p.mass = mass_per_particle;
            p.age = 0.0f;

            float rx = frac(sin((ix + i) * 12.9898f + iy * 78.233f) * 43758.5453f);
            float ry = frac(sin(ix * 93.989f  + (iy + i) * 67.345f) * 43758.5453f);
            float rz = frac(sin((ix * iy) * 45.123f + i * 13.567f) * 43758.5453f);

            p.position.x = swe_world_offset.x + ((float)ix + rx) * _dxSwe;
            p.position.y = swe_world_offset.y + ((float)iy + ry) * _dxSwe;
            float B_C = GetBedElevation(ix, iy);
            float spawn_base_z = B_C + current.h - delta_h; 
            p.position.z = spawn_base_z + rz * delta_h;

            float2 flow_dir = float2(u_c, v_c);
            float flow_speed = length(flow_dir);
            if (flow_speed > 0.001f) flow_dir /= flow_speed;
            else flow_dir = float2(0.0f, 0.0f);

            // 連続の式 div(u) = 0 に基づき、波が激しくぶつかって盛り上がる力
            // (-laplacian_Eta) を、APIC粒子を上空に打ち上げる初速度(push_z)に変換する。
            float c_wave = sqrt(9.81f * safe_h);
            float curl_boost = c_wave * 0.8f; 
            float push_z = clamp(max(0.0f, -laplacian_Eta) * push_z_multiplier, 0.0f, c_wave);

            p.velocity.x = u_c + flow_dir.x * curl_boost + (rx - 0.5f) * 2.0f * _dxSwe; 
            p.velocity.y = v_c + flow_dir.y * curl_boost + (ry - 0.5f) * 2.0f * _dxSwe;
            p.velocity.z = push_z + (rz * splash_velocity_multiplier) * c_wave; 
            p.c1 = float3(0,0,0); p.c2 = float3(0,0,0); p.c3 = float3(0,0,0);

            APIC_Particle_Buffer[p_idx] = p;
            spawned_count++;
        }

        float actual_sublimated_mass = mass_per_particle * (float)spawned_count;
        float actual_delta_h = actual_sublimated_mass / (safe_dx * safe_dx);
        current.h -= actual_delta_h;
        float remain_ratio = (current.h > 0.001f) ? (current.h / (current.h + actual_delta_h)) : 0.0f;
        current.hu *= remain_ratio;
        current.hv *= remain_ratio;
    }
    SWE_State_Write[index] = current;
}

[numthreads(8, 8, 1)]
void ApplyCondensation (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_SweGridRes.x || id.y >= (uint)_SweGridRes.y) return;
    uint index = id.y * _SweGridRes.x + id.x;

    SWECell current = SWE_State_Read[index];
    
    // 整数倍してアトミック加算していたので、10000.0fで割って戻す
    float delta_h = (float)Delta_H_Buffer[index] / 10000.0f;
    current.h  += delta_h;
    current.hu += (float)Delta_HU_Buffer[index] / 10000.0f;
    current.hv += (float)Delta_HV_Buffer[index] / 10000.0f;

    SWE_State_Write[index] = current;
}

[numthreads(8, 8, 1)]
void InteractSWE (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_SweGridRes.x || id.y >= (uint)_SweGridRes.y) return;

    uint index = id.y * _SweGridRes.x + id.x;
    SWECell current = SWE_State_Read[index];

    if (mouse_active == 1)
    {
        float2 cell_world_pos = swe_world_offset + float2(id.x, id.y) * _dxSwe;
        if (distance(cell_world_pos, mouse_pos) < mouse_radius)
        {
            if (current.h > 0.01f) {
                current.hu += mouse_dir.x * mouse_force * dt_apic * current.h;
                current.hv += mouse_dir.y * mouse_force * dt_apic * current.h;
            }
        }
    }

    SWE_State_Write[index] = current;
}

[numthreads(8, 8, 1)]
void ShiftSWEGrid(uint3 id : SV_DispatchThreadID)
{
    int grid_w = (int)_SweGridRes.x;
    int grid_h = (int)_SweGridRes.y;
    int ix = (int)id.x;
    int iy = (int)id.y;
    if (ix >= grid_w || iy >= grid_h) return;

    int src_x = ix + shift_amount.x;
    int src_y = iy + shift_amount.y;
    uint dst_index = iy * grid_w + ix;
    SWECell nextState;

    if (src_x >= 0 && src_x < grid_w && src_y >= 0 && src_y < grid_h) {
    nextState = SWE_State_Read[src_y * grid_w + src_x];
    } else {
        float new_B = GetBedElevation(ix, iy);
        float2 cellWorldPos = swe_world_offset + float2(ix, iy) * _dxSwe;
        float3 fft = GetFFTState(cellWorldPos, new_B);
        
        // 陸地に入った場合は H_MIN ではなく 0.0f にする
        nextState.h = max(fft.x, 0.0f); 
        nextState.hu = 0.0f;
        nextState.hv = 0.0f;
        nextState.foam = 0.0f;
    }
    SWE_State_Write[dst_index] = nextState;
}

[numthreads(8, 8, 1)]
void ClearIntermediateBuffers (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_SweGridRes.x || id.y >= (uint)_SweGridRes.y) return;
    
    uint index = id.y * _SweGridRes.x + id.x;
    
    // 中間バッファを 0 で初期化
    Delta_H_Buffer[index] = 0;
    Delta_HU_Buffer[index] = 0;
    Delta_HV_Buffer[index] = 0;
}