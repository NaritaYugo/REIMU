#pragma kernel ClearGrid
#pragma kernel P2G
#pragma kernel NormalizeVel
#pragma kernel AddGravity
#pragma kernel ApplyBoundCond
#pragma kernel Divergence
#pragma kernel BuildDiag
#pragma kernel InitCG
#pragma kernel ApplyA
#pragma kernel UpdatePR
#pragma kernel UpdateD
#pragma kernel Projection
#pragma kernel G2P_Advection
#pragma kernel DotProduct
#pragma kernel ManageCG // ComputeInitialRTr,CalculateAlpha,CalculateBeta
#pragma kernel ComputeInitialResidual
#pragma kernel MouseInteraction

#pragma kernel InitSWE
#pragma kernel MouseInteractionSWE
#pragma kernel UpdateHeight
#pragma kernel UpdateFlux
#pragma kernel ComputeFLIPFloor
#pragma kernel SmoothFLIPFloor
#pragma kernel ComputeVerticalVelocity
#pragma kernel ClearColumnCount
#pragma kernel CountParticlesPerColumn
#pragma kernel ComputeMassExchange
#pragma kernel AdjustParticles

#define SCALE 10000.0f 
#define DOT_SCALE 100000.0f

//====================================================================
int particleCount;
int maxIter;
int _UsePrecon; // 0: dot(texA,texB), 1: precon*dot(texA,texB),
int _CGPhase; // 0: InitialRTr, 1: Alpha, 2: Beta
int _MouseClick; // 0:なし, 1:引き寄せ, 2:反発

uint nx;
uint ny;

float dt;
float width;
float height;
float h;
float rho;
float gravity;
float flipRatio;
float tolerance;
float _Alpha;
float _Beta;
float2 _MousePos;
float _TargetX; // カメラのX座標
float _MaxDist; // どのくらいの距離でSWEに切り替えるか

struct Particle {
    float2 position;
    float2 velocity;
};

//====================================================================
RWStructuredBuffer<Particle> _Particles;
RWStructuredBuffer<int> _WeightXBuffer;
RWStructuredBuffer<int> _WeightYBuffer;
RWStructuredBuffer<int> _VelXBuffer;
RWStructuredBuffer<int> _VelYBuffer;
RWStructuredBuffer<float> _CGVars; // [0:rTr, 1:dAd, 2:alpha, 3:beta, 4:rTrOld]
RWStructuredBuffer<int> _DotResult; // GetDotProductの結果が入っているバッファ
RWTexture2D<int> _GridType;
RWTexture2D<float> _VelX;
RWTexture2D<float> _VelY;
RWTexture2D<float> _VelXOld;
RWTexture2D<float> _VelYOld;
RWTexture2D<float> _Pressure;
RWTexture2D<float> _Divergence;
RWTexture2D<float> _Residual;
RWTexture2D<float> _SearchDir;
RWTexture2D<float> _Ap;
RWTexture2D<float> _Precon;
Texture2D<float> _TexA;
Texture2D<float> _TexB;

RWTexture2D<float> _SWEFluxX;
RWTexture2D<float> _SWEHeight;
RWTexture2D<float> _SWEHeightOld;
RWTexture2D<float> _FLIPFloorHeight;
RWTexture2D<float> _FLIPFloorHeightSmooth;
RWStructuredBuffer<int> _ColumnParticleCount;

groupshared int gs_dot[64]; // スレッドグループ内(8x8)の共有メモリ

//====================================================================
[numthreads(8, 8, 1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    // 1. セルセンターベースのデータリセット (nx * ny)
    if (id.x < (uint)nx && id.y < (uint)ny)
    {
        uint centerIdx = id.x + id.y * nx;
        _WeightXBuffer[centerIdx] = 0;
        _WeightYBuffer[centerIdx] = 0;
        _Divergence[id.xy] = 0;
        _Pressure[id.xy] = 0;

        // --- MarkCellTypes の統合 ---
        // 外枠なら Solid(2)、それ以外は Air(0)
        bool is_boundary = (id.x == 0 || id.x == (uint)nx - 1 || id.y == 0 || id.y == (uint)ny - 1);
        _GridType[id.xy] = is_boundary ? 2 : 0;
    }

    // 2. VelX (nx+1 * ny) のリセット
    if (id.x <= (uint)nx && id.y < (uint)ny)
    {
        uint uIdx = id.x + id.y * (nx + 1);
        _VelXBuffer[uIdx] = 0;
    }

    // 3. VelY (nx * ny+1) のリセット
    if (id.x < (uint)nx && id.y <= (uint)ny)
    {
        uint vIdx = id.x + id.y * nx;
        _VelYBuffer[vIdx] = 0;
    }
}

[numthreads(64, 1, 1)]
void P2G(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)particleCount) return;

    Particle p = _Particles[id.x];
    float2 pos = p.position;
    float2 vel = p.velocity;

    // --- 共通の重み計算関数 (インライン化) ---
    // u_f と 1.0-u_f を事前に計算して分岐を消す
    
    // --- VelX (u) --- 
    float2 u_pos = float2(pos.x / h, pos.y / h - 0.5);
    int2 u_idx = (int2)floor(u_pos);
    float2 u_f = u_pos - (float2)u_idx;
    float wX[2] = { 1.0 - u_f.x, u_f.x };
    float wY[2] = { 1.0 - u_f.y, u_f.y };

    [unroll]
    for (int j = 0; j <= 1; j++) {
        [unroll]
        for (int i = 0; i <= 1; i++) {
            int2 coord = u_idx + int2(i, j);
            // 境界チェックは単純な比較演算で
            if (all(coord >= 0) && coord.x <= nx && coord.y < ny) {
                float weight = wX[i] * wY[j];
                int uIndex = coord.x + coord.y * (nx + 1);
                InterlockedAdd(_VelXBuffer[uIndex], (int)(vel.x * weight * SCALE));
                InterlockedAdd(_WeightXBuffer[uIndex], (int)(weight * SCALE));
            }
        }
    }

    // --- VelY (v) ---
    float2 v_pos = float2(pos.x / h - 0.5, pos.y / h);
    int2 v_idx = (int2)floor(v_pos);
    float2 v_f = v_pos - (float2)v_idx;
    float wvX[2] = { 1.0 - v_f.x, v_f.x };
    float wvY[2] = { 1.0 - v_f.y, v_f.y };

    [unroll]
    for (int jv = 0; jv <= 1; jv++) {
        [unroll]
        for (int iv = 0; iv <= 1; iv++) {
            int2 coord = v_idx + int2(iv, jv);
            if (all(coord >= 0) && coord.x < nx && coord.y <= ny) {
                float weight = wvX[iv] * wvY[jv];
                int vIndex = coord.x + coord.y * nx;
                InterlockedAdd(_VelYBuffer[vIndex], (int)(vel.y * weight * SCALE));
                InterlockedAdd(_WeightYBuffer[vIndex], (int)(weight * SCALE));
            }
        }
    }

    // GridTypeの更新 (流体セルのみマーク)
    int2 center = (int2)floor(pos / h);
    // 壁でない場合のみ流体としてマーク
    if (_GridType[center] != 2) {
        _GridType[center] = 1;
    }
}

[numthreads(8, 8, 1)]
void NormalizeVel(uint3 id : SV_DispatchThreadID)
{
    // --- VelX の正規化 ---
    // nx+1, ny の範囲をチェック
    if (id.x <= (uint)nx && id.y < (uint)ny)
    {
        int idx = id.x + id.y * (nx + 1);
        float sumVel = (float)_VelXBuffer[idx]; // まだ SCALE は掛けたまま
        float weight = (float)_WeightXBuffer[idx];
        
        // SCALE は分母分子で相殺されるため、そのまま割ってOK
        _VelX[id.xy] = (weight > 1e-6f) ? (sumVel / weight) : 0.0f;
    }

    // --- VelY の正規化 ---
    // nx, ny+1 の範囲をチェック
    if (id.x < (uint)nx && id.y <= (uint)ny)
    {
        int idy = id.x + id.y * nx;
        float sumVel = (float)_VelYBuffer[idy];
        float weight = (float)_WeightYBuffer[idy];
        
        _VelY[id.xy] = (weight > 1e-6f) ? (sumVel / weight) : 0.0f;
    }
}

// 重力付加
[numthreads(8, 8, 1)]
void AddGravity(uint3 id : SV_DispatchThreadID)
{
    // Python版 v[:, :] += gravity * dt に合わせる
    // vは(nx, ny+1)のサイズ
    if (id.x < nx && id.y <= ny) 
    {
        _VelY[id.xy] += gravity * dt;
    }
}

// 境界条件（壁）
[numthreads(8, 8, 1)]
void ApplyBoundCond(uint3 id : SV_DispatchThreadID)
{
    // --- 1. VelX (u) ---
    if (id.x <= (uint)nx && id.y < (uint)ny) 
    {
        bool is_wall = false;
        // 端っこ、または隣接がSolid
        if (id.x == 0 || id.x == (uint)nx) is_wall = true;
        // id.x > 0 のチェックを入れないと、左端で前のセルを見に行く時にバグる
        else if (_GridType[id.xy].x == 2 || _GridType[id.xy - uint2(1, 0)].x == 2) is_wall = true;

        if (is_wall) {
            _VelX[id.xy] = 0;
        }
    }

    // --- 2. VelY (v) ---
    if (id.x < (uint)nx && id.y <= (uint)ny) 
    {
        bool is_wall = false;
        if (id.y == 0 || id.y == (uint)ny) is_wall = true;
        else if (_GridType[id.xy].x == 2 || _GridType[id.xy - uint2(0, 1)].x == 2) is_wall = true;

        if (is_wall) {
            _VelY[id.xy] = 0;
        }
    }
}

[numthreads(8, 8, 1)]
void Divergence(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny) return;

    // Python版: du = u[ix+1, iy] - u[ix, iy]
    float uL = _VelX[id.xy];
    float uR = _VelX[id.xy + int2(1, 0)];
    float vB = _VelY[id.xy]; // Down/Bottom
    float vT = _VelY[id.xy + int2(0, 1)]; // Up/Top

    // b = -(rho * h / dt) * (du + dv)
    float div = (uR - uL) + (vT - vB);
    _Divergence[id.xy] = -(rho * h / dt) * div;

    // fluid以外は常に0
    if (_GridType[id.xy] != 1) {
        _Divergence[id.xy] = 0;
    }
}

[numthreads(8, 8, 1)]
void BuildDiag(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny) return;

    // fluid以外は前処理行列の逆数を計算しない（あるいは1などにしておく）
    if (_GridType[id.xy] != 1) {
        _Precon[id.xy] = 0.0f; // Python版 M_inv[fluid] = 1/diag に合わせるなら、非Fluidは0
        return;
    }

    float diag = 0;
    // 左(id.x-1), 右(id.x+1), 下(id.y-1), 上(id.y+1) をチェック
    // Python版: (cell_type[隣] != 2) ならカウント
    
    // x-1 (Left)
    if (id.x > 0 && _GridType[id.xy - int2(1, 0)] != 2) diag += 1.0f;
    // x+1 (Right)
    if (id.x < nx - 1 && _GridType[id.xy + int2(1, 0)] != 2) diag += 1.0f;
    // y-1 (Bottom)
    if (id.y > 0 && _GridType[id.xy - int2(0, 1)] != 2) diag += 1.0f;
    // y+1 (Top)
    if (id.y < ny - 1 && _GridType[id.xy + int2(0, 1)] != 2) diag += 1.0f;

    // M_inv = 1.0 / diag
    _Precon[id.xy] = (diag > 0) ? (1.0f / diag) : 0.0f;
}

[numthreads(8, 8, 1)]
void InitCG(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny) return;

    // 圧力の初期値として前回の圧力を使用(空気に変わった場所は0)
    if (_GridType[id.xy] != 1) {
            _Pressure[id.xy] = 0;
        }

    // 残差はこの後 A*p を計算してから求めるので、クリアのみ
    _Residual[id.xy] = 0.0f;
    _SearchDir[id.xy] = 0.0f;
    
}

[numthreads(8, 8, 1)]
void ApplyA(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nx || id.y >= (uint)ny) return;
    
    // 流体セル以外は計算不要
    if (_GridType[id.xy] != 1) {
        _Ap[id.xy] = 0;
        return;
    }

    float d_center = _SearchDir[id.xy];
    float result = 0.0f;

    // 近傍4方向のオフセット
    const int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };

    [unroll]
    for (int i = 0; i < 4; i++) {
        int2 neighbor = id.xy + offsets[i];
        
        // 領域内かどうかの判定
        if (neighbor.x >= 0 && neighbor.x < nx && neighbor.y >= 0 && neighbor.y < ny) {
            int type = _GridType[neighbor];
            
            if (type == 1) { // 隣が流体なら、ラプラシアン (center - neighbor)
                result += d_center - _SearchDir[neighbor];
            } 
            else if (type == 0) { // 隣が空気(Air)なら、境界条件 p=0 より (center - 0)
                result += d_center;
            }
            // type == 2 (Solid) の場合は、境界条件 ∂p/∂n = 0 より寄与は 0
        } else {
            // グリッドの外は壁として扱う（FLIPの標準的な処理）
            // 必要に応じてここでも result += d_center などを追加
        }
    }

    _Ap[id.xy] = result;
}

[numthreads(8, 8, 1)]
void UpdatePR(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny || _GridType[id.xy] != 1) return;

    float alpha = _CGVars[2]; // バッファから読み出し
    
    _Pressure[id.xy] += alpha * _SearchDir[id.xy];
    _Residual[id.xy] -= alpha * _Ap[id.xy];
}

[numthreads(8, 8, 1)]
void UpdateD(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny || _GridType[id.xy] != 1) return;

    float beta = _CGVars[3]; // バッファから読み出し
    
    // z = r * precon
    float z = _Residual[id.xy] * _Precon[id.xy];
    _SearchDir[id.xy] = z + beta * _SearchDir[id.xy];
}

[numthreads(8, 8, 1)]
void Projection(uint3 id : SV_DispatchThreadID)
{
    float coeff = dt / (rho * h);

    // --- VelX (u) の更新 ---
    // i in range(1, nx) に相当: 0 と nx は境界条件で 0 固定のため飛ばす
    if (id.x > 0 && id.x < nx && id.y < ny) 
    {
        // Python版: cell_type[i-1, j] != 2 and cell_type[i, j] != 2
        if (_GridType[id.xy - int2(1, 0)] != 2 && _GridType[id.xy] != 2)
        {
            _VelX[id.xy] -= coeff * (_Pressure[id.xy] - _Pressure[id.xy - int2(1, 0)]);
        }
    }

    // --- VelY (v) の更新 ---
    // j in range(1, ny) に相当: 0 と ny は境界条件で 0 固定のため飛ばす
    if (id.x < nx && id.y > 0 && id.y < ny) 
    {
        // Python版: cell_type[i, j-1] != 2 and cell_type[i, j] != 2
        if (_GridType[id.xy - int2(0, 1)] != 2 && _GridType[id.xy] != 2)
        {
            _VelY[id.xy] -= coeff * (_Pressure[id.xy] - _Pressure[id.xy - int2(0, 1)]);
        }
    }
}


[numthreads(64, 1, 1)]
void G2P_Advection(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)particleCount) return;
    Particle p = _Particles[id.x];

    // --- 1. 速度サンプリング (New/Old一括) ---
    float2 pos = p.position;

    // --- VelX サンプリング ---
    float2 u_pos = float2(pos.x / h, pos.y / h - 0.5);
    int2 u_idx = (int2)floor(u_pos);
    float2 u_f = u_pos - (float2)u_idx;
    u_idx = clamp(u_idx, 0, int2(nx - 1, ny - 1));

    float4 u_vals_new = float4(_VelX[u_idx + int2(0,0)], _VelX[u_idx + int2(1,0)], _VelX[u_idx + int2(0,1)], _VelX[u_idx + int2(1,1)]);
    float4 u_vals_old = float4(_VelXOld[u_idx + int2(0,0)], _VelXOld[u_idx + int2(1,0)], _VelXOld[u_idx + int2(0,1)], _VelXOld[u_idx + int2(1,1)]);
    float u_new = lerp(lerp(u_vals_new.x, u_vals_new.y, u_f.x), lerp(u_vals_new.z, u_vals_new.w, u_f.x), u_f.y);
    float u_old = lerp(lerp(u_vals_old.x, u_vals_old.y, u_f.x), lerp(u_vals_old.z, u_vals_old.w, u_f.x), u_f.y);

    // --- VelY サンプリング ---
    float2 v_pos = float2(pos.x / h - 0.5, pos.y / h);
    int2 v_idx = (int2)floor(v_pos);
    float2 v_f = v_pos - (float2)v_idx;
    v_idx = clamp(v_idx, 0, int2(nx - 1, ny - 1));

    float4 v_vals_new = float4(_VelY[v_idx + int2(0,0)], _VelY[v_idx + int2(1,0)], _VelY[v_idx + int2(0,1)], _VelY[v_idx + int2(1,1)]);
    float4 v_vals_old = float4(_VelYOld[v_idx + int2(0,0)], _VelYOld[v_idx + int2(1,0)], _VelYOld[v_idx + int2(0,1)], _VelYOld[v_idx + int2(1,1)]);
    float v_new = lerp(lerp(v_vals_new.x, v_vals_new.y, v_f.x), lerp(v_vals_new.z, v_vals_new.w, v_f.x), v_f.y);
    float v_old = lerp(lerp(v_vals_old.x, v_vals_old.y, v_f.x), lerp(v_vals_old.z, v_vals_old.w, v_f.x), v_f.y);

    float2 vel_new = float2(u_new, v_new);
    float2 vel_old = float2(u_old, v_old);
    float2 v_flip = p.velocity + (vel_new - vel_old);
    float2 final_vel = lerp(vel_new, v_flip, flipRatio);

    // --- 2. Sleep Check (Deep Water) ---
    int2 center = (int2)floor(p.position / h);
    bool is_in_bounds = all(center > 0) && all(center < int2(nx - 1, ny - 1));
    if (is_in_bounds) {
        bool has_air = (_GridType[center + int2(1, 0)] == 0) || (_GridType[center - int2(1, 0)] == 0) ||
                       (_GridType[center + int2(0, 1)] == 0) || (_GridType[center - int2(0, 1)] == 0);
        if (!has_air && dot(final_vel, final_vel) < 0.0004f) {
            final_vel = float2(0, 0);
        }
    }
    p.velocity = final_vel;

    // --- 3. Advection ---
    p.position += p.velocity * dt;

    // --- 4. 境界判定（Collision Resolution） ---
    const float bounce = 0.1f;
    const float margin = 0.5f * h;

    // --- 動的な床（SWE Floor）のサンプリング ---
    float floor_u = p.position.x / h;
    int floor_idx = (int)floor(floor_u);
    float floor_f = floor_u - (float)floor_idx;
    floor_idx = clamp(floor_idx, 0, nx - 2); // 隣を参照するため nx-2
    
    // 滑らかな床の高さを取得
    float h_L = _FLIPFloorHeightSmooth[int2(floor_idx, 0)];
    float h_R = _FLIPFloorHeightSmooth[int2(floor_idx + 1, 0)];
    float currentFloorY = lerp(h_L, h_R, floor_f);

    // X軸の壁判定
    float minX = 1.0f * h + margin;
    float maxX = (nx - 1) * h - margin;
    if (p.position.x < minX) {
        p.position.x = minX;
        if (p.velocity.x < 0) p.velocity.x *= -bounce;
    } else if (p.position.x > maxX) {
        p.position.x = maxX;
        if (p.velocity.x > 0) p.velocity.x *= -bounce;
    }

    // Y軸の床（動的）判定
    // ここでサンプリングした SWE の床高さを適用
    float dynamicMinY = currentFloorY + margin;
    if (p.position.y < dynamicMinY) {
        p.position.y = dynamicMinY;
        if (p.velocity.y < 0) p.velocity.y *= -bounce;
    } 
    // 天井
    else if (p.position.y > (ny - 2) * h - margin) {
        p.position.y = (ny - 2) * h - margin;
        if (p.velocity.y > 0) p.velocity.y *= -bounce;
    }

    // --- 粒子の消滅ロジック ---
    // すでに死んでいる粒子はスキップ
    if (p.position.x > 0) 
    {
        int col = (int)floor(p.position.x / h);
        col = clamp(col, 0, nx - 1);

        // 消滅条件：
        // 1. この列で消滅リクエスト(F > 0によるもの)が出ている
        // 2. 粒子が「水底」に近い (currentFloorY は境界判定で計算済みの値を使用)
        // 0.1 * h 程度を閾値にして、床にへばりついている粒子を狙い撃ちます
        if (_KillRequestCount[col] > 0 && p.position.y < currentFloorY + 0.1 * h) 
        {
            int originalValue;
            // 原子操作でリクエスト数を1減らす。成功したスレッドだけが粒子を消す権利を得る
            InterlockedDecrement(_KillRequestCount[col], originalValue);

            if (originalValue > 0) 
            {
                // 粒子の消去：位置を画面外に飛ばし、速度をゼロにする
                // (描画シェーダー側でも pos.x < 0 なら破棄する処理を入れると安全)
                p.position = float2(-1000.0, -1000.0);
                p.velocity = float2(0, 0);
            }
            else 
            {
                // すでに他のスレッドがリクエストを消費しきっていた場合は、
                // マイナスになった値を戻しておく（厳密なカウント維持のため）
                InterlockedAdd(_KillRequestCount[col], 1);
            }
        }
    }

    _Particles[id.x] = p;
}

// 共通内積カーネル
[numthreads(8, 8, 1)]
void DotProduct(
    uint3 id : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex)
{
    float val = 0.0f;
    if (id.x < (uint)nx && id.y < (uint)ny && _GridType[id.xy] == 1) {
        // デフォルトは A * B
        val = _TexA[id.xy] * _TexB[id.xy];
        
        // もし前処理(Precon)が必要なモードなら、さらにPreconを掛ける
        if (_UsePrecon) {
            val *= _Precon[id.xy];
        }
    }

    gs_dot[groupIndex] = (int)(val * DOT_SCALE);
    GroupMemoryBarrierWithGroupSync();

    // 4. 並列リダクション (グループ内の64個の値を1つにまとめる)
    // 64 -> 32 -> 16 -> 8 -> 4 -> 2 -> 1 と半分ずつ足していく
    [unroll]
    for (uint s = 32; s > 0; s >>= 1) {
        if (groupIndex < s) {
            gs_dot[groupIndex] += gs_dot[groupIndex + s];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // 5. グループの代表(index 0)だけがメインメモリに加算
    if (groupIndex == 0) {
        InterlockedAdd(_DotResult[0], gs_dot[0]);
    }
}

[numthreads(1, 1, 1)]
void ManageCG(uint3 id : SV_DispatchThreadID)
{
    float dot = (float)_DotResult[0] / DOT_SCALE;

    if (_CGPhase == 0) // InitialRTr
    {
        _CGVars[0] = dot; // rTr (Initial)
    }
    else if (_CGPhase == 1) // CalculateAlpha
    {
        float rTr = _CGVars[0];
        float dAd = dot;
        _CGVars[1] = dAd;
        _CGVars[2] = (abs(dAd) > 1e-15f) ? (rTr / dAd) : 0.0f; // alpha
    }
    else if (_CGPhase == 2) // CalculateBeta
    {
        float rTrNew = dot;
        float rTrOld = _CGVars[0];
        _CGVars[3] = rTrNew / (rTrOld + 1e-15f); // beta
        _CGVars[4] = rTrOld;
        _CGVars[0] = rTrNew; // rTr_old を更新
    }

    // 次の計算のためにドット積バッファをリセット
    _DotResult[0] = 0;
}

[numthreads(8, 8, 1)]
void ComputeInitialResidual(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny || _GridType[id.xy] != 1) return;

    // r = b - Ap
    // _Divergence が b, _Ap が今計算した A*p
    float r = _Divergence[id.xy] - _Ap[id.xy];
    _Residual[id.xy] = r;

    _SearchDir[id.xy] = r * _Precon[id.xy];
}

[numthreads(8, 8, 1)]
void MouseInteraction(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny || _MouseClick == 0) return;

    float2 cellPos = float2(id.x * h + h * 0.5, id.y * h + h * 0.5);
    float d = distance(cellPos, _MousePos);
    float radius = 0.3; 

    if (d < radius)
    {
        // ゼロ除算回避
        float safeD = max(d, 0.0001);
        float2 dir = (cellPos - _MousePos) / safeD;
        float force = (1.0 - d / radius) * 15.0; // 速度への影響度

        if (_MouseClick == 1) 
        {
            // 左クリック：かき混ぜ（壁にする）
            _GridType[id.xy] = 2;
            
            // 壁が動いているような効果を出すため、少し速度を乗せる
            _VelX[id.xy] = dir.x * force;
            _VelY[id.xy] = dir.y * force;
        }
        else if (_MouseClick == 2) 
        {
            // 右クリック：湧き出し（流体にする）
            _GridType[id.xy] = 1;
            
            // 中心から外側へ強く押し出す
            _VelX[id.xy] += dir.x * force; 
            _VelY[id.xy] += dir.y * force;
        }
    }
}

[numthreads(8, 1, 1)] // yのスレッドは1で十分
void InitSWE(uint3 id : SV_DispatchThreadID)
{
    // 高さの初期化 (x方向のループのみ)
    if (id.x < (uint)nx) {
        float h0 = height * 0.5f; // 初期水位
        // y=0 の行だけを初期化
        _SWEHeight[uint2(id.x, 0)] = h0;
        _SWEHeightOld[uint2(id.x, 0)] = h0;
    }

    // 速度の初期化 (VelX: 境界を含む nx+1)
    if (id.x < (uint)nx + 1) {
        _SWEFluxX[uint2(id.x, 0)] = 0.0f;
    }
}

// 流量更新: 現在の水位(_SWEHeight)を使って流量を更新
[numthreads(8, 1, 1)]
void UpdateFlux(uint3 id : SV_DispatchThreadID)
{
    if (id.x > (uint)nx) return;
    if (id.x == 0 || id.x == (uint)nx) { _SWEFluxX[int2(id.x, 0)] = 0; return; }

    // 前のステップで確定した水位(Height)の差を見る
    float hL = _SWEHeight[int2(id.x - 1, 0)];
    float hR = _SWEHeight[int2(id.x, 0)];

    float accel = -(hL - hR) * gravity*20;
    _SWEFluxX[int2(id.x, 0)] = (_SWEFluxX[int2(id.x, 0)] + dt * accel)*0.99;
}

// 水位更新: 前の水位(_SWEHeightOld)に流量を適用して、新しい水位(_SWEHeight)を作る
[numthreads(8, 1, 1)]
void UpdateHeight(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nx) return;

    // 前のフレームの確定した水位
    float h_old = _SWEHeightOld[int2(id.x, 0)];

    float fL = _SWEFluxX[int2(id.x, 0)];
    float fR = _SWEFluxX[int2(id.x + 1, 0)];

    float netFlux = (fL - fR) * dt / h;

    // 安定化ガード
    if (netFlux < -h_old) netFlux = -h_old * 0.99;

    float h_new = h_old + netFlux;

    // 左右の水位を少しだけ混ぜる（拡散）
    // これにより、波の「角」が取れて、滑らかに広がって消えていくようになります
    float neighborAvg = ( (id.x > 0 ? _SWEHeightOld[int2(id.x-1, 0)] : h_new) + 
                        (id.x < nx-1 ? _SWEHeightOld[int2(id.x+1, 0)] : h_new) ) * 0.5;

    // 0.01 ～ 0.05 くらいで調整。大きいほど波がすぐ平らになります。
    h_new = lerp(h_new, neighborAvg, 0.05); 

    _SWEHeight[int2(id.x, 0)] = max(0.001, h_new);
}

// マウスインタラクション (水位を直接叩く)
[numthreads(8, 1, 1)]
void MouseInteractionSWE(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nx) return;

    float x = id.x * h;
    float dist = abs(x - _MousePos.x);

    if (dist < 0.2) {
        float weight = (1.0 - dist / 0.2) * 0.1;
        
        float currentH = _SWEHeight[int2(id.x, 0)];
        float newH = currentH;

        if (_MouseClick == 1) newH += weight;
        if (_MouseClick == 2) newH = max(0.001, currentH - weight);

        // ★重要: 両方に書き込むことで、次のUpdateHeightに確実に値を引き継ぐ
        _SWEHeight[int2(id.x, 0)] = newH;
        _SWEHeightOld[int2(id.x, 0)] = newH;
    }
}

[numthreads(8, 1, 1)]
void ComputeFLIPFloor(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nx) return;

    float h_swe = _SWEHeight[int2(id.x, 0)];
    float flux = abs(_SWEFluxX[int2(id.x, 0)]);

    // 1. 距離による重み (カメラに近いほど 1.0)
    float xPos = id.x * h;
    float distWeight = 1.0 - saturate(abs(xPos - _TargetX) / _MaxDist);

    // 2. フルード数（簡易版：流量）による重み
    float flowWeight = saturate(flux * 5.0); 

    // 合計の重み (どちらか一方が満たされれば FLIP を使う)
    float weight = max(distWeight, flowWeight);

    // SWE の高さをどれだけ「削って」FLIP のスペースを作るか
    // weight = 1.0 のとき、床は 0 になり、すべての水が粒子で表現される
    _FLIPFloorHeight[int2(id.x, 0)] = h_swe * (1.0 - weight);
    
}

[numthreads(8, 1, 1)]
void SmoothFLIPFloor(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nx) return;

    float hC = _FLIPFloorHeight[int2(id.x, 0)];
    
    // 境界チェックをしつつ、左右の値をサンプリング
    float hL = (id.x > 0) ? _FLIPFloorHeight[int2(id.x - 1, 0)] : hC;
    float hR = (id.x < (uint)nx - 1) ? _FLIPFloorHeight[int2(id.x + 1, 0)] : hC;

    // --- ラプラシアン（曲率）の計算 ---
    // これが正なら「谷」、負なら「山」
    float laplacian = (hL - 2.0 * hC + hR);

    // --- 拡散強度 (設計図のイージング係数) ---
    // 0.01 ～ 0.1 程度で調整。大きくすると一瞬で平らになります。
    float easingStrength = 0.05;

    // 体積保存の更新: 
    // 中心セルが、曲率に応じて左右から水を吸い込む、あるいは吐き出す
    float h_smooth = hC + easingStrength * laplacian;

    // 安全のため、極端な水位低下を防ぐ
    _FLIPFloorHeightSmooth[int2(id.x, 0)] = max(0.001, h_smooth);
}

// --- 垂直速度の算出 ---
[numthreads(8, 1, 1)]
void ComputeVerticalVelocity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nx) return;

    // 1. 水位の時間変化 ∂h / ∂t
    float dh_dt = (_SWEHeight[int2(id.x, 0)] - _SWEHeightOld[int2(id.x, 0)]) / dt;

    // 2. 水平方向のフラックス勾配 u * ∂h / ∂x (簡略化のためフラックスの差分)
    // 左からの流入 fL と 右への流出 fR
    float fL = _SWEFluxX[int2(id.x, 0)];
    float fR = _SWEFluxX[int2(id.x + 1, 0)];
    float df_dx = (fL - fR) / h; 

    // 連続の式に基づき、逃げ場のない水の盛り上がりを垂直速度とする
    // v = ∂h/∂t + ∂(uh)/∂x
    // ここでは dh_dt をベースに、急な流れの衝突による突き上げを加味します
    float v_up = dh_dt + df_dx;

    // 急激な数値を抑えるためのクランプ（安定化）
    _SWEVerticalVel[int2(id.x, 0)] = clamp(v_up, -5.0, 5.0);
}

[numthreads(64, 1, 1)]
void ClearColumnCount(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nx) return;
    _ColumnParticleCount[id.x] = 0;
}

[numthreads(64, 1, 1)]
void CountParticlesPerColumn(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)particleCount) return;
    Particle p = _Particles[id.x];

    // 死んでいる粒子は数えない
    if (p.position.x < 0) return; 

    int col = (int)floor(p.position.x / h);
    if (col >= 0 && col < (int)nx) {
        InterlockedAdd(_ColumnParticleCount[col], 1);
    }
}

// _ColumnParticleCount を元に hf(x) を計算し、F(x) を求める
[numthreads(8, 1, 1)]
void ComputeMassExchange(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nx) return;

    // --- Step 4 & 5 ---
    // 現在のFLIP厚み (粒子数 * 1粒子あたりの高さ)
    float hf = _ColumnParticleCount[id.x] * unitVolPerParticle; 
    
    // 目標FLIP厚み (h3 は Step 3 で計算済みの、削られた後のSWE水位)
    float hf_target = max(0, _h3[int2(id.x, 0)] - _h_floor[int2(id.x, 0)]);

    // --- Step 6 & 7 ---
    float delta_hf = hf - hf_target;
    
    // βはポテンシャルの強さ（復元力）。大きすぎると振動するので 0.1～0.5程度
    float F = -_Beta * delta_hf; 
    _MassExchangeFlux[int2(id.x, 0)] = F;

    // --- Step 8: SWEへのフィードバック ---
    // ソース項として反映（F>0なら粒子が増える＝SWEが減る）
    // 注意：この値は後の SWE Height 更新時に加算します
    _SWEHeightFeedback[int2(id.x, 0)] = -dt * F; 
}

[numthreads(8, 1, 1)]
void AdjustParticles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nx) return;

    float F = _MassExchangeFlux[int2(id.x, 0)];
    float delta_m = rho * F * dt * h; // 移動する質量（Step 11）
    
    // 質量を粒子個数に変換
    int diffCount = (int)round(delta_m / (rho * unitVolPerParticle * h));

    // --- Step 11 & 12 & 13: 粒子追加 (F < 0 のとき delta_m > 0) ---
    if (diffCount > 0) {
        // 分配比率 (隣:自:隣 = 1:2:1 の重み付けで生成権を分ける)
        // 実際には各スレッドが自分の担当分を Append します
        int spawnTarget = diffCount; 
        
        for (int i = 0; i < spawnTarget; i++) {
            Particle p;
            
            // --- Step 13: 配置 ---
            // 海面(h3 + hf)から少し下に配置
            float surfaceY = _h3[int2(id.x, 0)] + (_ColumnParticleCount[id.x] * unitVolPerParticle);
            p.position = float2(id.x * h + frac(i * 0.123) * h, surfaceY - 0.05);

            // --- Step 9 & 10: 初速 ---
            float u_swe = _SWEFluxX[int2(id.x, 0)];
            float v_up = _SWEVerticalVel[int2(id.x, 0)]; // 前工程で計算済み
            
            p.velocity = float2(u_swe, v_up); // 水平はSWE、垂直は突き上げ
            p.isDead = false;
            
            _ParticleAppendBuffer.Append(p);
        }
    }
    
    // --- 消滅予約 (F > 0) ---
    if (diffCount < 0) {
        _KillRequestCount[id.x] = abs(diffCount);
    }
}
