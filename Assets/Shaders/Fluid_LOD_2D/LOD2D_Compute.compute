#define SCALE 10000.0f 
#define DOT_SCALE 100000.0f

//====================================================================
int particleCount;
int maxIter;
int _UsePrecon; // 0: dot(texA,texB), 1: precon*dot(texA,texB),
int _CGPhase; // 0: InitialRTr, 1: Alpha, 2: Beta
int _MouseClick; // 0:なし, 1:引き寄せ, 2:反発

uint nx;
uint ny;

float dt;
float width;
float height;
float h;
float rho;
float gravity;
float flipRatio;
float tolerance;
float _Alpha;
float _Beta;
float _flipPos; 
float _picPos; 
float _eulerPos; 
float _swePos; 
float _fftPos; 
float2 _MousePos;
float _aspectRatio;
float _RecoveryFactor;

float _TargetCount;
uint _maxParticles;
uint _CurrentCount;
float _Time;           // 乱数用

struct Particle {
    float2 position;
    float2 velocity;
    int active; // boolの代わりにintを使用 (0: false, 1: true)
    int padding;         // 4 bytes (パディング)
};

// 乱数生成
float rand(float2 co) {
    return frac(sin(dot(co, float2(12.9898, 78.233))) * 43758.5453);
}

// 距離計算
float GetDistanceRatio(float2 pos) {
    float2 center_pos = float2(nx, ny) * h * 0.5;
    float2 diff = pos - center_pos;
    diff.y *= _aspectRatio;
    float dist = length(diff);
    float max_dist = nx * h * 0.5; 
    return dist / max_dist;
}

//====================================================================
RWStructuredBuffer<Particle> _Particles;
RWStructuredBuffer<int> _WeightXBuffer;
RWStructuredBuffer<int> _WeightYBuffer;
RWStructuredBuffer<int> _VelXBuffer;
RWStructuredBuffer<int> _VelYBuffer;
RWStructuredBuffer<float> _CGVars; // [0:rTr, 1:dAd, 2:alpha, 3:beta, 4:rTrOld]
RWStructuredBuffer<int> _DotResult; // GetDotProductの結果が入っているバッファ
RWTexture2D<int> _GridType;
RWTexture2D<float> _VelX;
RWTexture2D<float> _VelY;
RWTexture2D<float> _VelXOld;
RWTexture2D<float> _VelYOld;
RWTexture2D<float> _Pressure;
RWTexture2D<float> _Divergence;
RWTexture2D<float> _Residual;
RWTexture2D<float> _SearchDir;
RWTexture2D<float> _Ap;
RWTexture2D<float> _Precon;
Texture2D<float> _TexA;
Texture2D<float> _TexB;
RWTexture2D<float2> _GridVel;

AppendStructuredBuffer<uint> _DeadPoolAppend;    // DeadPool（初期化・消滅時用）
ConsumeStructuredBuffer<uint> _DeadPoolConsume;  // DeadPool（生成時用）
AppendStructuredBuffer<uint> _ActiveListAppend;  // Activeリスト（毎フレーム構築）

groupshared int gs_dot[64]; // スレッドグループ内(8x8)の共有メモリ

//====================================================================
float2 SampleVelocity(float2 pos, RWTexture2D<float> vX, RWTexture2D<float> vY) {
    // u interpolation (nx+1, ny)
    float2 u_pos = float2(pos.x / h, pos.y / h - 0.5);
    int2 u_idx = (int2)floor(u_pos);
    float2 u_f = u_pos - floor(u_pos);
    
    // インデックス範囲を Python 版の if 条件と一致させる
    u_idx.x = clamp(u_idx.x, 0, (int)nx - 1); // 次のインデックス (u_idx.x + 1) が nx まで届く
    u_idx.y = clamp(u_idx.y, 0, (int)ny - 1);
    
    float u = lerp(lerp(vX[u_idx + int2(0,0)], vX[u_idx + int2(1,0)], u_f.x),
                   lerp(vX[u_idx + int2(0,1)], vX[u_idx + int2(1,1)], u_f.x), u_f.y);

    // v interpolation (nx, ny+1)
    float2 v_pos = float2(pos.x / h - 0.5, pos.y / h);
    int2 v_idx = (int2)floor(v_pos);
    float2 v_f = v_pos - floor(v_pos);
    
    v_idx.x = clamp(v_idx.x, 0, (int)nx - 1);
    v_idx.y = clamp(v_idx.y, 0, (int)ny - 1);

    float v = lerp(lerp(vY[v_idx + int2(0,0)], vY[v_idx + int2(1,0)], v_f.x),
                   lerp(vY[v_idx + int2(0,1)], vY[v_idx + int2(1,1)], v_f.x), v_f.y);

    return float2(u, v);
}
//====================================================================
[numthreads(8, 8, 1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    // 1. セルセンターベースのデータリセット (nx * ny)
    if (id.x < (uint)nx && id.y < (uint)ny)
    {
        uint centerIdx = id.x + id.y * nx;
        _WeightXBuffer[centerIdx] = 0;
        _WeightYBuffer[centerIdx] = 0;
        _Divergence[id.xy] = 0;
        _Pressure[id.xy] = 0;

        // --- MarkCellTypes の統合 ---
        // 外枠なら Solid(2)、それ以外は Air(0)
        bool is_boundary = (id.x == 0 || id.x == (uint)nx - 1 || id.y == 0 || id.y == (uint)ny - 1);
        _GridType[id.xy] = is_boundary ? 2 : 0;
    }

    // 2. VelX (nx+1 * ny) のリセット
    if (id.x <= (uint)nx && id.y < (uint)ny)
    {
        uint uIdx = id.x + id.y * (nx + 1);
        _VelXBuffer[uIdx] = 0;
    }

    // 3. VelY (nx * ny+1) のリセット
    if (id.x < (uint)nx && id.y <= (uint)ny)
    {
        uint vIdx = id.x + id.y * nx;
        _VelYBuffer[vIdx] = 0;
    }
}

[numthreads(64, 1, 1)]
void P2G(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)particleCount) return;

    Particle p = _Particles[id.x];
    float2 pos = p.position;
    float2 vel = p.velocity;
    float t = GetDistanceRatio(pos);
    
    // === Euler領域を超えた粒子はGridTypeのみ更新してreturn ===
    int2 center_idx = (int2)floor(pos / h);

    bool is_in_grid = all(center_idx >= 0 && center_idx < int2((int)nx, (int)ny));
    
    if (t > _eulerPos) {
        if (is_in_grid) {
            if (_GridType[center_idx] != 2) {
                _GridType[center_idx] = 1;
            }
        }
        return; 
    }

    // === LOD: flipPos～picPosで粒子の重さを減らしていく ===
    float fadeFlipPic = saturate((_picPos - t) / (_picPos - _flipPos + 0.0001));

    // === VelX の転送 ===
    float2 u_pos = float2(pos.x / h, pos.y / h - 0.5);
    int2 u_idx = (int2)floor(u_pos);
    float2 u_f = u_pos - (float2)u_idx;
    float wX[2] = { 1.0 - u_f.x, u_f.x };
    float wY[2] = { 1.0 - u_f.y, u_f.y };

    [unroll]
    for (int j = 0; j <= 1; j++) {
        [unroll]
        for (int i = 0; i <= 1; i++) {
            int2 coord = u_idx + int2(i, j);
            if (all(coord >= 0) && coord.x <= (int)nx && coord.y < (int)ny) {
                float weight = wX[i] * wY[j] * fadeFlipPic;
                uint uIndex = (uint)coord.x + (uint)coord.y * (nx + 1u);
                // InterlockAddは整数しか使えないのでSCALE倍して整数で送る
                // SCALEはNormalizeVelカーネルで分母分子で相殺
                if(weight > 0.001f) { // 微小な重みは無視
                    InterlockedAdd(_VelXBuffer[uIndex], (int)(vel.x * weight * SCALE));
                    InterlockedAdd(_WeightXBuffer[uIndex], (int)(weight * SCALE));
                }
            }
        }
    }

    // === VelY の転送 ===
    float2 v_pos = float2(pos.x / h - 0.5, pos.y / h);
    int2 v_idx = (int2)floor(v_pos);
    float2 v_f = v_pos - (float2)v_idx;
    float wvX[2] = { 1.0 - v_f.x, v_f.x };
    float wvY[2] = { 1.0 - v_f.y, v_f.y };

    [unroll]
    for (int jv = 0; jv <= 1; jv++) {
        [unroll]
        for (int iv = 0; iv <= 1; iv++) {
            int2 coord = v_idx + int2(iv, jv);
            if (all(coord >= 0) && coord.x < (int)nx && coord.y <= (int)ny) {
                float weight = wvX[iv] * wvY[jv] * fadeFlipPic;
                uint vIndex = (uint)coord.x + (uint)coord.y * nx;
                
                if(weight > 0.001f) {
                    InterlockedAdd(_VelYBuffer[vIndex], (int)(vel.y * weight * SCALE));
                    InterlockedAdd(_WeightYBuffer[vIndex], (int)(weight * SCALE));
                }
            }
        }
    }

    // === GridTypeの更新 ===
    int2 center = (int2)floor(pos / h);
    // 壁でない場合のみ流体としてマーク
    if (_GridType[center] != 2) {
        _GridType[center] = 1;
    }
}

[numthreads(8, 8, 1)]
void NormalizeVel(uint3 id : SV_DispatchThreadID)
{
    // --- VelX の正規化 ---
    if (id.x <= nx && id.y < ny)
    {
        uint idx = id.x + id.y * (nx + 1u);
        float sumVel = (float)_VelXBuffer[idx]; // まだ SCALE は掛けたまま
        float weight = (float)_WeightXBuffer[idx];
        
        // SCALE は分母分子で相殺
        _VelX[id.xy] = (weight > 1e-6f) ? (sumVel / weight) : 0.0f;
    }

    // --- VelY の正規化 ---
    if (id.x < nx && id.y <= ny)
    {
        int idy = id.x + id.y * nx;
        float sumVel = (float)_VelYBuffer[idy];
        float weight = (float)_WeightYBuffer[idy];
        
        _VelY[id.xy] = (weight > 1e-6f) ? (sumVel / weight) : 0.0f;
    }
}

// 重力付加
[numthreads(8, 8, 1)]
void AddGravity(uint3 id : SV_DispatchThreadID)
{
    // Python版 v[:, :] += gravity * dt に合わせる
    // vは(nx, ny+1)のサイズ
    if (id.x < nx && id.y <= ny) 
    {
        _VelY[id.xy] += gravity * dt;
    }
}

// 境界条件（壁）
[numthreads(8, 8, 1)]
void ApplyBoundCond(uint3 id : SV_DispatchThreadID)
{
    // --- 1. VelX (u) ---
    if (id.x <= (uint)nx && id.y < (uint)ny) 
    {
        bool is_wall = false;
        // 端っこ、または隣接がSolid
        if (id.x == 0 || id.x == (uint)nx) is_wall = true;
        // id.x > 0 のチェックを入れないと、左端で前のセルを見に行く時にバグる
        else if (_GridType[id.xy].x == 2 || _GridType[id.xy - uint2(1, 0)].x == 2) is_wall = true;

        if (is_wall) {
            _VelX[id.xy] = 0;
        }
    }

    // --- 2. VelY (v) ---
    if (id.x < (uint)nx && id.y <= (uint)ny) 
    {
        bool is_wall = false;
        if (id.y == 0 || id.y == (uint)ny) is_wall = true;
        else if (_GridType[id.xy].x == 2 || _GridType[id.xy - uint2(0, 1)].x == 2) is_wall = true;

        if (is_wall) {
            _VelY[id.xy] = 0;
        }
    }
}

[numthreads(8, 8, 1)]
void Divergence(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny) return;

    // --- 1. テクスチャからの速度読み取り ---
    // テクスチャは通常 0.0～1.0 ではなく物理値が入っている前提です
    float uL = _VelX[id.xy];
    float uR = _VelX[id.xy + uint2(1, 0)];
    float vB = _VelY[id.xy];
    float vT = _VelY[id.xy + uint2(0, 1)];

    float div = (uR - uL) + (vT - vB);
    float b = -(rho * h / dt) * div;

    // --- 2. 局所密度の取得 (RWIntBuffer から) ---
    uint idxL = id.x + id.y * (nx + 1);
    uint idxR = (id.x + 1) + id.y * (nx + 1);
    uint idxB = id.x + id.y * nx;
    uint idxT = id.x + (id.y + 1) * nx;

    // 重みは Fixed-point なので SCALE で割る
    float wL = (float)_WeightXBuffer[idxL] / SCALE;
    float wR = (float)_WeightXBuffer[idxR] / SCALE;
    float wB = (float)_WeightYBuffer[idxB] / SCALE;
    float wT = (float)_WeightYBuffer[idxT] / SCALE;
    
    float currentWeight = (wL + wR + wB + wT) * 0.25;

    // --- 3. 復元ポテンシャルの計算 ---
    float2 cellPos = (float2(id.xy) + 0.5) * h;
    float t = GetDistanceRatio(cellPos);
    
    // 全体の過不足
    float recoveryFactor = ((float)_TargetCount - (float)_CurrentCount) / (float)_TargetCount;

    if (_GridType[id.xy] == 1) 
    {
        _Divergence[id.xy] = b;
    }
    else if (t > _picPos && t <= _eulerPos) 
    {
        float zoneWeight = pow(saturate((t - _picPos) / (_eulerPos - _picPos + 1e-5)), 2.0);
        
        // 理想密度 1.0 に対する過不足
        float localNeed = 1.0 - currentWeight;

        // stiffness は粒子の戻り具合を見て 5.0 ～ 20.0 で調整
        float stiffness = 10.0f;
        
        // 全体不足(recoveryFactor) と 局所不足(localNeed) を合わせた吸い込み
        _Divergence[id.xy] = stiffness * (recoveryFactor + localNeed) * zoneWeight;
    }
    else 
    {
        _Divergence[id.xy] = 0;
    }
}

[numthreads(8, 8, 1)]
void BuildDiag(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny) return;

    // fluid以外は前処理行列の逆数を計算しない（あるいは1などにしておく）
    if (_GridType[id.xy] != 1) {
        _Precon[id.xy] = 0.0f; // Python版 M_inv[fluid] = 1/diag に合わせるなら、非Fluidは0
        return;
    }

    float diag = 0;
    // 左(id.x-1), 右(id.x+1), 下(id.y-1), 上(id.y+1) をチェック
    // Python版: (cell_type[隣] != 2) ならカウント
    
    // x-1 (Left)
    if (id.x > 0 && _GridType[id.xy - int2(1, 0)] != 2) diag += 1.0f;
    // x+1 (Right)
    if (id.x < nx - 1 && _GridType[id.xy + int2(1, 0)] != 2) diag += 1.0f;
    // y-1 (Bottom)
    if (id.y > 0 && _GridType[id.xy - int2(0, 1)] != 2) diag += 1.0f;
    // y+1 (Top)
    if (id.y < ny - 1 && _GridType[id.xy + int2(0, 1)] != 2) diag += 1.0f;

    // M_inv = 1.0 / diag
    _Precon[id.xy] = (diag > 0) ? (1.0f / diag) : 0.0f;
}

[numthreads(8, 8, 1)]
void InitCG(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny) return;

    // 圧力の初期値として前回の圧力を使用(空気に変わった場所は0)
    if (_GridType[id.xy] != 1) {
            _Pressure[id.xy] = 0;
        }

    // 残差はこの後 A*p を計算してから求めるので、クリアのみ
    _Residual[id.xy] = 0.0f;
    _SearchDir[id.xy] = 0.0f;
    
}

[numthreads(8, 8, 1)]
void ApplyA(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nx || id.y >= (uint)ny) return;
    
    // 流体セル以外は計算不要
    if (_GridType[id.xy] != 1) {
        _Ap[id.xy] = 0;
        return;
    }

    float d_center = _SearchDir[id.xy];
    float result = 0.0f;

    // 近傍4方向のオフセット
    const int2 offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };

    [unroll]
    for (int i = 0; i < 4; i++) {
        uint2 neighbor = id.xy + offsets[i];
        
        // 領域内かどうかの判定
        if (neighbor.x >= 0 && neighbor.x < nx && neighbor.y >= 0 && neighbor.y < ny) {
            int type = _GridType[neighbor];
            
            if (type == 1) { // 隣が流体なら、ラプラシアン (center - neighbor)
                result += d_center - _SearchDir[neighbor];
            } 
            else if (type == 0) { // 隣が空気(Air)なら、境界条件 p=0 より (center - 0)
                result += d_center;
            }
            // type == 2 (Solid) の場合は、境界条件 ∂p/∂n = 0 より寄与は 0
        } else {
            // グリッドの外は壁として扱う
        }
    }

    _Ap[id.xy] = result;
}

[numthreads(8, 8, 1)]
void UpdatePR(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny || _GridType[id.xy] != 1) return;

    float alpha = _CGVars[2]; // バッファから読み出し
    
    _Pressure[id.xy] += alpha * _SearchDir[id.xy];
    _Residual[id.xy] -= alpha * _Ap[id.xy];
}

[numthreads(8, 8, 1)]
void UpdateD(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny || _GridType[id.xy] != 1) return;

    float beta = _CGVars[3]; // バッファから読み出し
    
    // z = r * precon
    float z = _Residual[id.xy] * _Precon[id.xy];
    _SearchDir[id.xy] = z + beta * _SearchDir[id.xy];
}

[numthreads(8, 8, 1)]
void Projection(uint3 id : SV_DispatchThreadID)
{
    float coeff = dt / (rho * h);

    // --- VelX (u) の更新 ---
    // i in range(1, nx) に相当: 0 と nx は境界条件で 0 固定のため飛ばす
    if (id.x > 0 && id.x < nx && id.y < ny) 
    {
        // Python版: cell_type[i-1, j] != 2 and cell_type[i, j] != 2
        if (_GridType[id.xy - int2(1, 0)] != 2 && _GridType[id.xy] != 2)
        {
            _VelX[id.xy] -= coeff * (_Pressure[id.xy] - _Pressure[id.xy - int2(1, 0)]);
        }
    }

    // --- VelY (v) の更新 ---
    // j in range(1, ny) に相当: 0 と ny は境界条件で 0 固定のため飛ばす
    if (id.x < nx && id.y > 0 && id.y < ny) 
    {
        // Python版: cell_type[i, j-1] != 2 and cell_type[i, j] != 2
        if (_GridType[id.xy - int2(0, 1)] != 2 && _GridType[id.xy] != 2)
        {
            _VelY[id.xy] -= coeff * (_Pressure[id.xy] - _Pressure[id.xy - int2(0, 1)]);
        }
    }
}

[numthreads(64, 1, 1)]
void G2P_Advection(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)particleCount) return;
    Particle p = _Particles[id.x];
    float2 pos = p.position;
    float t = GetDistanceRatio(pos);

    // すでに非アクティブな粒子は何もしない
    if (p.active == 0) return;

    // === LOD: flipPos～picPosの間でflipRatioを動的に変える ===
    float fadeFlipPic = saturate((_picPos - t) / (_picPos - _flipPos + 0.0001));
    float fadePicEuler = saturate((_eulerPos - t) / (_eulerPos - _picPos + 0.0001));
    float dynamicFlipRatio = flipRatio * fadeFlipPic;

    // === 速度サンプリング ===
    // --- VelX ---
    float2 u_pos = float2(pos.x / h, pos.y / h - 0.5);
    int2 u_idx = (int2)floor(u_pos);
    float2 u_f = u_pos - (float2)u_idx;
    u_idx = clamp(u_idx, 0, int2(nx - 1, ny - 1));

    float u_new = lerp(lerp(_VelX[u_idx + int2(0,0)], _VelX[u_idx + int2(1,0)], u_f.x), 
                       lerp(_VelX[u_idx + int2(0,1)], _VelX[u_idx + int2(1,1)], u_f.x), u_f.y);
    float u_old = lerp(lerp(_VelXOld[u_idx + int2(0,0)], _VelXOld[u_idx + int2(1,0)], u_f.x), 
                       lerp(_VelXOld[u_idx + int2(0,1)], _VelXOld[u_idx + int2(1,1)], u_f.x), u_f.y);
    // --- VelY ---
    float2 v_pos = float2(pos.x / h - 0.5, pos.y / h);
    int2 v_idx = (int2)floor(v_pos);
    float2 v_f = v_pos - (float2)v_idx;
    v_idx = clamp(v_idx, 0, int2(nx - 1, ny - 1));

    float v_new = lerp(lerp(_VelY[v_idx + int2(0,0)], _VelY[v_idx + int2(1,0)], v_f.x), 
                       lerp(_VelY[v_idx + int2(0,1)], _VelY[v_idx + int2(1,1)], v_f.x), v_f.y);
    float v_old = lerp(lerp(_VelYOld[v_idx + int2(0,0)], _VelYOld[v_idx + int2(1,0)], v_f.x), 
                       lerp(_VelYOld[v_idx + int2(0,1)], _VelYOld[v_idx + int2(1,1)], v_f.x), v_f.y);

    // === 速度の合成 ===
    float2 vel_new = float2(u_new, v_new);
    float2 vel_old = float2(u_old, v_old);

    float2 v_flip = p.velocity + (vel_new - vel_old);
    float2 final_vel = lerp(vel_new, v_flip, dynamicFlipRatio);

    // === 動いてない粒子をSleep ===
    int2 center = (int2)floor(p.position / h);
    // 領域外チェックをまとめ、周囲に空気が無い(Deep)判定を効率化
    bool is_in_bounds = all(center > 0) && all(center < int2(nx - 1, ny - 1));
    
    if (is_in_bounds) {
        bool has_air = (_GridType[center + int2(1, 0)] == 0) || 
                       (_GridType[center - int2(1, 0)] == 0) ||
                       (_GridType[center + int2(0, 1)] == 0) || 
                       (_GridType[center - int2(0, 1)] == 0);
        
        // 速度が極低速かつ周囲に空気がなければ静止（安定化）
        if (!has_air && dot(final_vel, final_vel) < 0.0004f) { // speed < 0.02f
            final_vel = float2(0, 0);
        }
    }
    p.velocity = final_vel * (0.9 + 0.1 * fadePicEuler); // Euler領域に近づくほど減速

    // === Advection ===
    p.position += p.velocity * dt;

    // === 境界判定 ===
        const float bounce = 0.1f;
        const float margin = 0.5f * h;
        
        // 計算用の境界値
        float minX = 1.0f * h + margin;
        float maxX = (nx - 1) * h - margin;
        float minY = 1.0f * h + margin;
        float maxY = (ny - 1) * h - margin; // 天井（これより上が反射ゾーン）

        // X軸（壁）
        if (p.position.x < minX) {
            p.position.x = minX;
            if (p.velocity.x < 0) p.velocity.x *= -bounce;
        } else if (p.position.x > maxX) {
            p.position.x = maxX;
            if (p.velocity.x > 0) p.velocity.x *= -bounce;
        }

        // Y軸（床・天井）
        if (p.position.y < minY) {
            p.position.y = minY;
            if (p.velocity.y < 0) p.velocity.y *= -bounce;
        } 
        // 天井：張り付かないようclampの外側で反射
        else if (p.position.y > (ny - 2) * h - margin) {
            p.position.y = (ny - 2) * h - margin;
            if (p.velocity.y > 0) {
                p.velocity.y *= -bounce;
            }
        }

    _Particles[id.x] = p;

    // === 消滅確率 P_death ===
    // RecoveryFactor < 0 の時（粒子が多すぎる時）に活性化
    float zoneWeight = pow(saturate((t - _picPos) / (_eulerPos - _picPos + 1e-5)), 2.0);
    
    float2 centerPos = float2(width, height) * 0.5;
    float2 toCenter = normalize(p.position - centerPos);

    float p_death = 0.0;
    if (t > _eulerPos) {
        p_death = 1.0; // 境界外は強制消滅
    } else {
        // 粒子が多すぎるほど死にやすく、かつ「外向きの流れ」がある時に死を加速させる
        float outwardFlow = -dot(p.velocity, toCenter);
        p_death = saturate(-_RecoveryFactor) * zoneWeight * 0.5;
        p_death += saturate(outwardFlow) * zoneWeight * 0.3;
    }

    if (rand(p.position + _Time.x) < p_death) {
        p.active = 2; // 遺品整理ステートへ
        _Particles[id.x] = p;
    }
}

// 共通内積カーネル
[numthreads(8, 8, 1)]
void DotProduct(
    uint3 id : SV_DispatchThreadID,
    uint groupIndex : SV_GroupIndex)
{
    float val = 0.0f;
    if (id.x < (uint)nx && id.y < (uint)ny && _GridType[id.xy] == 1) {
        // デフォルトは A * B
        val = _TexA[id.xy] * _TexB[id.xy];
        
        // もし前処理(Precon)が必要なモードなら、さらにPreconを掛ける
        if (_UsePrecon) {
            val *= _Precon[id.xy];
        }
    }

    gs_dot[groupIndex] = (int)(val * DOT_SCALE);
    GroupMemoryBarrierWithGroupSync();

    // 4. 並列リダクション (グループ内の64個の値を1つにまとめる)
    // 64 -> 32 -> 16 -> 8 -> 4 -> 2 -> 1 と半分ずつ足していく
    [unroll]
    for (uint s = 32; s > 0; s >>= 1) {
        if (groupIndex < s) {
            gs_dot[groupIndex] += gs_dot[groupIndex + s];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // 5. グループの代表(index 0)だけがメインメモリに加算
    if (groupIndex == 0) {
        InterlockedAdd(_DotResult[0], gs_dot[0]);
    }
}

[numthreads(1, 1, 1)]
void ManageCG(uint3 id : SV_DispatchThreadID)
{
    float dot = (float)_DotResult[0] / DOT_SCALE;

    if (_CGPhase == 0) // InitialRTr
    {
        _CGVars[0] = dot; // rTr (Initial)
    }
    else if (_CGPhase == 1) // CalculateAlpha
    {
        float rTr = _CGVars[0];
        float dAd = dot;
        _CGVars[1] = dAd;
        _CGVars[2] = (abs(dAd) > 1e-15f) ? (rTr / dAd) : 0.0f; // alpha
    }
    else if (_CGPhase == 2) // CalculateBeta
    {
        float rTrNew = dot;
        float rTrOld = _CGVars[0];
        _CGVars[3] = rTrNew / (rTrOld + 1e-15f); // beta
        _CGVars[4] = rTrOld;
        _CGVars[0] = rTrNew; // rTr_old を更新
    }

    // 次の計算のためにドット積バッファをリセット
    _DotResult[0] = 0;
}

[numthreads(8, 8, 1)]
void ComputeInitialResidual(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny || _GridType[id.xy] != 1) return;

    // r = b - Ap
    // _Divergence が b, _Ap が今計算した A*p
    float r = _Divergence[id.xy] - _Ap[id.xy];
    _Residual[id.xy] = r;

    _SearchDir[id.xy] = r * _Precon[id.xy];
}

[numthreads(8, 8, 1)]
void MouseInteraction(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny || _MouseClick == 0) return;

    float2 cellPos = float2(id.x * h + h * 0.5, id.y * h + h * 0.5);
    float d = distance(cellPos, _MousePos);
    float radius = 0.1; 

    if (d < radius)
    {
        // ゼロ除算回避
        float safeD = max(d, 0.0001);
        float2 dir = (cellPos - _MousePos) / safeD;
        float force = (1.0 - d / radius) * 15.0; // 速度への影響度（調整してください）

        if (_MouseClick == 1) 
        {
            // 左クリック：かき混ぜ（壁にする）
            _GridType[id.xy] = 2;
            
            // 壁が動いているような効果を出すため、少し速度を乗せる
            _VelX[id.xy] = dir.x * force;
            _VelY[id.xy] = dir.y * force;
        }
        else if (_MouseClick == 2) 
        {
            // 右クリック：湧き出し（流体にする）
            _GridType[id.xy] = 1;
            
            // 中心から外側へ強く押し出す
            _VelX[id.xy] += dir.x * force; 
            _VelY[id.xy] += dir.y * force;
        }
    }
}

[numthreads(8, 8, 1)]
void SpawnParticles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nx || id.y >= (uint)ny) return;

    float2 cellPos = (float2(id.xy) + 0.5) * h;
    float t = GetDistanceRatio(cellPos);
    if (t < _picPos || t > _eulerPos) return;

    // --- 局所密度の取得 (RWIntBuffer) ---
    uint idxL = id.x + id.y * (nx + 1);
    uint idxR = (id.x + 1) + id.y * (nx + 1);
    uint idxB = id.x + id.y * nx;
    uint idxT = id.x + (id.y + 1) * nx;

    float currentWeight = ((float)_WeightXBuffer[idxL] + (float)_WeightXBuffer[idxR] + 
                           (float)_WeightYBuffer[idxB] + (float)_WeightYBuffer[idxT]) / (4.0 * SCALE);

    // --- 速度の取得 (Texture2D) ---
    float u = (_VelX[id.xy] + _VelX[id.xy + uint2(1, 0)]) * 0.5;
    float v = (_VelY[id.xy] + _VelY[id.xy + uint2(0, 1)]) * 0.5;
    float2 gridVel = float2(u, v);

    // --- 生成ロジック ---
    float recoveryFactor = ((float)_TargetCount - (float)_CurrentCount) / (float)_TargetCount;
    float densityBrake = saturate(1.0 - currentWeight); 
    float zoneWeight = pow(saturate((t - _picPos) / (_eulerPos - _picPos + 1e-5)), 2.0);

    float2 centerPos = float2(nx, ny) * 0.5 * h;
    float2 toCenter = normalize(centerPos - cellPos);
    float inwardFlow = saturate(dot(gridVel, toCenter));

    // 確率計算
    float p_birth = (saturate(recoveryFactor) * zoneWeight * densityBrake * 0.5) 
                  + (inwardFlow * zoneWeight * 0.3);

    if (rand(cellPos + _Time.x) < p_birth) {
        uint newIdx = _DeadPoolConsume.Consume();
        if (newIdx < _maxParticles) {
            float2 offset = float2(rand(cellPos + 0.13), rand(cellPos + 0.71)) - 0.5;
            Particle newP;
            newP.position = cellPos + offset * h;
            newP.velocity = gridVel;
            newP.active = 1;
            newP.padding = 0;
            _Particles[newIdx] = newP;
        }
    }
}

// 1. 最初の一回だけ実行：全インデックスをプールへ
[numthreads(64, 1, 1)]
void InitDeadPool(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)particleCount) return;
    
    _Particles[id.x].active = 0; // false -> 0
    _DeadPoolAppend.Append(id.x);
}

// 2. 毎フレーム実行：生きている粒子のIDをリスト化
[numthreads(64, 1, 1)]
void CollectActiveList(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)particleCount) return;

    if (_Particles[id.x].active == 1) { 
        _ActiveListAppend.Append(id.x);
    }
}

[numthreads(64, 1, 1)]
void InitAllParticles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)particleCount) return;

    // 1. まず全員を「死んでいる」状態としてプールへ送る
    // (Counterのリセットが必要なので、C#側で SetCounterValue(0) を呼ぶこと)
    _DeadPoolAppend.Append(id.x);

    // 2. その中から _TargetCount 分だけをピックアップして「生存」させる
    if (id.x < (uint)_TargetCount)
    {
        Particle p;
        float2 noise = float2(rand(float2(id.x, 0.1)), rand(float2(id.x, 0.9)));
        
        // 配置範囲を少し広げて確認しやすくする（例：中央 60% 範囲）
        p.position.x = width * (0.2 + noise.x * 0.6);
        p.position.y = height * (0.1 + noise.y * 0.8);
        p.velocity = float2(0, 0);
        p.active = 1; 
        p.padding = 0;
        
        _Particles[id.x] = p;
    }
    else
    {
        // 残りは完全に透明な場所へ
        _Particles[id.x].active = 0;
        _Particles[id.x].position = float2(-1000, -1000);
    }
}

[numthreads(64, 1, 1)]
void TransferDeadVelocity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _maxParticles) return; 

    Particle p = _Particles[id.x];
    
    if (p.active == 2) 
    {
        // 遺品整理（速度の委譲）
        int2 center = (int2)floor(p.position / h); 
        if (all(center >= 0 && center < int2(nx, ny))) {
            uint uIdx = (uint)center.x + (uint)center.y * (nx + 1);
            uint vIdx = (uint)center.x + (uint)center.y * nx;
            InterlockedAdd(_VelXBuffer[uIdx], (int)(p.velocity.x * SCALE));
            InterlockedAdd(_VelYBuffer[vIdx], (int)(p.velocity.y * SCALE));
            InterlockedAdd(_WeightXBuffer[uIdx], (int)(0.5f * SCALE)); 
            InterlockedAdd(_WeightYBuffer[vIdx], (int)(0.5f * SCALE));
        }
        
        p.active = 0;
        p.position = float2(-1000, -1000); // 描画事故防止
        _Particles[id.x] = p;
        _DeadPoolAppend.Append(id.x);
    }
}