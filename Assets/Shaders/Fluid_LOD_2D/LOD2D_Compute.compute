//====================================================================
#pragma kernel ClearGrid
#pragma kernel MarkCellTypes
#pragma kernel P2G
#pragma kernel NormalizeVelX
#pragma kernel NormalizeVelY
#pragma kernel AddGravity
#pragma kernel ApplyBoundCond
#pragma kernel Divergence
#pragma kernel BuildDiag
#pragma kernel ApplyA
#pragma kernel UpdatePR
#pragma kernel UpdateD
#pragma kernel Projection
#pragma kernel G2P_Advection
#pragma kernel DotProductGeneric
#pragma kernel InitCG
#pragma kernel DotProductPreconditioned
#pragma kernel CalculateAlpha
#pragma kernel CalculateBeta
#pragma kernel ComputeInitialRTr

#define SCALE 10000.0f 
#define DOT_SCALE 100000.0f

//====================================================================
int particleCount;
float dt;
float width;
float height;
float h;
uint nx;
uint ny;

float rho;
float gravity;
float flipRatio;
int maxIter; // floatからintへ
float tolerance;
float _Alpha;
float _Beta;

struct Particle {
    float2 position;
    float2 velocity;
};

//====================================================================
RWStructuredBuffer<Particle> _Particles;
RWStructuredBuffer<int> _WeightXBuffer;
RWStructuredBuffer<int> _WeightYBuffer;
RWStructuredBuffer<int> _VelXBuffer;
RWStructuredBuffer<int> _VelYBuffer;
RWStructuredBuffer<float> _CGVars; // [0:rTr, 1:dAd, 2:alpha, 3:beta, 4:rTrOld]
RWStructuredBuffer<int> _DotResult; // GetDotProductの結果が入っているバッファ
RWTexture2D<int> _GridType;
RWTexture2D<float> _VelX;
RWTexture2D<float> _VelY;
RWTexture2D<float> _VelXOld;
RWTexture2D<float> _VelYOld;
RWTexture2D<float> _Pressure;
RWTexture2D<float> _Divergence;
RWTexture2D<float> _Residual;
RWTexture2D<float> _SearchDir;
RWTexture2D<float> _Ap;
RWTexture2D<float> _Precon;
Texture2D<float> _TexA;
Texture2D<float> _TexB;

//====================================================================
float2 SampleVelocity(float2 pos, RWTexture2D<float> vX, RWTexture2D<float> vY) {
    // u interpolation (nx+1, ny)
    float2 u_pos = float2(pos.x / h, pos.y / h - 0.5);
    int2 u_idx = (int2)floor(u_pos);
    float2 u_f = u_pos - floor(u_pos);
    
    // インデックス範囲を Python 版の if 条件と一致させる
    u_idx.x = clamp(u_idx.x, 0, (int)nx - 1); // 次のインデックス (u_idx.x + 1) が nx まで届く
    u_idx.y = clamp(u_idx.y, 0, (int)ny - 1);
    
    float u = lerp(lerp(vX[u_idx + int2(0,0)], vX[u_idx + int2(1,0)], u_f.x),
                   lerp(vX[u_idx + int2(0,1)], vX[u_idx + int2(1,1)], u_f.x), u_f.y);

    // v interpolation (nx, ny+1)
    float2 v_pos = float2(pos.x / h - 0.5, pos.y / h);
    int2 v_idx = (int2)floor(v_pos);
    float2 v_f = v_pos - floor(v_pos);
    
    v_idx.x = clamp(v_idx.x, 0, (int)nx - 1);
    v_idx.y = clamp(v_idx.y, 0, (int)ny - 1);

    float v = lerp(lerp(vY[v_idx + int2(0,0)], vY[v_idx + int2(1,0)], v_f.x),
                   lerp(vY[v_idx + int2(0,1)], vY[v_idx + int2(1,1)], v_f.x), v_f.y);

    return float2(u, v);
}
//====================================================================
[numthreads(8,8,1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x < nx && id.y < ny)
    {
        uint centerIdx = id.x + id.y * nx;
        _WeightXBuffer[centerIdx] = 0;
        _WeightYBuffer[centerIdx] = 0;
        _Divergence[id.xy] = 0;
        _Pressure[id.xy] = 0;
    }

    if (id.x <= nx && id.y < ny)
    {
        uint uIdx = id.x + id.y * (nx + 1);
        _VelXBuffer[uIdx] = 0;
    }

    if (id.x < nx && id.y <= ny)
    {
        uint vIdx = id.x + id.y * nx;
        _VelYBuffer[vIdx] = 0;
    }
}

[numthreads(8, 8, 1)]
void MarkCellTypes(uint3 id : SV_DispatchThreadID)
{
    // 範囲外アクセス防止
    if (id.x >= nx || id.y >= ny) return;
    int type = 0; // Air
    if (id.x == 0 || id.x == nx - 1 || id.y == 0 || id.y == ny - 1)
    {
        type = 2; // Solid
    }
    _GridType[id.xy] = type;
}

[numthreads(64, 1, 1)]
void P2G(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)particleCount) return;

    Particle p = _Particles[id.x];
    float2 pos = p.position;
    float2 vel = p.velocity;

    // --- VelX (u) ---
    float2 u_pos = float2(pos.x / h, pos.y / h - 0.5);
    int2 u_idx = (int2)floor(u_pos);
    float2 u_f = u_pos - (float2)u_idx;

    for (int iu = 0; iu <= 1; iu++) {
        for (int ju = 0; ju <= 1; ju++) {
            int2 coord = u_idx + int2(iu, ju);
            if (coord.x >= 0 && coord.x <= (int)nx && coord.y >= 0 && coord.y < (int)ny) {
                
                // Python版のSolid判定ロジック:
                // ix + ox > 0 and cell_type[ix + ox - 1, iy + oy] == 2
                // ix + ox < nx and cell_type[ix + ox, iy + oy] == 2
                bool is_solid = false;
                if (coord.x > 0 && _GridType[int2(coord.x - 1, coord.y)] == 2) is_solid = true;
                if (coord.x < (int)nx && _GridType[int2(coord.x, coord.y)] == 2) is_solid = true;

                if (!is_solid) {
                    float weight = (iu * u_f.x + (1 - iu) * (1 - u_f.x)) * (ju * u_f.y + (1 - ju) * (1 - u_f.y));
                    int uIndex = coord.x + coord.y * (nx + 1);
                    InterlockedAdd(_VelXBuffer[uIndex], (int)(vel.x * weight * SCALE));
                    InterlockedAdd(_WeightXBuffer[uIndex], (int)(weight * SCALE)); // 専用ウェイト
                }
            }
        }
    }

    // --- VelY (v) ---
    float2 v_pos = float2(pos.x / h - 0.5, pos.y / h);
    int2 v_idx = (int2)floor(v_pos);
    float2 v_f = v_pos - (float2)v_idx;

    for (int iv = 0; iv <= 1; iv++) {
        for (int jv = 0; jv <= 1; jv++) {
            int2 coord = v_idx + int2(iv, jv);
            if (coord.x >= 0 && coord.x < (int)nx && coord.y >= 0 && coord.y <= (int)ny) {
                
                // Python版のv側にはSolid判定がないため、ここではそのまま加算
                float weight = (iv * v_f.x + (1 - iv) * (1 - v_f.x)) * (jv * v_f.y + (1 - jv) * (1 - v_f.y));
                int vIndex = coord.x + coord.y * nx;
                InterlockedAdd(_VelYBuffer[vIndex], (int)(vel.y * weight * SCALE));
                InterlockedAdd(_WeightYBuffer[vIndex], (int)(weight * SCALE)); // 専用ウェイト
            }
        }
    }

    // GridTypeの更新
    int2 center = (int2)floor(pos / h);
    if (center.x >= 0 && center.x < (int)nx && center.y >= 0 && center.y < (int)ny) {
        _GridType[center] = 1;
    }
}

[numthreads(8, 8, 1)]
void NormalizeVelX(uint3 id : SV_DispatchThreadID)
{
    if (id.x > nx || id.y >= ny) return;
    int idx = id.x + id.y * (nx + 1);
    
    float sumVel = (float)_VelXBuffer[idx] / SCALE;
    float weight = (float)_WeightXBuffer[idx] / SCALE;
    
    _VelX[id.xy] = (weight > 1e-6f) ? (sumVel / weight) : 0.0f;
}

[numthreads(8, 8, 1)]
void NormalizeVelY(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y > ny) return;
    int idx = id.x + id.y * nx;
    
    float sumVel = (float)_VelYBuffer[idx] / SCALE;
    float weight = (float)_WeightYBuffer[idx] / SCALE;
    
    _VelY[id.xy] = (weight > 1e-6f) ? (sumVel / weight) : 0.0f;
}

// 重力付加
[numthreads(8, 8, 1)]
void AddGravity(uint3 id : SV_DispatchThreadID)
{
    // Python版 v[:, :] += gravity * dt に合わせる
    // vは(nx, ny+1)のサイズ
    if (id.x < nx && id.y <= ny) 
    {
        _VelY[id.xy] += gravity * dt;
    }
}

// 境界条件（壁）
[numthreads(8, 8, 1)]
void ApplyBoundCond(uint3 id : SV_DispatchThreadID)
{
    // --- 1. VelX (u) ---
    if (id.x <= (uint)nx && id.y < (uint)ny) 
    {
        bool is_wall = false;
        // 端っこ、または隣接がSolid
        if (id.x == 0 || id.x == (uint)nx) is_wall = true;
        // id.x > 0 のチェックを入れないと、左端で前のセルを見に行く時にバグる
        else if (_GridType[id.xy].x == 2 || _GridType[id.xy - uint2(1, 0)].x == 2) is_wall = true;

        if (is_wall) {
            _VelX[id.xy] = 0;
        }
    }

    // --- 2. VelY (v) ---
    if (id.x < (uint)nx && id.y <= (uint)ny) 
    {
        bool is_wall = false;
        if (id.y == 0 || id.y == (uint)ny) is_wall = true;
        else if (_GridType[id.xy].x == 2 || _GridType[id.xy - uint2(0, 1)].x == 2) is_wall = true;

        if (is_wall) {
            _VelY[id.xy] = 0;
        }
    }
}

[numthreads(8, 8, 1)]
void Divergence(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny) return;

    // Python版: du = u[ix+1, iy] - u[ix, iy]
    float uL = _VelX[id.xy];
    float uR = _VelX[id.xy + int2(1, 0)];
    float vB = _VelY[id.xy]; // Down/Bottom
    float vT = _VelY[id.xy + int2(0, 1)]; // Up/Top

    // b = -(rho * h / dt) * (du + dv)
    float div = (uR - uL) + (vT - vB);
    _Divergence[id.xy] = -(rho * h / dt) * div;

    // fluid以外は常に0
    if (_GridType[id.xy] != 1) {
        _Divergence[id.xy] = 0;
    }
}

[numthreads(8, 8, 1)]
void BuildDiag(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny) return;

    // fluid以外は前処理行列の逆数を計算しない（あるいは1などにしておく）
    if (_GridType[id.xy] != 1) {
        _Precon[id.xy] = 0.0f; // Python版 M_inv[fluid] = 1/diag に合わせるなら、非Fluidは0
        return;
    }

    float diag = 0;
    // 左(id.x-1), 右(id.x+1), 下(id.y-1), 上(id.y+1) をチェック
    // Python版: (cell_type[隣] != 2) ならカウント
    
    // x-1 (Left)
    if (id.x > 0 && _GridType[id.xy - int2(1, 0)] != 2) diag += 1.0f;
    // x+1 (Right)
    if (id.x < nx - 1 && _GridType[id.xy + int2(1, 0)] != 2) diag += 1.0f;
    // y-1 (Bottom)
    if (id.y > 0 && _GridType[id.xy - int2(0, 1)] != 2) diag += 1.0f;
    // y+1 (Top)
    if (id.y < ny - 1 && _GridType[id.xy + int2(0, 1)] != 2) diag += 1.0f;

    // M_inv = 1.0 / diag
    _Precon[id.xy] = (diag > 0) ? (1.0f / diag) : 0.0f;
}

[numthreads(8,8,1)]
void ApplyA(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny)
        return;
    if (_GridType[id.xy] != 1)
    {
        _Ap[id.xy] = 0;
        return;
    }

    float center = _SearchDir[id.xy];
    float result = 0.0f;

    // 左
    if (id.x > 0)
    {
        if (_GridType[id.xy - int2(1,0)] != 2)
            result += (center - _SearchDir[id.xy - int2(1,0)]);
    }
    // 右
    if (id.x < nx-1)
    {
        if (_GridType[id.xy + int2(1,0)] != 2)
            result += (center - _SearchDir[id.xy + int2(1,0)]);
    }
    // 下
    if (id.y > 0)
    {
        if (_GridType[id.xy - int2(0,1)] != 2)
            result += (center - _SearchDir[id.xy - int2(0,1)]);
    }
    // 上
    if (id.y < ny-1)
    {
        if (_GridType[id.xy + int2(0,1)] != 2)
            result += (center - _SearchDir[id.xy + int2(0,1)]);
    }
    _Ap[id.xy] = result;
}

[numthreads(8, 8, 1)]
void UpdatePR(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny || _GridType[id.xy] != 1) return;

    float alpha = _CGVars[2]; // バッファから読み出し
    
    _Pressure[id.xy] += alpha * _SearchDir[id.xy];
    _Residual[id.xy] -= alpha * _Ap[id.xy];
}

[numthreads(8, 8, 1)]
void UpdateD(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny || _GridType[id.xy] != 1) return;

    float beta = _CGVars[3]; // バッファから読み出し
    
    // z = r * precon
    float z = _Residual[id.xy] * _Precon[id.xy];
    _SearchDir[id.xy] = z + beta * _SearchDir[id.xy];
}

// 初期値を格納するだけの小さなカーネル
[numthreads(1, 1, 1)]
void ComputeInitialRTr(uint3 id : SV_DispatchThreadID)
{
    _CGVars[0] = (float)_DotResult[0] / DOT_SCALE;
}

[numthreads(8, 8, 1)]
void Projection(uint3 id : SV_DispatchThreadID)
{
    float coeff = dt / (rho * h);

    // --- VelX (u) の更新 ---
    // i in range(1, nx) に相当: 0 と nx は境界条件で 0 固定のため飛ばす
    if (id.x > 0 && id.x < nx && id.y < ny) 
    {
        // Python版: cell_type[i-1, j] != 2 and cell_type[i, j] != 2
        if (_GridType[id.xy - int2(1, 0)] != 2 && _GridType[id.xy] != 2)
        {
            _VelX[id.xy] -= coeff * (_Pressure[id.xy] - _Pressure[id.xy - int2(1, 0)]);
        }
    }

    // --- VelY (v) の更新 ---
    // j in range(1, ny) に相当: 0 と ny は境界条件で 0 固定のため飛ばす
    if (id.x < nx && id.y > 0 && id.y < ny) 
    {
        // Python版: cell_type[i, j-1] != 2 and cell_type[i, j] != 2
        if (_GridType[id.xy - int2(0, 1)] != 2 && _GridType[id.xy] != 2)
        {
            _VelY[id.xy] -= coeff * (_Pressure[id.xy] - _Pressure[id.xy - int2(0, 1)]);
        }
    }
}

[numthreads(64, 1, 1)]
void G2P_Advection(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)particleCount) return;
    Particle p = _Particles[id.x];

    // --- G2P Step ---
    float2 v_new = SampleVelocity(p.position, _VelX, _VelY);
    float2 v_old = SampleVelocity(p.position, _VelXOld, _VelYOld);

    float2 v_flip = p.velocity + (v_new - v_old);
    float2 v_pic = v_new;
    float2 final_vel = lerp(v_pic, v_flip, flipRatio);

    // --- Sleep & Deep Check ---
    int2 center = (int2)floor(p.position / h);
    bool is_deep = true;
    if (center.x > 0 && center.x < (int)nx - 1 && center.y > 0 && center.y < (int)ny - 1) {
        // 周囲4マスにAir(0)があれば Deep ではない
        if (_GridType[center + int2(1, 0)] == 0 || _GridType[center - int2(1, 0)] == 0 ||
            _GridType[center + int2(0, 1)] == 0 || _GridType[center - int2(0, 1)] == 0) {
            is_deep = false;
        }
    } else {
        is_deep = false;
    }

    float speed = length(final_vel);
    bool sleep = (speed < 0.02f) && is_deep;

    if (sleep) {
        final_vel = float2(0, 0);
    }
    p.velocity = final_vel;

    // --- Advection Step ---
    p.position += p.velocity * dt;

    // 境界クランプ
    float margin = 0.5f * h;
    p.position.x = clamp(p.position.x, 1 * h + margin, (nx - 1) * h - margin);
    p.position.y = clamp(p.position.y, 1 * h + margin, (ny - 1) * h - margin);

    if (p.position.y < 1 * h + margin) {
        p.position.y = h + margin;
        // 地面に触れた瞬間に少しだけ上向きの速度を与える
        if (p.velocity.y < 0) {
            p.velocity.y *= -0.1f; // 反発係数
        }
    }
    //天井に張り付かないよう、クランプより下で反発させる
    if (p.position.y > (ny - 2) * h - margin) {
        p.position.y = (ny - 2) * h - margin;
        if (p.velocity.y > 0) {
            p.velocity.y *= -0.1f; 
        }
    }
    if (p.position.x < 1 * h + margin) {
        p.position.x = 1 * h + margin;
        if (p.velocity.x < 0) {
            p.velocity.x *= -0.1f; 
        }
    }
    if (p.position.x > (ny - 1) * h - margin) {
        p.position.y = (ny - 1) * h - margin;
        if (p.velocity.x > 0) {
            p.velocity.x *= -0.1f; 
        }
    }

    _Particles[id.x] = p;
}

[numthreads(8, 8, 1)]
void DotProductGeneric(uint3 id : SV_DispatchThreadID)
{
    if (id.x < nx && id.y < ny && _GridType[id.xy] == 1) {
        int dot = (int)(_TexA[id.xy] * _TexB[id.xy] * DOT_SCALE);
        InterlockedAdd(_DotResult[0], dot);
    }
}

[numthreads(8, 8, 1)]
void InitCG(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny) return;

    // 圧力の初期値
    _Pressure[id.xy] = 0;

    if (_GridType[id.xy] == 1) // Fluidセルのみ
    {
        // 初期残差 r = b - Ap (初期圧力が0なら r = b)
        // ここでは Divergence をそのまま残差としてセット
        float r = _Divergence[id.xy];
        _Residual[id.xy] = r;

        // 初期探索方向 d = M^-1 * r (Preconを適用)
        _SearchDir[id.xy] = r * _Precon[id.xy];
    }
    else
    {
        _Residual[id.xy] = 0;
        _SearchDir[id.xy] = 0;
    }
    
    // Apバッファも一応クリア
    _Ap[id.xy] = 0;
}

// 前処理付き内積専用カーネル
[numthreads(8, 8, 1)]
void DotProductPreconditioned(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= nx || id.y >= ny || _GridType[id.xy] != 1) return;

    float r = _Residual[id.xy];
    float minv = _Precon[id.xy];
    
    // Python版 delta_new = np.sum(r * z) 
    // z = r * minv なので、r * r * minv を加算する
    float val = r * r * minv;

    InterlockedAdd(_DotResult[0], (int)(val * DOT_SCALE));
}

[numthreads(1, 1, 1)]
void CalculateAlpha(uint3 id : SV_DispatchThreadID) {
    float rTr = _CGVars[0]; 
    float dAd = (float)_DotResult[0] / DOT_SCALE; 
    
    _CGVars[1] = dAd;
    
    // ガードを極めて強くする
    // dAdが少しでも怪しければ alpha を 0 にしてそのループを無効化する
    if (dAd > 1e-15f) {
        _CGVars[2] = rTr / dAd;
    } else {
        _CGVars[2] = 0.0f; 
    }

    _DotResult[0] = 0; // ここでリセット
}

[numthreads(1, 1, 1)]
void CalculateBeta(uint3 id : SV_DispatchThreadID) {
    float rTrNew = (float)_DotResult[0] / DOT_SCALE;
    float rTrOld = _CGVars[0];
    
    _CGVars[3] = rTrNew / (rTrOld + 1e-10f); // betaを計算
    _CGVars[4] = rTrOld; // 前の値をバックアップ
    _CGVars[0] = rTrNew; // 新しいrTrを保存
    _DotResult[0] = 0;
}