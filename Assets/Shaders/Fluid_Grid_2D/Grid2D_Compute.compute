#pragma kernel AddHeat
#pragma kernel Advection
#pragma kernel Diffusion
#pragma kernel Divergence
#pragma kernel PressureSolve
#pragma kernel ProjectVelocity

// --- 共通バッファ ---
Texture2D<float4> Input;
RWTexture2D<float4> Result;

// --- 圧力・発散用バッファ（名前をユニークにする） ---
Texture2D<float4> VelIn;
RWTexture2D<float4> VelOut;
Texture2D<float4> DivIn;
RWTexture2D<float4> DivOut;
Texture2D<float4> PresIn;
RWTexture2D<float4> PresOut;

SamplerState MyLinearClampSampler;

float alpha, dt, dx;
float4 texSize;
float2 mousePos;
float2 mouseVelocity;
float brushSize;
float time;
bool mouseDown;
bool addLeftEdgeFlow;

// --- 速度追加 ---
[numthreads(8, 8, 1)]
void AddHeat (uint3 id : SV_DispatchThreadID) {
    float2 uv = (float2)id.xy / texSize.xy;
    float4 newVel = Result[id.xy];

    // --- マウス入力（既存のコード） ---
    if (mouseDown) {
        float dist = distance(uv, mousePos);
        if (dist < brushSize) {
            newVel.xy += mouseVelocity * (1.0 - (dist / brushSize));
        }
    }

    if (addLeftEdgeFlow) {
        for(int i = 1; i <= 5; i++) {
            float targetY = (float)i*0.2-0.1;
            float2 sourcePos = float2(0.01, targetY);
            
            float dist = distance(uv, sourcePos);
            if (dist < 0.05) { // 影響範囲を少し狭める
                // タイミングを同期させる（iによる補正を消す）
                float pulse = 1.0;
                
                // 全ての点から同じ強さで右方向へ
                newVel.xy += float2(pulse, 0) * (1.0 - (dist / 0.05));
            }
        }

    }
    
    Result[id.xy] = newVel;
}

// --- 移流 ---
[numthreads(8, 8, 1)]
void Advection (uint3 id : SV_DispatchThreadID) {
    float2 v = Input[id.xy].xy;
    float2 pos = (float2)id.xy + 0.5;
    float2 backPos = pos - (v * dt);
    float2 uv = backPos / texSize.xy;
    Result[id.xy] = Input.SampleLevel(MyLinearClampSampler, uv, 0);
}

// --- 拡散 ---
[numthreads(8, 8, 1)]
void Diffusion (uint3 id : SV_DispatchThreadID) {
    float4 center = Input[id.xy];
    float4 laplacian = (Input[id.xy + int2(-1, 0)] + Input[id.xy + int2(1, 0)] + 
                        Input[id.xy + int2(0, 1)] + Input[id.xy + int2(0, -1)] - 4.0 * center) / (dx * dx);
    Result[id.xy] = center + (alpha * dt * laplacian)*0.995;
}

// --- 発散 ---
[numthreads(8, 8, 1)]
void Divergence (uint3 id : SV_DispatchThreadID) {
    float2 L = VelIn[id.xy + int2(-1, 0)].xy;
    float2 R = VelIn[id.xy + int2(1, 0)].xy;
    float2 B = VelIn[id.xy + int2(0, -1)].xy;
    float2 T = VelIn[id.xy + int2(0, 1)].xy;
    float div = (R.x - L.x + T.y - B.y) * 0.5 / dx;
    DivOut[id.xy] = float4(div, 0, 0, 1);
}

// --- 圧力の反復計算 ---
[numthreads(8, 8, 1)]
void PressureSolve (uint3 id : SV_DispatchThreadID) {
    float pL = PresIn[id.xy + int2(-1, 0)].r;
    float pR = PresIn[id.xy + int2(1, 0)].r;
    float pB = PresIn[id.xy + int2(0, -1)].r;
    float pT = PresIn[id.xy + int2(0, 1)].r;
    float div = DivIn[id.xy].r;
    float pNext = (pL + pR + pB + pT - div * dx * dx) * 0.25;
    PresOut[id.xy] = float4(pNext, 0, 0, 1);
}

// --- 速度の補正 ---
// 求まった圧力の勾配を、今の速度から引く
[numthreads(8, 8, 1)]
void ProjectVelocity (uint3 id : SV_DispatchThreadID) {
    float pL = PresIn[id.xy + int2(-1, 0)].r;
    float pR = PresIn[id.xy + int2(1, 0)].r;
    float pB = PresIn[id.xy + int2(0, -1)].r;
    float pT = PresIn[id.xy + int2(0, 1)].r;
    float2 v = VelIn[id.xy].xy;
    float2 grad = float2(pR - pL, pT - pB) * 0.5 / dx;
    VelOut[id.xy] = float4(v - grad, 0, 1);
}