#include "REIMU_Common.cginc"

float3 apic_world_offset;
float2 swe_world_offset;

RWStructuredBuffer<APICParticle> APIC_Particle_Buffer;
RWStructuredBuffer<int> APIC_Grid_Mass;
RWStructuredBuffer<int> APIC_Grid_VelX;
RWStructuredBuffer<int> APIC_Grid_VelY;
RWStructuredBuffer<int> APIC_Grid_VelZ;
RWStructuredBuffer<float> APIC_Divergence;
RWStructuredBuffer<float> APIC_Pressure_Write;
StructuredBuffer<SWECell> SWE_State_Read;
RWStructuredBuffer<int> Delta_H_Buffer;
RWStructuredBuffer<int> Delta_HU_Buffer;
RWStructuredBuffer<int> Delta_HV_Buffer;
RWStructuredBuffer<float> PCG_R;       
RWStructuredBuffer<float> PCG_P;       
RWStructuredBuffer<float> PCG_Q;       
RWStructuredBuffer<float> PCG_Precon;  
RWStructuredBuffer<uint> PCG_DotResult; 
RWStructuredBuffer<float> PCG_Scalars; 
AppendStructuredBuffer<uint> ActiveParticleList_Write;
StructuredBuffer<uint> ActiveParticleList_Read;
ByteAddressBuffer ActiveParticleCount; 
RWStructuredBuffer<uint> ParticleDispatchArgs;
RWStructuredBuffer<uint> DrawArgsBuffer;
Texture2D<float> TerrainHeightMap;
Texture2D<float4> FFT_DispLOD0;
Texture2D<float4> FFT_DispLOD1;
Texture2D<float4> FFT_DispLOD2;
float FFT_Size0, FFT_Size1, FFT_Size2;

groupshared float shared_dot[512]; // 8*8*8 = 512スレッド

uint max_particles;
static const float G = 9.81f;
float horizontal_momentum_transfer;
float vertical_momentum_to_wave;
float sea_bottom_z;

SamplerState sampler_LinearRepeat
{
    Filter = MIN_MAG_MIP_LINEAR;
    AddressU = Wrap;
    AddressV = Wrap;
};

float GetFFTSurfaceY(float2 worldPos)
{
    float2 uv0 = worldPos / FFT_Size0;
    float2 uv1 = worldPos / FFT_Size1;
    float2 uv2 = worldPos / FFT_Size2;
    float y0 = FFT_DispLOD0.SampleLevel(sampler_LinearRepeat, uv0, 0).y;
    float y1 = FFT_DispLOD1.SampleLevel(sampler_LinearRepeat, uv1, 0).y;
    float y2 = FFT_DispLOD2.SampleLevel(sampler_LinearRepeat, uv2, 0).y;
    return y0 + y1 + y2;
}

// APICの原点を「海面(0m)からグリッドの高さ半分だけ下げた位置」にする
inline float3 GetAPICOrigin() {
    return float3(
        apic_world_offset.x,
        apic_world_offset.y,
        apic_world_offset.z - (apic_grid_size.z * 0.5f) * dx_apic
    );
}

inline float3 QuadraticBSpline(float3 x) {
    float3 abs_x = abs(x);
    return (abs_x < 0.5f) ? (0.75f - abs_x * abs_x) : ((abs_x < 1.5f) ? (0.5f * (1.5f - abs_x) * (1.5f - abs_x)) : 0.0f);
}

inline uint GetGridIndex(uint3 id) {
    return id.z * (apic_grid_size.x * apic_grid_size.y) + id.y * apic_grid_size.x + id.x;
}

inline float4 GetSWEBoundaryInfo(uint3 apic_id)
{
    float3 apic_origin = GetAPICOrigin();
    float2 cell_world_pos = apic_origin.xy + (float2(apic_id.x, apic_id.y) + 0.5f) * dx_apic;
    float2 swe_local_pos = cell_world_pos - swe_world_offset;
    
    int swe_x = clamp((int)floor(swe_local_pos.x / dx_swe), 0, (int)swe_grid_size.x - 1);
    int swe_y = clamp((int)floor(swe_local_pos.y / dx_swe), 0, (int)swe_grid_size.y - 1);
    
    float smoothed_h = 0.0f; float smoothed_hu = 0.0f; float smoothed_hv = 0.0f; float weight_sum = 0.0f;
    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            int nx = clamp(swe_x + i, 0, (int)swe_grid_size.x - 1);
            int ny = clamp(swe_y + j, 0, (int)swe_grid_size.y - 1);
            SWECell n_swe = SWE_State_Read[ny * swe_grid_size.x + nx];
            float w = (i == 0 && j == 0) ? 4.0f : ((abs(i) + abs(j) == 1) ? 2.0f : 1.0f);
            smoothed_h += n_swe.h * w; smoothed_hu += n_swe.hu * w; smoothed_hv += n_swe.hv * w; weight_sum += w;
        }
    }
    smoothed_h /= weight_sum; smoothed_hu /= weight_sum; smoothed_hv /= weight_sum;

    float z_bottom = apic_origin.z + apic_id.z * dx_apic;

    int flipped_y = (int)swe_grid_size.y - 1 - swe_y;
    float b_c = TerrainHeightMap.Load(int3(swe_x, flipped_y, 0)).r;
    float fft_y = GetFFTSurfaceY(cell_world_pos);
    float swe_surface_y = b_c + smoothed_h + fft_y;

    float phi = clamp((swe_surface_y - z_bottom) / dx_apic, 0.0f, 1.0f);
    float theta = 1.0f - phi;
    float u_swe = (smoothed_h > 0.001f) ? smoothed_hu / smoothed_h : 0.0f;
    float v_swe = (smoothed_h > 0.001f) ? smoothed_hv / smoothed_h : 0.0f;
    return float4(u_swe, v_swe, 0.0f, theta);
}

inline bool IsObstacle(uint3 id) {
    float3 apic_origin = GetAPICOrigin();
    float2 cell_world_pos = apic_origin.xy + (float2(id.x, id.y) + 0.5f) * dx_apic;
    float2 swe_local_pos = cell_world_pos - swe_world_offset;
    int swe_x = clamp((int)floor(swe_local_pos.x / dx_swe), 0, (int)swe_grid_size.x - 1);
    int swe_y = clamp((int)floor(swe_local_pos.y / dx_swe), 0, (int)swe_grid_size.y - 1);
    
    int flipped_y = (int)swe_grid_size.y - 1 - swe_y;
    float b_c = TerrainHeightMap.Load(int3(swe_x, flipped_y, 0)).r;
    float z_bottom = apic_origin.z + id.z * dx_apic;
    
    // SWEの水深(h_swe)は含めず、純粋な地形のみを障害物とする
    return z_bottom <= b_c;
}

[numthreads(64, 1, 1)]
void AdvectParticles (uint3 id : SV_DispatchThreadID)
{
    uint count = ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    uint index = ActiveParticleList_Read[id.x];
    APICParticle p = APIC_Particle_Buffer[index];
    if (p.mass <= 0.0f) return;

    p.velocity.z -= G * dt_apic;
    p.position += p.velocity * dt_apic;

    float3 apic_origin = GetAPICOrigin();
    float3 min_bounds = apic_origin;
    float3 max_bounds = apic_origin + float3(apic_grid_size.x, apic_grid_size.y, apic_grid_size.z) * dx_apic;

    // 【追加】地形（Terrain）との衝突判定と摩擦
    float2 swe_local_pos = p.position.xy - swe_world_offset;
    int swe_x = clamp((int)floor(swe_local_pos.x / dx_swe), 0, (int)swe_grid_size.x - 1);
    // ※前回のY軸反転対応をしている場合、ここで y をフリップさせます
    int flipped_y = (int)swe_grid_size.y - 1 - clamp((int)floor(swe_local_pos.y / dx_swe), 0, (int)swe_grid_size.y - 1);
    float b_c = TerrainHeightMap.Load(int3(swe_x, flipped_y, 0)).r;

    // パーティクルが地面より下に潜ったら、地面の上に押し上げて減速させる
    if (p.position.z < b_c) {
        p.position.z = b_c + 0.01f; // 【修正】ほんの少しだけ浮かせる
        p.velocity.z = max(0.0f, p.velocity.z * -0.3f); 
        p.velocity.x *= 0.5f; 
        p.velocity.y *= 0.5f;
    }

    // 【修正】グリッドの枠外に出たパーティクルは消滅させて圧力を逃がす
    float margin = 0.1f;
    if (p.position.x < min_bounds.x + margin || p.position.x > max_bounds.x - margin ||
        p.position.y < min_bounds.y + margin || p.position.y > max_bounds.y - margin ||
        p.position.z < min_bounds.z + margin || p.position.z > max_bounds.z - margin) 
    {
        p.mass = 0.0f; // パーティクルキル
    }

    APIC_Particle_Buffer[index] = p;
}

[numthreads(64, 1, 1)]
void P2G_Transfer (uint3 id : SV_DispatchThreadID)
{
    uint count = ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    uint index = ActiveParticleList_Read[id.x];
    APICParticle p = APIC_Particle_Buffer[index];
    if (p.mass <= 0.0f) return;

    float3 apic_origin = GetAPICOrigin();
    float3 local_pos = p.position - apic_origin;
    float3 grid_pos = (local_pos / dx_apic) - 0.5f;
    int3 base_idx = (int3)floor(grid_pos + 0.5f);

    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            [unroll]
            for (int k = -1; k <= 1; k++) {
                int3 cell_idx = base_idx + int3(i, j, k);
                int cx = clamp(cell_idx.x, 0, apic_grid_size.x - 1);
                int cy = clamp(cell_idx.y, 0, apic_grid_size.y - 1);
                int cz = clamp(cell_idx.z, 0, apic_grid_size.z - 1);

                float3 d_pos = grid_pos - (float3)cell_idx;
                float3 weight_vec = QuadraticBSpline(d_pos);
                float weight = weight_vec.x * weight_vec.y * weight_vec.z;

                if (weight > 0.0f) {
                    float mass_contrib = p.mass * weight;
                    
                    // 【修正】Affine項の正しい計算。D^-1 (今回は4.0) はG2Pの時点でCに掛けられていると仮定
                    float3 affine_v = float3(dot(p.c1, d_pos), dot(p.c2, d_pos), dot(p.c3, d_pos));
                    
                    // 運動量は (p.v + p.C * d_pos) * mass * weight
                    float3 momentum_contrib = mass_contrib * (p.velocity + affine_v);
                    
                    uint flat_idx = cz * (apic_grid_size.x * apic_grid_size.y) + cy * apic_grid_size.x + cx;

                    int add_mass = (int)(mass_contrib * 10000.0f);
                    int add_velX = (int)(momentum_contrib.x * 10000.0f);
                    int add_velY = (int)(momentum_contrib.y * 10000.0f);
                    int add_velZ = (int)(momentum_contrib.z * 10000.0f);

                    InterlockedAdd(APIC_Grid_Mass[flat_idx], add_mass);
                    InterlockedAdd(APIC_Grid_VelX[flat_idx], add_velX);
                    InterlockedAdd(APIC_Grid_VelY[flat_idx], add_velY);
                    InterlockedAdd(APIC_Grid_VelZ[flat_idx], add_velZ);
                }
            }
        }
    }
}

[numthreads(8, 8, 8)]
void NormalizeGridVelocity (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    uint idx = GetGridIndex(id);
    
    // 【修正】10000.0f で割り戻して float にする
    float mass = (float)APIC_Grid_Mass[idx] / 10000.0f;
    
    if (mass > 0.0001f) {
        float vx = ((float)APIC_Grid_VelX[idx] / 10000.0f) / mass;
        float vy = ((float)APIC_Grid_VelY[idx] / 10000.0f) / mass;
        float vz = ((float)APIC_Grid_VelZ[idx] / 10000.0f) / mass;
        
        // 【修正】後の計算で float として読み出せるよう asint で格納
        APIC_Grid_VelX[idx] = asint(vx);
        APIC_Grid_VelY[idx] = asint(vy);
        APIC_Grid_VelZ[idx] = asint(vz);
    } else {
        APIC_Grid_VelX[idx] = 0; 
        APIC_Grid_VelY[idx] = 0; 
        APIC_Grid_VelZ[idx] = 0;
    }
}

[numthreads(8, 8, 8)]
void ComputeDivergence (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z|| IsObstacle(id)) return;
    uint idx = GetGridIndex(id);

    float4 center_info = GetSWEBoundaryInfo(id);
    float theta_c = center_info.w;

    if (asfloat(APIC_Grid_Mass[idx]) < 0.0001f || theta_c < 0.001f) {
        APIC_Divergence[idx] = 0.0f;
        return;
    }

    float vR = (id.x < (uint)apic_grid_size.x - 1 && !IsObstacle(id + uint3(1, 0, 0))) ? asfloat(APIC_Grid_VelX[idx + 1]) : 0.0f;
    float vL = (id.x > 0                          && !IsObstacle(id - uint3(1, 0, 0))) ? asfloat(APIC_Grid_VelX[idx - 1]) : 0.0f;
    float vU = (id.y < (uint)apic_grid_size.y - 1 && !IsObstacle(id + uint3(0, 1, 0))) ? asfloat(APIC_Grid_VelY[idx + apic_grid_size.x]) : 0.0f;
    float vD = (id.y > 0                          && !IsObstacle(id - uint3(0, 1, 0))) ? asfloat(APIC_Grid_VelY[idx - apic_grid_size.x]) : 0.0f;
    float vF = (id.z < (uint)apic_grid_size.z - 1 && !IsObstacle(id + uint3(0, 0, 1))) ? asfloat(APIC_Grid_VelZ[idx + apic_grid_size.x * apic_grid_size.y]) : 0.0f;
    float vB = (id.z > 0                          && !IsObstacle(id - uint3(0, 0, 1))) ? asfloat(APIC_Grid_VelZ[idx - apic_grid_size.x * apic_grid_size.y]) : 0.0f;

    float div = (vR - vL + vU - vD + vF - vB) / (2.0f * dx_apic);
    APIC_Divergence[idx] = -(rho * dx_apic * dx_apic / dt_apic) * div * theta_c;
}

[numthreads(64, 1, 1)]
void G2P_Transfer (uint3 id : SV_DispatchThreadID)
{
    uint count = ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    uint index = ActiveParticleList_Read[id.x];
    APICParticle p = APIC_Particle_Buffer[index];
    if (p.mass <= 0.0f) return;

    // 【修正】APIC空間のオフセット
    float3 apic_origin = GetAPICOrigin();
    float3 local_pos = p.position - apic_origin;
    float3 grid_pos = (local_pos / dx_apic) - 0.5f;
    int3 base_idx = (int3)floor(grid_pos + 0.5f);

    float3 pic_velocity = 0.0f; float3 new_c1 = 0.0f; float3 new_c2 = 0.0f; float3 new_c3 = 0.0f;

    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            [unroll]
            for (int k = -1; k <= 1; k++) {
                int3 cell_idx = base_idx + int3(i, j, k);
                int cx = clamp(cell_idx.x, 0, apic_grid_size.x - 1);
                int cy = clamp(cell_idx.y, 0, apic_grid_size.y - 1);
                int cz = clamp(cell_idx.z, 0, apic_grid_size.z - 1);

                uint flat_idx = cz * (apic_grid_size.x * apic_grid_size.y) + cy * apic_grid_size.x + cx;

                float3 corrected_vel = 0.0f;
                float3 vel_star = float3(asfloat(APIC_Grid_VelX[flat_idx]), asfloat(APIC_Grid_VelY[flat_idx]), asfloat(APIC_Grid_VelZ[flat_idx]));

                // 【修正】もしセル自体が障害物（地形）なら、そこから流体の圧力は受け取らない（速度0として扱う）
                if (IsObstacle(cell_idx)) {
                    corrected_vel = vel_star;
                } else {
                    float p_center_raw = APIC_Pressure_Write[flat_idx];

                    // 境界または地形（Obstacle）の場合は、圧力をミラーリングして勾配を0にする（ノイマン境界）
                    bool obsR = (cx >= apic_grid_size.x - 1) || IsObstacle(cell_idx + int3(1, 0, 0));
                    bool obsL = (cx <= 0)                    || IsObstacle(cell_idx - int3(1, 0, 0));
                    bool obsU = (cy >= apic_grid_size.y - 1) || IsObstacle(cell_idx + int3(0, 1, 0));
                    bool obsD = (cy <= 0)                    || IsObstacle(cell_idx - int3(0, 1, 0));
                    bool obsF = (cz >= apic_grid_size.z - 1) || IsObstacle(cell_idx + int3(0, 0, 1));
                    bool obsB = (cz <= 0)                    || IsObstacle(cell_idx - int3(0, 0, 1));

                    float pR_raw = obsR ? p_center_raw : APIC_Pressure_Write[flat_idx + 1];
                    float pL_raw = obsL ? p_center_raw : APIC_Pressure_Write[flat_idx - 1];
                    float pU_raw = obsU ? p_center_raw : APIC_Pressure_Write[flat_idx + apic_grid_size.x];
                    float pD_raw = obsD ? p_center_raw : APIC_Pressure_Write[flat_idx - apic_grid_size.x];
                    float pF_raw = obsF ? p_center_raw : APIC_Pressure_Write[flat_idx + apic_grid_size.x * apic_grid_size.y];
                    float pB_raw = obsB ? p_center_raw : APIC_Pressure_Write[flat_idx - apic_grid_size.x * apic_grid_size.y];

                    float pR = max(0.0f, pR_raw); float pL = max(0.0f, pL_raw); 
                    float pU = max(0.0f, pU_raw); float pD = max(0.0f, pD_raw); 
                    float pF = max(0.0f, pF_raw); float pB = max(0.0f, pB_raw);

                    float3 grad_p = float3(pR - pL, pU - pD, pF - pB) / (2.0f * dx_apic);
                    float3 vel_star = float3(asfloat(APIC_Grid_VelX[flat_idx]), asfloat(APIC_Grid_VelY[flat_idx]), asfloat(APIC_Grid_VelZ[flat_idx]));
                    
                    corrected_vel = vel_star - (dt_apic / rho) * grad_p;
                }

                float3 d_pos = grid_pos - (float3)cell_idx;
                float3 weight_vec = QuadraticBSpline(d_pos);
                float weight = weight_vec.x * weight_vec.y * weight_vec.z;

                pic_velocity += corrected_vel * weight;
                new_c1 += weight * corrected_vel.x * d_pos;
                new_c2 += weight * corrected_vel.y * d_pos;
                new_c3 += weight * corrected_vel.z * d_pos;
            }
        }
    }

    float margin = 0.5f; 
    if (grid_pos.x < margin || grid_pos.x > apic_grid_size.x - 1.0f - margin ||
        grid_pos.y < margin || grid_pos.y > apic_grid_size.y - 1.0f - margin ||
        grid_pos.z < margin || grid_pos.z > apic_grid_size.z - 1.0f - margin)
    {
        new_c1 = 0.0f; new_c2 = 0.0f; new_c3 = 0.0f;
    }

    p.velocity = pic_velocity;
    p.c1 = new_c1 * 4.0f; p.c2 = new_c2 * 4.0f; p.c3 = new_c3 * 4.0f;
    APIC_Particle_Buffer[index] = p;
}

[numthreads(8, 8, 8)]
void ClearAPICGrid (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    uint idx = GetGridIndex(id);
    APIC_Grid_Mass[idx] = 0; APIC_Grid_VelX[idx] = 0; APIC_Grid_VelY[idx] = 0; APIC_Grid_VelZ[idx] = 0;
    APIC_Divergence[idx] = 0.0f; APIC_Pressure_Write[idx] = 0.0f;
}

[numthreads(64, 1, 1)]
void CondenseParticles (uint3 id : SV_DispatchThreadID)
{
    uint count = ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    uint index = ActiveParticleList_Read[id.x];
    uint p_len, p_stride;
    APIC_Particle_Buffer.GetDimensions(p_len, p_stride);
    if (index >= p_len) return;

    APICParticle p = APIC_Particle_Buffer[index];
    if (p.mass <= 0.0f) return;

    int grid_w = swe_grid_size.x;
    int grid_h = swe_grid_size.y; // 【修正】追加

    float2 swe_local_pos = p.position.xy - swe_world_offset;
    float2 swe_pos = swe_local_pos / dx_swe;
    int2 center_idx = (int2)floor(swe_pos);
    int cx_center = clamp(center_idx.x, 0, grid_w - 1);
    int cy_center = clamp(center_idx.y, 0, grid_h - 1);

    p.age += dt_apic;

    uint flat_center = cy_center * grid_w + cx_center;

    int flipped_y = (int)swe_grid_size.y - 1 - cy_center;
    float b_c = TerrainHeightMap.Load(int3(cx_center, flipped_y, 0)).r;
    float2 cell_world_pos = swe_world_offset + float2(cx_center, cy_center) * dx_swe;
    float fft_y = GetFFTSurfaceY(cell_world_pos);
    float current_surface_z = b_c + SWE_State_Read[flat_center].h + fft_y;

    // Z軸で判定。また、着水時の勢い（velocity.z）が強い場合は吸収させず、波として残す
    if (p.position.z <= current_surface_z && p.age > 0.1f && p.velocity.z < 2.0f)
    {
        float total_weight = 0.0f;
        [unroll]
        for (int i = -1; i <= 1; i++) {
            [unroll]
            for (int j = -1; j <= 1; j++) {
                int2 cell_idx = center_idx + int2(i, j);
                float2 cell_center = (float2)cell_idx + 0.5f;
                float2 d_pos = swe_pos - cell_center;
                float dist_sq = dot(d_pos, d_pos);
                float weight = max(0.0f, 1.0f - dist_sq * 0.5f);
                total_weight += weight;
            }
        }

        if (total_weight > 0.0f)
        {
            float swe_cell_area = dx_swe * dx_swe;
            [unroll]
            for (int i = -1; i <= 1; i++) {
                [unroll]
                for (int j = -1; j <= 1; j++) {
                    int2 cell_idx = center_idx + int2(i, j);
                    float2 cell_center = (float2)cell_idx + 0.5f;
                    float2 d_pos = swe_pos - cell_center; 
                    float dist_sq = dot(d_pos, d_pos);
                    float weight = max(0.0f, 1.0f - dist_sq * 0.5f) / total_weight;

                    float2 radial_dir = cell_center - swe_pos;
                    float r_len = max(length(radial_dir), 0.001f);
                    radial_dir /= r_len; 

                    int safe_x = clamp(cell_idx.x, 0, grid_w - 1);
                    int safe_y = clamp(cell_idx.y, 0, grid_w - 1);
                    uint flat_idx = safe_y * grid_w + safe_x;

                    float delta_hu_mass = p.mass * p.velocity.x * weight * horizontal_momentum_transfer;
                    float delta_hv_mass = p.mass * p.velocity.y * weight * horizontal_momentum_transfer;
                    float impact_energy = vertical_momentum_to_wave * p.mass * abs(p.velocity.z) * weight;
                    float current_h = max(SWE_State_Read[flat_idx].h, 0.01f);

                    // 水深が浅いほど、波の衝撃（hu, hvへの変換）を和らげる（1.0mで100%の力、それ以下は減衰）
                    float depth_factor = saturate(current_h / 1.0f); 

                    float delta_hu_wave = impact_energy * radial_dir.x * depth_factor;
                    float delta_hv_wave = impact_energy * radial_dir.y * depth_factor;

                    float delta_h = (p.mass * weight) / (rho * swe_cell_area);
                    float delta_hu = (delta_hu_mass + delta_hu_wave) / (rho * swe_cell_area);
                    float delta_hv = (delta_hv_mass + delta_hv_wave) / (rho * swe_cell_area);

                    InterlockedAdd(Delta_H_Buffer[flat_idx],  (int)(delta_h * 10000.0f));
                    InterlockedAdd(Delta_HU_Buffer[flat_idx], (int)(delta_h * 10000.0f)); // ※本来は delta_hu
                    InterlockedAdd(Delta_HV_Buffer[flat_idx], (int)(delta_h * 10000.0f)); // ※本来は delta_hv
                }
            }
        }
        p.mass = 0.0f;
    }
    APIC_Particle_Buffer[index] = p;
}

[numthreads(8,8,8)]
void BuildDiag(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;
    
    // 【修正】自身が地形なら対角成分は0
    if (APIC_Grid_Mass[flatIdx] == 0 || IsObstacle(id)) { PCG_Precon[flatIdx] = 0.0f; return; }

    float diag = 0;
    // 【修正】隣接セルが「地形ではない」場合のみカウントする
    if (id.x > 0 && !IsObstacle(id - uint3(1, 0, 0))) diag += 1.0f;
    if (id.x < (uint)apic_grid_size.x - 1 && !IsObstacle(id + uint3(1, 0, 0))) diag += 1.0f;
    if (id.y > 0 && !IsObstacle(id - uint3(0, 1, 0))) diag += 1.0f;
    if (id.y < (uint)apic_grid_size.y - 1 && !IsObstacle(id + uint3(0, 1, 0))) diag += 1.0f;
    if (id.z > 0 && !IsObstacle(id - uint3(0, 0, 1))) diag += 1.0f;
    if (id.z < (uint)apic_grid_size.z - 1 && !IsObstacle(id + uint3(0, 0, 1))) diag += 1.0f;

    PCG_Precon[flatIdx] = (diag > 0) ? (1.0f / diag) : 0.0f;
}

[numthreads(8, 8, 8)]
void InitCG(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;
    
    // 【修正】地形セルは完全にPCGから除外
    if (APIC_Grid_Mass[flatIdx] == 0 || IsObstacle(id)) { 
        APIC_Pressure_Write[flatIdx] = 0;
        PCG_R[flatIdx] = 0; PCG_P[flatIdx] = 0; PCG_Q[flatIdx] = 0;
        return; 
    }

    APIC_Pressure_Write[flatIdx] = 0; 
    float r = APIC_Divergence[flatIdx]; 
    PCG_R[flatIdx] = r; PCG_P[flatIdx] = r * PCG_Precon[flatIdx]; 
    PCG_Q[flatIdx] = 0;
}

[numthreads(8, 8, 8)]
void DotProductPreconditioned(uint3 id : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex)
{
    // 初期化
    shared_dot[groupIndex] = 0.0f;
    GroupMemoryBarrierWithGroupSync();

    if (id.x < (uint)apic_grid_size.x && id.y < (uint)apic_grid_size.y && id.z < (uint)apic_grid_size.z) {
        int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;
        
        // 質量があり、地形ではないセルのみ計算
        if (APIC_Grid_Mass[flatIdx] > 0 && !IsObstacle(id)) {
            shared_dot[groupIndex] = PCG_R[flatIdx] * PCG_R[flatIdx] * PCG_Precon[flatIdx];
        }
    }
    GroupMemoryBarrierWithGroupSync();

    // 並列リダクション（トーナメント方式で高速に合計値を算出）
    for (uint s = 256; s > 0; s >>= 1) {
        if (groupIndex < s) {
            shared_dot[groupIndex] += shared_dot[groupIndex + s];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    // スレッド0（代表者）だけがグローバルメモリに足し込む
    if (groupIndex == 0) {
        AtomicAddFloat(PCG_DotResult, 0, shared_dot[0]);
    }
}

[numthreads(1, 1, 1)]
void ComputeInitialRTr(uint3 id : SV_DispatchThreadID) {
    PCG_Scalars[0] = asfloat(PCG_DotResult[0]); 
    PCG_DotResult[0] = 0; 
}

[numthreads(8,8,8)]
void ApplyA(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;
    
    // 【修正】自身が地形なら結果は0
    if (APIC_Grid_Mass[flatIdx] == 0 || IsObstacle(id)) { PCG_Q[flatIdx] = 0; return; }

    float center = PCG_P[flatIdx];
    float result = 0.0f;
    
    // 【修正】隣接セルが「地形ではない」場合のみ圧力を伝播させる
    if (id.x > 0 && !IsObstacle(id - uint3(1, 0, 0))) {
        if (APIC_Grid_Mass[flatIdx - 1] > 0) result += (center - PCG_P[flatIdx - 1]);
        else result += center; // 空気セル境界
    }
    if (id.x < (uint)apic_grid_size.x - 1 && !IsObstacle(id + uint3(1, 0, 0))) {
        if (APIC_Grid_Mass[flatIdx + 1] > 0) result += (center - PCG_P[flatIdx + 1]);
        else result += center;
    }
    if (id.y > 0 && !IsObstacle(id - uint3(0, 1, 0))) {
        if (APIC_Grid_Mass[flatIdx - apic_grid_size.x] > 0) result += (center - PCG_P[flatIdx - apic_grid_size.x]); 
        else result += center; 
    }
    if (id.y < (uint)apic_grid_size.y - 1 && !IsObstacle(id + uint3(0, 1, 0))) {
        if (APIC_Grid_Mass[flatIdx + apic_grid_size.x] > 0) result += (center - PCG_P[flatIdx + apic_grid_size.x]); 
        else result += center; 
    }
    if (id.z > 0 && !IsObstacle(id - uint3(0, 0, 1))) { 
        if (APIC_Grid_Mass[flatIdx - apic_grid_size.x * apic_grid_size.y] > 0) result += (center - PCG_P[flatIdx - apic_grid_size.x * apic_grid_size.y]); 
        else result += center; 
    }
    if (id.z < (uint)apic_grid_size.z - 1 && !IsObstacle(id + uint3(0, 0, 1))) { 
        if (APIC_Grid_Mass[flatIdx + apic_grid_size.x * apic_grid_size.y] > 0) result += (center - PCG_P[flatIdx + apic_grid_size.x * apic_grid_size.y]); 
        else result += center; 
    }
    PCG_Q[flatIdx] = result;
}

[numthreads(8, 8, 8)]
void DotProductGeneric(uint3 id : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex) 
{
    shared_dot[groupIndex] = 0.0f;
    GroupMemoryBarrierWithGroupSync();

    if (id.x < (uint)apic_grid_size.x && id.y < (uint)apic_grid_size.y && id.z < (uint)apic_grid_size.z) {
        int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;
        if (APIC_Grid_Mass[flatIdx] > 0 && !IsObstacle(id)) {
            shared_dot[groupIndex] = PCG_P[flatIdx] * PCG_Q[flatIdx];
        }
    }
    GroupMemoryBarrierWithGroupSync();

    for (uint s = 256; s > 0; s >>= 1) {
        if (groupIndex < s) {
            shared_dot[groupIndex] += shared_dot[groupIndex + s];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (groupIndex == 0) {
        AtomicAddFloat(PCG_DotResult, 0, shared_dot[0]);
    }
}

[numthreads(1, 1, 1)]
void CalculateAlpha(uint3 id : SV_DispatchThreadID) {
    float dAd = asfloat(PCG_DotResult[0]); 
    PCG_Scalars[1] = dAd;
    PCG_Scalars[2] = (dAd > 1e-15f) ? (PCG_Scalars[0] / dAd) : 0.0f; 
    PCG_DotResult[0] = 0; 
}

[numthreads(8, 8, 8)]
void UpdatePR(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z|| IsObstacle(id)) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;
    if (APIC_Grid_Mass[flatIdx] == 0) return;
    float alpha = PCG_Scalars[2];
    APIC_Pressure_Write[flatIdx] += alpha * PCG_P[flatIdx];
    PCG_R[flatIdx] -= alpha * PCG_Q[flatIdx];
}

[numthreads(1, 1, 1)]
void CalculateBeta(uint3 id : SV_DispatchThreadID) {
    float rTrNew = asfloat(PCG_DotResult[0]);
    PCG_Scalars[3] = rTrNew / (PCG_Scalars[0] + 1e-10f); 
    PCG_Scalars[4] = PCG_Scalars[0]; 
    PCG_Scalars[0] = rTrNew; 
    PCG_DotResult[0] = 0;
}

[numthreads(8, 8, 8)]
void UpdateD(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z|| IsObstacle(id)) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;
    if (APIC_Grid_Mass[flatIdx] == 0) return;
    PCG_P[flatIdx] = PCG_R[flatIdx] * PCG_Precon[flatIdx] + PCG_Scalars[3] * PCG_P[flatIdx];
}

[numthreads(64, 1, 1)]
void BuildActiveParticleList(uint3 id : SV_DispatchThreadID) {
    if (id.x >= max_particles) return;
    if (APIC_Particle_Buffer[id.x].mass > 0.0f) ActiveParticleList_Write.Append(id.x);
}

[numthreads(1, 1, 1)]
void SetupParticleDispatchArgs(uint3 id : SV_DispatchThreadID) {
    ParticleDispatchArgs[0] = (ParticleDispatchArgs[0] + 63) / 64; 
    ParticleDispatchArgs[1] = 1; ParticleDispatchArgs[2] = 1; 
}

[numthreads(1, 1, 1)]
void SetupMeshDrawArgs(uint3 id : SV_DispatchThreadID) {
    DrawArgsBuffer[1] = ActiveParticleCount.Load(0) * 3; 
}