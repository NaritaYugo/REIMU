#include "REIMU_Common.cginc"

RWStructuredBuffer<APICParticle> APIC_Particle_Buffer;
RWStructuredBuffer<uint> APIC_Grid_Mass;
RWStructuredBuffer<uint> APIC_Grid_VelX;
RWStructuredBuffer<uint> APIC_Grid_VelY;
RWStructuredBuffer<uint> APIC_Grid_VelZ;
RWStructuredBuffer<float> APIC_Divergence;
RWStructuredBuffer<float> APIC_Pressure_Write;
StructuredBuffer<SWECell> SWE_State_Read;
RWStructuredBuffer<uint> Delta_H_Buffer;
RWStructuredBuffer<uint> Delta_HU_Buffer;
RWStructuredBuffer<uint> Delta_HV_Buffer;
// --- PCG用バッファ ---
RWStructuredBuffer<float> PCG_R;       // _Residual に相当
RWStructuredBuffer<float> PCG_P;       // _SearchDir に相当
RWStructuredBuffer<float> PCG_Q;       // _Ap に相当
RWStructuredBuffer<float> PCG_Precon;  // _Precon (M^-1) に相当
RWStructuredBuffer<int> PCG_DotResult; // _DotResult に相当
RWStructuredBuffer<float> PCG_Scalars; // _CGVars に相当 [0: rTrOld, 1: dAd, 2: alpha, 3: beta, 4: rTrOldBackup]
// --- 追加：間接ディスパッチ用バッファ ---
AppendStructuredBuffer<uint> ActiveParticleList_Write;
StructuredBuffer<uint> ActiveParticleList_Read;
ByteAddressBuffer ActiveParticleCount; 
RWStructuredBuffer<uint> ParticleDispatchArgs;

RWStructuredBuffer<uint> DrawArgsBuffer;
uint max_particles;

#define DOT_SCALE 10000.0f // 精度を保つための固定小数点スケール

// --- 定数 ---
static const float G = 9.81f;
float horizontal_momentum_transfer;
float vertical_momentum_to_wave;

// APIC特有の Quadratic B-Spline 重み計算関数
inline float3 QuadraticBSpline(float3 x)
{
    float3 abs_x = abs(x);
    float3 w = 0.0f;
    // x, y, zそれぞれの成分について重みを計算 (分岐のないベクトル演算)
    w = (abs_x < 0.5f) ? (0.75f - abs_x * abs_x) :
        ((abs_x < 1.5f) ? (0.5f * (1.5f - abs_x) * (1.5f - abs_x)) : 0.0f);
    return w;
}

// 1次元インデックス取得用ヘルパー
inline uint GetGridIndex(uint3 id) {
    return id.z * (apic_grid_size.x * apic_grid_size.y) + id.y * apic_grid_size.x + id.x;
}

// B-Splineの勾配計算 (アフィン行列Cpの更新用)
inline float3 GradQuadraticBSpline(float3 x)
{
    float3 abs_x = abs(x);
    float3 sign_x = sign(x);
    float3 grad = 0.0f;
    grad = (abs_x < 0.5f) ? (-2.0f * x) :
           ((abs_x < 1.5f) ? (0.5f * sign_x * (2.0f * abs_x - 3.0f)) : 0.0f);
    return grad;
}

// --- SWEの境界情報を取得するヘルパー関数 ---
// 戻り値: xyz = SWEの速度(u, v, 0), w = 流体割合(theta = 1.0 - phi)
inline float4 GetSWEBoundaryInfo(uint3 apic_id)
{
    // M_ratio / 2 を足すことで、複数のSWEセルのうち「中央」のものをサンプリングする
    int swe_x = clamp((int)(apic_id.x * M_ratio + M_ratio / 2), 0, (int)swe_grid_size.x - 1);
    int swe_y = clamp((int)(apic_id.y * M_ratio + M_ratio / 2), 0, (int)swe_grid_size.y - 1);
    
    // 3x3の空間的ローパスフィルタで水面高さと流速を平滑化
    float smoothed_h = 0.0f;
    float smoothed_hu = 0.0f;
    float smoothed_hv = 0.0f;
    float weight_sum = 0.0f;

    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            int nx = clamp(swe_x + i, 0, (int)swe_grid_size.x - 1);
            int ny = clamp(swe_y + j, 0, (int)swe_grid_size.y - 1);
            SWECell n_swe = SWE_State_Read[ny * swe_grid_size.x + nx];
            
            // 中央を重視するガウシアン風ウェイト
            float w = (i == 0 && j == 0) ? 4.0f : ((abs(i) + abs(j) == 1) ? 2.0f : 1.0f);
            
            smoothed_h += n_swe.h * w;
            smoothed_hu += n_swe.hu * w;
            smoothed_hv += n_swe.hv * w;
            weight_sum += w;
        }
    }

    smoothed_h /= weight_sum;
    smoothed_hu /= weight_sum;
    smoothed_hv /= weight_sum;

    float z_bottom = apic_id.z * dx_apic;
    float phi = clamp((smoothed_h - z_bottom) / dx_apic, 0.0f, 1.0f);
    float theta = 1.0f - phi;
    
    float u_swe = (smoothed_h > 0.001f) ? smoothed_hu / smoothed_h : 0.0f;
    float v_swe = (smoothed_h > 0.001f) ? smoothed_hv / smoothed_h : 0.0f;
    
    return float4(u_swe, v_swe, 0.0f, theta);
}

// --- Step 1: APIC移流・外力適用 ---
[numthreads(64, 1, 1)]
void AdvectParticles (uint3 id : SV_DispatchThreadID)
{
    // リストの要素数より多ければリターン
    uint count = ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    // リストから「本当のインデックス」を取得
    uint index = ActiveParticleList_Read[id.x];
    APICParticle p = APIC_Particle_Buffer[index];

    // 質量が0以下の場合は無効な粒子としてスキップ
    if (p.mass <= 0.0f) return;

    // 重力を鉛直速度(w)に加算
    p.velocity.z -= G * dt_apic;

    // 位置の更新 (アフィン行列Cpの適用はG2P・P2Gの補間で行うため、ここでは単純移流)
    p.position += p.velocity * dt_apic;

    // --- 壁との衝突処理 (クランプと速度反射) ---
    float3 min_bounds = float3(0.0f, 0.0f, 0.0f);
    float3 max_bounds = float3(apic_grid_size.x * dx_apic, apic_grid_size.y * dx_apic, apic_grid_size.z * dx_apic);

    // X軸の壁
    if (p.position.x < min_bounds.x) { p.position.x = min_bounds.x; p.velocity.x *= -0.5f; }
    if (p.position.x > max_bounds.x) { p.position.x = max_bounds.x; p.velocity.x *= -0.5f; }

    // Y軸の壁
    if (p.position.y < min_bounds.y) { p.position.y = min_bounds.y; p.velocity.y *= -0.5f; }
    if (p.position.y > max_bounds.y) { p.position.y = max_bounds.y; p.velocity.y *= -0.5f; }

    // Z軸 (床と天井)
    if (p.position.z < min_bounds.z) { p.position.z = min_bounds.z; p.velocity.z *= -0.5f; }
    if (p.position.z > max_bounds.z) { p.position.z = max_bounds.z; p.velocity.z *= -0.5f; }

    // バッファに書き戻し
    APIC_Particle_Buffer[index] = p;
}

[numthreads(64, 1, 1)]
void P2G_Transfer (uint3 id : SV_DispatchThreadID)
{
    // リストの要素数より多ければリターン
    uint count = ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    // リストから「本当のインデックス」を取得
    uint index = ActiveParticleList_Read[id.x];
    APICParticle p = APIC_Particle_Buffer[index];

    if (p.mass <= 0.0f) return;

    float3 grid_pos = (p.position / dx_apic) - 0.5f;
    
    int3 base_idx = (int3)floor(grid_pos + 0.5f);

    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            [unroll]
            for (int k = -1; k <= 1; k++) {
                
                int3 cell_idx = base_idx + int3(i, j, k);
                
                int cx = clamp(cell_idx.x, 0, apic_grid_size.x - 1);
                int cy = clamp(cell_idx.y, 0, apic_grid_size.y - 1);
                int cz = clamp(cell_idx.z, 0, apic_grid_size.z - 1);

                float3 d_pos = grid_pos - (float3)cell_idx;
                float3 weight_vec = QuadraticBSpline(d_pos);
                float weight = weight_vec.x * weight_vec.y * weight_vec.z;

                if (weight > 0.0f)
                {
                    float3 affine_v = float3(
                        dot(p.c1, d_pos),
                        dot(p.c2, d_pos),
                        dot(p.c3, d_pos)
                    );
                    float3 grid_velocity = p.velocity + affine_v;

                    float mass_contrib = p.mass * weight;
                    float3 momentum_contrib = mass_contrib * grid_velocity;

                    uint flat_idx = cz * (apic_grid_size.x * apic_grid_size.y) 
                                  + cy * apic_grid_size.x 
                                  + cx;

                    AtomicAddFloat(APIC_Grid_Mass, flat_idx, mass_contrib);
                    AtomicAddFloat(APIC_Grid_VelX, flat_idx, momentum_contrib.x);
                    AtomicAddFloat(APIC_Grid_VelY, flat_idx, momentum_contrib.y);
                    AtomicAddFloat(APIC_Grid_VelZ, flat_idx, momentum_contrib.z);
                }
            }
        }
    }
}

// --- 1. グリッド速度の正規化 ---
// P2Gで集めた運動量を質量で割り、速度場にする
[numthreads(8, 8, 8)]
void NormalizeGridVelocity (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    uint idx = GetGridIndex(id);

    float mass = asfloat(APIC_Grid_Mass[idx]);
    if (mass > EPSILON)
    {
        // uintとして加算された値をfloatに戻して質量で割る
        float vx = asfloat(APIC_Grid_VelX[idx]) / mass;
        float vy = asfloat(APIC_Grid_VelY[idx]) / mass;
        float vz = asfloat(APIC_Grid_VelZ[idx]) / mass;

        // 次のステップのため、アトミックバッファにそのまま書き戻す(floatをuint化)
        APIC_Grid_VelX[idx] = asuint(vx);
        APIC_Grid_VelY[idx] = asuint(vy);
        APIC_Grid_VelZ[idx] = asuint(vz);
    }
    else
    {
        APIC_Grid_VelX[idx] = asuint(0.0f);
        APIC_Grid_VelY[idx] = asuint(0.0f);
        APIC_Grid_VelZ[idx] = asuint(0.0f);
    }
}

// --- 2. 速度場の発散 (Divergence) 計算 ---
// これが Poisson 方程式の右辺 (b) となります
[numthreads(8, 8, 8)]
void ComputeDivergence (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    uint idx = GetGridIndex(id);

    float4 center_info = GetSWEBoundaryInfo(id);
    float theta_c = center_info.w;

    // 質量がない、またはSWE内部に完全に沈んでいる(theta == 0)場合は計算除外
    if (asfloat(APIC_Grid_Mass[idx]) < 0.0001f || theta_c < 0.001f) {
        APIC_Divergence[idx] = 0.0f;
        return;
    }

    // 近傍の速度取得（グリッド外は0とする）
    float vR = (id.x < (uint)apic_grid_size.x - 1) ? asfloat(APIC_Grid_VelX[idx + 1]) : 0.0f;
    float vL = (id.x > 0) ? asfloat(APIC_Grid_VelX[idx - 1]) : 0.0f;
    float vU = (id.y < (uint)apic_grid_size.y - 1) ? asfloat(APIC_Grid_VelY[idx + apic_grid_size.x]) : 0.0f;
    float vD = (id.y > 0) ? asfloat(APIC_Grid_VelY[idx - apic_grid_size.x]) : 0.0f;
    float vF = (id.z < (uint)apic_grid_size.z - 1) ? asfloat(APIC_Grid_VelZ[idx + apic_grid_size.x * apic_grid_size.y]) : 0.0f;
    float vB = (id.z > 0) ? asfloat(APIC_Grid_VelZ[idx - apic_grid_size.x * apic_grid_size.y]) : 0.0f;

    // Neumann境界条件: 近傍セルがSWE内部（剛体）の場合、その面の速度をSWEの流速で上書きする
    if (id.x < (uint)apic_grid_size.x - 1 && GetSWEBoundaryInfo(id + uint3(1, 0, 0)).w < 0.5f) vR = center_info.x;
    if (id.x > 0                             && GetSWEBoundaryInfo(id - uint3(1, 0, 0)).w < 0.5f) vL = center_info.x;
    if (id.y < (uint)apic_grid_size.y - 1 && GetSWEBoundaryInfo(id + uint3(0, 1, 0)).w < 0.5f) vU = center_info.y;
    if (id.y > 0                             && GetSWEBoundaryInfo(id - uint3(0, 1, 0)).w < 0.5f) vD = center_info.y;
    if (id.z > 0                             && GetSWEBoundaryInfo(id - uint3(0, 0, 1)).w < 0.5f) vB = center_info.z; // 床方向の突き上げ

    float div = (vR - vL + vU - vD + vF - vB) / (2.0f * dx_apic);
    
    // Divergenceにも流体割合を掛けることで、浅瀬での爆発を防ぐ
    // オーバーフロー防止のため1/1000にスケール
    APIC_Divergence[idx] = -(rho * dx_apic * dx_apic / dt_apic) * div * theta_c / 1000.0f;
}

[numthreads(64, 1, 1)]
void G2P_Transfer (uint3 id : SV_DispatchThreadID)
{
    // リストの要素数より多ければリターン
    uint count = ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    // リストから「本当のインデックス」を取得
    uint index = ActiveParticleList_Read[id.x];
    APICParticle p = APIC_Particle_Buffer[index];

    if (p.mass <= 0.0f) return;

    // 【最重要修正1】P2Gと同様に座標系を-0.5シフト
    float3 grid_pos = (p.position / dx_apic) - 0.5f;
    int3 base_idx = (int3)floor(grid_pos + 0.5f);

    float3 pic_velocity = 0.0f;
    float3 new_c1 = 0.0f;
    float3 new_c2 = 0.0f;
    float3 new_c3 = 0.0f;

    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            [unroll]
            for (int k = -1; k <= 1; k++) {
                
                int3 cell_idx = base_idx + int3(i, j, k);
                
                // 【最重要修正2】クランプして境界の壁から速度をもらう
                int cx = clamp(cell_idx.x, 0, apic_grid_size.x - 1);
                int cy = clamp(cell_idx.y, 0, apic_grid_size.y - 1);
                int cz = clamp(cell_idx.z, 0, apic_grid_size.z - 1);

                uint flat_idx = cz * (apic_grid_size.x * apic_grid_size.y) + cy * apic_grid_size.x + cx;

                // 1. 生の圧力を取得（境界なら自分のセルの生の圧力をコピーしてNeumann条件を維持）
                float p_center_raw = APIC_Pressure_Write[flat_idx];
                float pR_raw = (cx < (uint)apic_grid_size.x - 1) ? APIC_Pressure_Write[flat_idx + 1] : p_center_raw;
                float pL_raw = (cx > 0) ? APIC_Pressure_Write[flat_idx - 1] : p_center_raw;
                float pU_raw = (cy < (uint)apic_grid_size.y - 1) ? APIC_Pressure_Write[flat_idx + apic_grid_size.x] : p_center_raw;
                float pD_raw = (cy > 0) ? APIC_Pressure_Write[flat_idx - apic_grid_size.x] : p_center_raw;
                float pF_raw = (cz < (uint)apic_grid_size.z - 1) ? APIC_Pressure_Write[flat_idx + apic_grid_size.x * apic_grid_size.y] : p_center_raw;
                float pB_raw = (cz > 0) ? APIC_Pressure_Write[flat_idx - apic_grid_size.x * apic_grid_size.y] : p_center_raw;

                // 2. 水は引張力（負圧）を持てないため、すべて 0.0 以上にクランプして真空を破壊する
                float pR = max(0.0f, pR_raw);
                float pL = max(0.0f, pL_raw);
                float pU = max(0.0f, pU_raw);
                float pD = max(0.0f, pD_raw);
                float pF = max(0.0f, pF_raw);
                float pB = max(0.0f, pB_raw);

                // 3. 勾配の計算
                float3 grad_p = float3(pR - pL, pU - pD, pF - pB) / (2.0f * dx_apic);
                grad_p /= 1000; // スケールを戻す
                
                float3 vel_star = float3(asfloat(APIC_Grid_VelX[flat_idx]), asfloat(APIC_Grid_VelY[flat_idx]), asfloat(APIC_Grid_VelZ[flat_idx]));
                float3 corrected_vel = vel_star - (dt_apic / rho) * grad_p;

                // d_pos は元のインデックスを使用
                float3 d_pos = grid_pos - (float3)cell_idx;
                float3 weight_vec = QuadraticBSpline(d_pos);
                float weight = weight_vec.x * weight_vec.y * weight_vec.z;

                pic_velocity += corrected_vel * weight;

                new_c1 += weight * corrected_vel.x * d_pos;
                new_c2 += weight * corrected_vel.y * d_pos;
                new_c3 += weight * corrected_vel.z * d_pos;
            }
        }
    }

    // 【境界発散防止】シフトした座標系に合わせてマージンチェックも変更
    // grid_pos は -0.5 ~ 63.5 の範囲を取るため、境界の判定を 0.0 と N-1.0 にする
    float margin = 0.5f; 
    if (grid_pos.x < margin || grid_pos.x > apic_grid_size.x - 1.0f - margin ||
        grid_pos.y < margin || grid_pos.y > apic_grid_size.y - 1.0f - margin ||
        grid_pos.z < margin || grid_pos.z > apic_grid_size.z - 1.0f - margin)
    {
        new_c1 = 0.0f;
        new_c2 = 0.0f;
        new_c3 = 0.0f;
    }

    p.velocity = pic_velocity;
    p.c1 = new_c1 * 4.0f;
    p.c2 = new_c2 * 4.0f;
    p.c3 = new_c3 * 4.0f;

    APIC_Particle_Buffer[index] = p;
}

// --- APICグリッドの初期化 (毎フレームの最初に行う) ---
[numthreads(8, 8, 8)]
void ClearAPICGrid (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    
    // 1次元インデックスの取得
    uint idx = GetGridIndex(id);

    // アトミック加算用バッファ (uint) のクリア
    APIC_Grid_Mass[idx] = 0;
    APIC_Grid_VelX[idx] = 0;
    APIC_Grid_VelY[idx] = 0;
    APIC_Grid_VelZ[idx] = 0;

    // 圧力・発散用バッファ (float) のクリア
    APIC_Divergence[idx] = 0.0f;
    APIC_Pressure_Write[idx] = 0.0f;
}

// --- Step 2: 凝縮フェーズ (APIC -> SWE) ---
[numthreads(64, 1, 1)]
void CondenseParticles (uint3 id : SV_DispatchThreadID)
{
    // リストの要素数より多ければリターン
    uint count = ActiveParticleCount.Load(0);
    if (id.x >= count) return;
    
    // リストから「本当のインデックス」を取得
    uint index = ActiveParticleList_Read[id.x];
    
    uint p_len, p_stride;
    APIC_Particle_Buffer.GetDimensions(p_len, p_stride);
    if (index >= p_len) return;

    APICParticle p = APIC_Particle_Buffer[index];
    if (p.mass <= 0.0f) return;

    int grid_w = swe_grid_size.x;

    float2 swe_pos = p.position.xy / dx_swe;
    int2 center_idx = (int2)floor(swe_pos);

    p.age += dt_apic;

    int cx_center = clamp(center_idx.x, 0, grid_w - 1);
    int cy_center = clamp(center_idx.y, 0, grid_w - 1);
    uint flat_center = cy_center * grid_w + cx_center;
    float current_h = SWE_State_Read[flat_center].h;

    // 水面に到達し、かつ生成直後(age>0.1)でない粒子を凝縮
    if (p.position.z <= current_h && p.age > 0.1f)
    {
        float total_weight = 0.0f;
        
        [unroll]
        for (int i = -1; i <= 1; i++) {
            [unroll]
            for (int j = -1; j <= 1; j++) {
                int2 cell_idx = center_idx + int2(i, j);
                float2 cell_center = (float2)cell_idx + 0.5f;
                float2 d_pos = swe_pos - cell_center;
                
                // ガウシアン風の重み付け（落下地点に近いほど影響大）
                float dist_sq = dot(d_pos, d_pos);
                float weight = max(0.0f, 1.0f - dist_sq * 0.5f);
                total_weight += weight;
            }
        }

        if (total_weight > 0.0f)
        {
            float swe_cell_area = dx_swe * dx_swe;
            
            [unroll]
            for (int i = -1; i <= 1; i++) {
                [unroll]
                for (int j = -1; j <= 1; j++) {
                    int2 cell_idx = center_idx + int2(i, j);
                    float2 cell_center = (float2)cell_idx + 0.5f;
                    float2 d_pos = swe_pos - cell_center; // 中心から落下点へのベクトル
                    
                    float dist_sq = dot(d_pos, d_pos);
                    float weight = max(0.0f, 1.0f - dist_sq * 0.5f) / total_weight;

                    // 落下地点(swe_pos)からセル中心(cell_center)へ向かう放射状ベクトルを計算
                    float2 radial_dir = cell_center - swe_pos;
                    float r_len = max(length(radial_dir), 0.001f);
                    radial_dir /= r_len; // 正規化して方向のみを抽出

                    // 水平運動量（粒子が元々持っていた横方向の勢い）
                    float delta_hu_mass = p.mass * p.velocity.x * weight * horizontal_momentum_transfer;
                    float delta_hv_mass = p.mass * p.velocity.y * weight * horizontal_momentum_transfer;

                    // 鉛直運動量起因の波（落下エネルギーを放射状の波紋に変換！）
                    float impact_energy = vertical_momentum_to_wave * p.mass * abs(p.velocity.z) * weight;
                    float delta_hu_wave = impact_energy * radial_dir.x;
                    float delta_hv_wave = impact_energy * radial_dir.y;

                    // 質量加算
                    float delta_h = (p.mass * weight) / (rho * swe_cell_area);
                    
                    // 減衰させた水平運動量と、新たに生まれた波紋のエネルギーを加算
                    float delta_hu = (delta_hu_mass + delta_hu_wave) / (rho * swe_cell_area);
                    float delta_hv = (delta_hv_mass + delta_hv_wave) / (rho * swe_cell_area);

                    int safe_x = clamp(cell_idx.x, 0, grid_w - 1);
                    int safe_y = clamp(cell_idx.y, 0, grid_w - 1);
                    uint flat_idx = safe_y * grid_w + safe_x;

                    // 少数（float）アトミック加算の独自ハック関数呼び出し
                    AtomicAddFloat(Delta_H_Buffer, flat_idx, delta_h);
                    AtomicAddFloat(Delta_HU_Buffer, flat_idx, delta_hu);
                    AtomicAddFloat(Delta_HV_Buffer, flat_idx, delta_hv);
                }
            }
        }
        
        // 凝縮完了により粒子を削除
        p.mass = 0.0f;
    }

    APIC_Particle_Buffer[index] = p;
}

// --- 0. 前処理行列（対角成分の逆数）の構築 ---
[numthreads(8,8,8)]
void BuildDiag(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;

    if (APIC_Grid_Mass[flatIdx] == 0) {
        PCG_Precon[flatIdx] = 0.0f;
        return;
    }

    float diag = 0;
    if (id.x > 0) diag += 1.0f;
    if (id.x < (uint)apic_grid_size.x - 1) diag += 1.0f;
    if (id.y > 0) diag += 1.0f;
    if (id.y < (uint)apic_grid_size.y - 1) diag += 1.0f;
    if (id.z > 0) diag += 1.0f;
    if (id.z < (uint)apic_grid_size.z - 1) diag += 1.0f;

    PCG_Precon[flatIdx] = (diag > 0) ? (1.0f / diag) : 0.0f;
}

// --- 1. PCG初期化 ---
[numthreads(8, 8, 8)]
void InitCG(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;

    APIC_Pressure_Write[flatIdx] = 0; // _Pressure に相当

    if (APIC_Grid_Mass[flatIdx] > 0) {
        float r = APIC_Divergence[flatIdx]; // b
        PCG_R[flatIdx] = r;
        PCG_P[flatIdx] = r * PCG_Precon[flatIdx]; // d = M^-1 * r
    } else {
        PCG_R[flatIdx] = 0;
        PCG_P[flatIdx] = 0;
    }
    PCG_Q[flatIdx] = 0;
}

// --- 2. 前処理付き内積 (Z * R) ---
[numthreads(8, 8, 8)]
void DotProductPreconditioned(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;

    if (APIC_Grid_Mass[flatIdx] == 0) return;

    float r = PCG_R[flatIdx];
    float minv = PCG_Precon[flatIdx];
    float val = r * r * minv; // r * z (z = r * minv)

    InterlockedAdd(PCG_DotResult[0], (int)(val * DOT_SCALE));
}

// 初期 rTr の保存
[numthreads(1, 1, 1)]
void ComputeInitialRTr(uint3 id : SV_DispatchThreadID)
{
    PCG_Scalars[0] = (float)PCG_DotResult[0] / DOT_SCALE;
    PCG_DotResult[0] = 0; // リセット
}

// --- 3. Apply A (Q = A * P) ---
[numthreads(8,8,8)]
void ApplyA(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;

    if (APIC_Grid_Mass[flatIdx] == 0) {
        PCG_Q[flatIdx] = 0;
        return;
    }

    float center = PCG_P[flatIdx];
    float result = 0.0f;

    if (id.x > 0) {
        if (APIC_Grid_Mass[flatIdx - 1] > 0) result += (center - PCG_P[flatIdx - 1]);
        else result += center;
    }
    if (id.x < (uint)apic_grid_size.x - 1) {
        if (APIC_Grid_Mass[flatIdx + 1] > 0) result += (center - PCG_P[flatIdx + 1]);
        else result += center;
    }
    
    if (id.y > 0) {
        if (APIC_Grid_Mass[flatIdx - apic_grid_size.x] > 0) result += (center - PCG_P[flatIdx - apic_grid_size.x]);
        else result += center;
    }
    if (id.y < (uint)apic_grid_size.y - 1) {
        if (APIC_Grid_Mass[flatIdx + apic_grid_size.x] > 0) result += (center - PCG_P[flatIdx + apic_grid_size.x]);
        else result += center;
    }
    
    if (id.z > 0) {
        if (APIC_Grid_Mass[flatIdx - apic_grid_size.x * apic_grid_size.y] > 0) result += (center - PCG_P[flatIdx - apic_grid_size.x * apic_grid_size.y]);
        else result += center;
    }
    if (id.z < (uint)apic_grid_size.z - 1) {
        if (APIC_Grid_Mass[flatIdx + apic_grid_size.x * apic_grid_size.y] > 0) result += (center - PCG_P[flatIdx + apic_grid_size.x * apic_grid_size.y]);
        else result += center;
    }

    PCG_Q[flatIdx] = result;
}

// --- 4. 汎用内積 (P * Q) ---
[numthreads(8, 8, 8)]
void DotProductGeneric(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;

    if (APIC_Grid_Mass[flatIdx] > 0) {
        float dot = PCG_P[flatIdx] * PCG_Q[flatIdx];
        InterlockedAdd(PCG_DotResult[0], (int)(dot * DOT_SCALE));
    }
}

// Alpha の計算
[numthreads(1, 1, 1)]
void CalculateAlpha(uint3 id : SV_DispatchThreadID) {
    float rTr = PCG_Scalars[0]; 
    float dAd = (float)PCG_DotResult[0] / DOT_SCALE; 
    
    PCG_Scalars[1] = dAd;
    if (dAd > 1e-15f) {
        PCG_Scalars[2] = rTr / dAd; // alpha
    } else {
        PCG_Scalars[2] = 0.0f; 
    }
    PCG_DotResult[0] = 0; 
}

// --- 5. 圧力と残差の更新 ---
[numthreads(8, 8, 8)]
void UpdatePR(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;

    if (APIC_Grid_Mass[flatIdx] == 0) return;

    float alpha = PCG_Scalars[2];
    APIC_Pressure_Write[flatIdx] += alpha * PCG_P[flatIdx];
    PCG_R[flatIdx] -= alpha * PCG_Q[flatIdx];
}

// Beta の計算 (DotProductPreconditioned の直後に呼ばれる)
[numthreads(1, 1, 1)]
void CalculateBeta(uint3 id : SV_DispatchThreadID) {
    float rTrNew = (float)PCG_DotResult[0] / DOT_SCALE;
    float rTrOld = PCG_Scalars[0];
    
    PCG_Scalars[3] = rTrNew / (rTrOld + 1e-10f); // beta
    PCG_Scalars[4] = rTrOld; 
    PCG_Scalars[0] = rTrNew; 
    PCG_DotResult[0] = 0;
}

// --- 6. 探索方向の更新 ---
[numthreads(8, 8, 8)]
void UpdateD(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)apic_grid_size.x || id.y >= (uint)apic_grid_size.y || id.z >= (uint)apic_grid_size.z) return;
    int flatIdx = id.x + id.y * apic_grid_size.x + id.z * apic_grid_size.x * apic_grid_size.y;

    if (APIC_Grid_Mass[flatIdx] == 0) return;

    float beta = PCG_Scalars[3];
    float z = PCG_R[flatIdx] * PCG_Precon[flatIdx];
    PCG_P[flatIdx] = z + beta * PCG_P[flatIdx];
}

// 1. 生きている粒子だけをリストに追加するカーネル
[numthreads(64, 1, 1)]
void BuildActiveParticleList(uint3 id : SV_DispatchThreadID) {
    if (id.x >= max_particles) return;
    if (APIC_Particle_Buffer[id.x].mass > 0.0f) {
        ActiveParticleList_Write.Append(id.x);
    }
}

// 2. DispatchIndirect用の引数（スレッドグループ数）をGPU内で計算するカーネル
[numthreads(1, 1, 1)]
void SetupParticleDispatchArgs(uint3 id : SV_DispatchThreadID) {
    uint count = ParticleDispatchArgs[0];
    ParticleDispatchArgs[0] = (count + 63) / 64; // X方向のグループ数
    ParticleDispatchArgs[1] = 1; // Y
    ParticleDispatchArgs[2] = 1; // Z
}

[numthreads(1, 1, 1)]
void SetupMeshDrawArgs(uint3 id : SV_DispatchThreadID) {
    uint count = ActiveParticleCount.Load(0);
    // 実際の有効パーティクル数の「3倍」の数を描画するようGPUに命令を書き込む
    DrawArgsBuffer[1] = count * 3; 
}