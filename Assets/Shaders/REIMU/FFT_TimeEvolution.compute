#pragma kernel CSMain

#define PI 3.14159265359

Texture2D<float4> H0_Texture;
uint N;
float Length;
float Gravity;
float Time;

RWTexture2D<float2> OutH_Spectrum;
RWTexture2D<float2> OutDx_Spectrum;
RWTexture2D<float2> OutDz_Spectrum;

float2 MultiplyComplex(float2 a, float2 b) {
    return float2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID) {
    if (id.x >= N || id.y >= N) return;

    // 【修正】Centered K-Space に合わせる
    int kx_int = (int)id.x - (int)(N / 2);
    int ky_int = (int)id.y - (int)(N / 2);
    float2 k_vec = float2(kx_int, ky_int) * (2.0 * PI / Length);
    float k_len = length(k_vec);

    if (k_len < 0.0001) {
        OutH_Spectrum[id.xy] = float2(0.0, 0.0);
        OutDx_Spectrum[id.xy] = float2(0.0, 0.0);
        OutDz_Spectrum[id.xy] = float2(0.0, 0.0);
        return;
    }

    // 【修正】中心配置における完全な逆方向(-k)のインデックス取得
    uint minus_ix = (N - id.x) % N;
    uint minus_iy = (N - id.y) % N;
    
    float2 h0_k = H0_Texture[id.xy].xy;
    float2 h0_minus_k = H0_Texture[uint2(minus_ix, minus_iy)].xy;

    float omega = sqrt(Gravity * k_len);
    float phase = -omega * Time;
    float c = cos(phase);
    float s = sin(phase);
    float2 exp_iwt = float2(c, s);
    float2 exp_minus_iwt = float2(c, -s);

    float2 h0_minus_k_conj = float2(h0_minus_k.x, -h0_minus_k.y);
    float2 h_k_t = MultiplyComplex(h0_k, exp_iwt) + MultiplyComplex(h0_minus_k_conj, exp_minus_iwt);
    
    OutH_Spectrum[id.xy] = h_k_t;

    float inv_k = 1.0 / k_len;

    // -i ではなく +i を掛けて位相を正しく90度進める
    float2 plus_i_H = float2(-h_k_t.y, h_k_t.x); 

    OutDx_Spectrum[id.xy] = plus_i_H * (k_vec.x * inv_k);
    OutDz_Spectrum[id.xy] = plus_i_H * (k_vec.y * inv_k);
}