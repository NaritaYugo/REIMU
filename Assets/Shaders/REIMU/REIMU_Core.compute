#pragma kernel InitParticles
#pragma kernel ClearGridBuffers
#pragma kernel CondenseToSWE
#pragma kernel SublimateToAPIC
#pragma kernel ClearHFlip
#pragma kernel AddParticleHeight
#pragma kernel InitHFlip
#pragma kernel SmoothHFlip
#pragma kernel CopyHFlip

// ==========================================
// 構造体定義
// ==========================================

struct Particle {
    float2 position;
    float2 velocity;
    float mass;
    float4 C; // 2x2アフィン行列 (C11, C12, C21, C22)
    float age;
};

struct SWEGrid {
    float h; // 水深
    float u; // 水平流速
};

// ==========================================
// 定数バッファ
// ==========================================
uint _MaxParticles;
uint _SWEGridResolution;
float _FixedPointMultiplier; // アトミック加算用のスケール (例: 1000000.0)

cbuffer CondenseParams {
    uint _ActiveParticleCount;
    float _SWEGridSpacing;
};

cbuffer SublimateParams {
    float _SublimateThreshold; // 砕波の閾値（例: 2.0）
    float _ParticleMass;       // 1粒子の質量（0.01）
    float _SWEGridSpacing_Sub; // グリッド幅
};

// ==========================================
// バッファ定義
// ==========================================

// 粒子データ
RWStructuredBuffer<Particle> _ParticleBuffer;

// 動的粒子管理 (インデックスのプール)
AppendStructuredBuffer<uint> _PoolAppendBuffer;
ConsumeStructuredBuffer<uint> _PoolConsumeBuffer;

// アクティブな粒子のインデックス
AppendStructuredBuffer<uint> _ActiveAppendBuffer;
ConsumeStructuredBuffer<uint> _ActiveConsumeBuffer;

// SWEグリッドデータ
RWStructuredBuffer<SWEGrid> _SWEBuffer;

// 凝縮(ALIP to SWE)受け取り用固定小数点バッファ
RWStructuredBuffer<int> _SWEMassSourceInt;
RWStructuredBuffer<int> _SWEMomentumSourceInt;

RWStructuredBuffer<uint> _ActiveBufferRW;

// 見た目の高さ
RWStructuredBuffer<float> _HFlipBuffer;
RWStructuredBuffer<float> _HFlipBufferTemp;
RWStructuredBuffer<int> _ParticleHeightInt;

// ==========================================
// ヘルパー関数
// ==========================================

// 乱数生成（飛沫のノイズ用）
float rand(float2 co) {
    return frac(sin(dot(co.xy ,float2(12.9898,78.233))) * 43758.5453);
}

// ==========================================
// カーネル
// ==========================================

// シミュレーション開始時に一度だけ呼ばれ、全インデックスをPoolに突っ込む
[numthreads(64, 1, 1)]
void InitParticles(uint3 id : SV_DispatchThreadID) {
    if (id.x >= _MaxParticles) return;
    
    // 初期状態では全粒子が未使用(Pool)
    _PoolAppendBuffer.Append(id.x);
    
    // 構造体の初期化
    Particle p;
    p.position = float2(0, 0);
    p.velocity = float2(0, 0);
    p.mass = 0;
    p.C = float4(0, 0, 0, 0);
    p.age = 0;
    _ParticleBuffer[id.x] = p;
}

// 毎フレーム（またはサブサイクル）ごとにソースバッファをクリア
[numthreads(64, 1, 1)]
void ClearGridBuffers(uint3 id : SV_DispatchThreadID) {
    if (id.x >= _SWEGridResolution) return;
    
    _SWEMassSourceInt[id.x] = 0;
    _SWEMomentumSourceInt[id.x] = 0;
}

[numthreads(64, 1, 1)]
void CondenseToSWE(uint3 id : SV_DispatchThreadID) {
    if (id.x >= _MaxParticles) return;
    Particle p = _ParticleBuffer[id.x];
    if (p.mass <= 0) return;

    // 寿命が残っている粒子は吸収しない（昇華直後の粒子は保護）
    if (p.age < 0.5) return; // age閾値を大きく

    int sweIndex = clamp(floor(p.position.x / _SWEGridSpacing_Sub), 0, _SWEGridResolution - 1);
    SWEGrid state = _SWEBuffer[sweIndex];
    float h_flip = _HFlipBuffer[sweIndex];

    float dx = max(_SWEGridSpacing_Sub, 0.05);
    float dh_dx = 0;
    bool isCalm = (abs(state.u) < 0.1) && (abs(state.h - h_flip) < 0.1);

    // 1フレームで吸収できる質量キャップ（10%）
    float maxAbsorb = state.h * 0.1;
    float absorbMass = min(p.mass, maxAbsorb);

    if (p.position.y <= h_flip + 0.1) {
        if (state.h < 0.5 || isCalm) {
            float relSpeed = length(p.velocity - float2(state.u, 0));
            if (relSpeed < 1.0 || p.position.y < h_flip - 0.2) {
                InterlockedAdd(_SWEMassSourceInt[sweIndex], (int)(absorbMass * _FixedPointMultiplier));
                float momentumX = absorbMass * p.velocity.x;
                InterlockedAdd(_SWEMomentumSourceInt[sweIndex], (int)(momentumX * _FixedPointMultiplier));

                p.mass -= absorbMass;
                if (p.mass <= 0.0) {
                    p.position = float2(-1000, -1000);
                    _PoolAppendBuffer.Append(id.x);
                }
                _ParticleBuffer[id.x] = p;
            }
        }
    }
}

#pragma kernel DummySetup

// 描画テスト用のダミーデータ生成（1回だけ呼ぶ）
[numthreads(64, 1, 1)]
void DummySetup(uint3 id : SV_DispatchThreadID) {
    if (id.x < _SWEGridResolution) {
        // SWEは真ん中が盛り上がったダムブレイク
        if (id.x > 400 && id.x < 600) {
            _SWEBuffer[id.x].h = 8.0; 
        } else {
            _SWEBuffer[id.x].h = 4.0;
        }
        _SWEBuffer[id.x].u = 0.0;
    }

    if (id.x < 1000) {
        uint pIndex = _PoolConsumeBuffer.Consume();
        
        // 【修正】粒子を 50個 x 20段 の四角いブロック状に並べる
        float px = 4.0 + (id.x % 50) * 0.1; // Xは 4.0 ～ 9.0 の間
        float py = 3.0 + (id.x / 50) * 0.1; // Yは 3.0 ～ 5.0 の間 (空中に浮かせる)
        
        _ParticleBuffer[pIndex].position = float2(px, py);
        _ParticleBuffer[pIndex].velocity = float2(0, 0);
        _ParticleBuffer[pIndex].mass = 0.01;
        
    }
}

[numthreads(64, 1, 1)]
void SublimateToAPIC(uint3 id : SV_DispatchThreadID) {
    uint i = id.x;
    if (i <= 1 || i >= _SWEGridResolution - 2) return;

    SWEGrid state = _SWEBuffer[i];
    float baseDepth = 0.5; 
    if (state.h <= baseDepth) return; 

    SWEGrid stateL = _SWEBuffer[i - 1];
    SWEGrid stateR = _SWEBuffer[i + 1];

    float dx = max(_SWEGridSpacing_Sub, 0.05);
    float dh_dx = (stateR.h - stateL.h) / (2.0 * dx);
    float du_dx = (stateR.u - stateL.u) / (2.0 * dx);
    float d2h_dx2 = (stateR.h - 2.0 * state.h + stateL.h) / (dx * dx);

    // 曲率判定・横分配・質量キャップ
    bool isActive = (abs(dh_dx) > 0.05) || (abs(du_dx) > 0.05) || (abs(state.u) > 0.2) || (d2h_dx2 < -0.5);
    if (state.h > baseDepth * 1.5) isActive = true;

    if (isActive) {
        float excessDepth = max(0.0, state.h - baseDepth);
        float maxGen = max(0.0, state.h * 0.1); // 生成キャップ
        float targetMass = min(excessDepth * _SWEGridSpacing_Sub, maxGen);
        targetMass = max(0.0, targetMass); // 負の質量防止

        // 流速異常時は粒子生成抑制
        if (abs(state.u) > 5.0) return;

        int N = (int)(targetMass / _ParticleMass);
        if (N <= 0) return;
        N = min(N, 100);

        float actualMassReduce = N * _ParticleMass;
        actualMassReduce = max(0.0, actualMassReduce); // 負の質量防止

        InterlockedAdd(_SWEMassSourceInt[i], -(int)(actualMassReduce * _FixedPointMultiplier));
        float momentumX = actualMassReduce * state.u;
        momentumX = max(0.0, momentumX); // 負の運動量防止
        InterlockedAdd(_SWEMomentumSourceInt[i], -(int)(momentumX * _FixedPointMultiplier));

        float safe_u = clamp(state.u, -8.0, 8.0);
        float w_surface = clamp(-state.h * du_dx, -2.0, 8.0);

        for (int k = 0; k < N; k++) {
            uint pIndex = _PoolConsumeBuffer.Consume();
            Particle p;
            p.mass = _ParticleMass;
            p.age = 0.0;

            float seedX = i + k * 13.37 + state.h;
            float seedY = k * 7.77 + state.u;
            float randX = frac(sin(seedX) * 43758.5453);
            float randY = frac(cos(seedY) * 43758.5453);

            float px = i * _SWEGridSpacing_Sub + (randX - 0.5) * _SWEGridSpacing_Sub * 1.5;
            float py = baseDepth + randY * excessDepth;

            p.position = float2(px, py);

            float w_local = w_surface * ((py - baseDepth) / max(excessDepth, 1e-4));

            p.velocity = float2(
                safe_u + (randX - 0.5) * 3.0,
                w_local + randY * 2.0
            );

            p.C = float4(0.0, 0.0, 0.0, 0.0);
            _ParticleBuffer[pIndex] = p;
        }
    }
}

// 1. バッファのクリア
[numthreads(64, 1, 1)]
void ClearHFlip(uint3 id : SV_DispatchThreadID) {
    if (id.x >= _SWEGridResolution) return;
    _ParticleHeightInt[id.x] = 0;
}

// 2. 空中のAPIC粒子の体積を1次元グリッドにアトミック加算
[numthreads(64, 1, 1)]
void AddParticleHeight(uint3 id : SV_DispatchThreadID) {
    if (id.x >= _MaxParticles) return;
    Particle p = _ParticleBuffer[id.x];
    if (p.mass <= 0) return;
    
    // 分布して隣接セルにも重みを与える（線形補間）
    float cellF = p.position.x / _SWEGridSpacing_Sub;
    int i0 = clamp((int)floor(cellF), 0, (int)_SWEGridResolution - 1);
    int i1 = min(i0 + 1, (int)_SWEGridResolution - 1);
    float w1 = frac(cellF);
    float w0 = 1.0 - w1;
    float h_contrib = p.mass / _SWEGridSpacing_Sub;
    InterlockedAdd(_ParticleHeightInt[i0], (int)(h_contrib * w0 * _FixedPointMultiplier));
    InterlockedAdd(_ParticleHeightInt[i1], (int)(h_contrib * w1 * _FixedPointMultiplier));
}

// 3. h_SWE と 空中粒子の高さを合成して h_FLIP のベースを作る
[numthreads(64, 1, 1)]
void InitHFlip(uint3 id : SV_DispatchThreadID) {
    uint i = id.x;
    if (i >= _SWEGridResolution) return;
    
    float pHeight = (float)_ParticleHeightInt[i] / _FixedPointMultiplier;
    _HFlipBuffer[i] = _SWEBuffer[i].h + pHeight;
}

// 4. 拡散方程式によるイージング（平滑化）
[numthreads(64, 1, 1)]
void SmoothHFlip(uint3 id : SV_DispatchThreadID) {
    uint i = id.x;
    if (i >= _SWEGridResolution) return;

    // 端の処理（ノイマン境界）
    float hL = (i > 0) ? _HFlipBuffer[i - 1] : _HFlipBuffer[i];
    float hR = (i < _SWEGridResolution - 1) ? _HFlipBuffer[i + 1] : _HFlipBuffer[i];
    float hC = _HFlipBuffer[i];

    // 拡散係数 (0.0 ～ 0.5 の間で調整。高いほど滑らかになる)
    float alpha = 0.25; 
    _HFlipBufferTemp[i] = hC + alpha * (hL - 2.0 * hC + hR);
}

// 5. 平滑化バッファの入れ替え
[numthreads(64, 1, 1)]
void CopyHFlip(uint3 id : SV_DispatchThreadID) {
    uint i = id.x;
    if (i >= _SWEGridResolution) return;
    _HFlipBuffer[i] = _HFlipBufferTemp[i];
}