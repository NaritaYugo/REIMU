#pragma kernel UpdateSWE
#pragma kernel SublimateSWEtoAPIC
#pragma kernel ApplyCondensation
#pragma kernel InteractSWE
#pragma kernel ShiftSWEGrid

#include "REIMU_Common.cginc"

StructuredBuffer<SWECell> SWE_State_Read;
RWStructuredBuffer<SWECell> SWE_State_Write;
RWStructuredBuffer<APICParticle> APIC_Particle_Buffer;
RWStructuredBuffer<uint> ParticleCounter;
StructuredBuffer<uint> Delta_H_Buffer;
StructuredBuffer<uint> Delta_HU_Buffer;
StructuredBuffer<uint> Delta_HV_Buffer;

uint sweTileSize; 
uint2 tileCount;  

AppendStructuredBuffer<uint> ActiveTileList_Write;
StructuredBuffer<uint> ActiveTileList_Read;
RWStructuredBuffer<uint> TileDispatchArgs;

static const float G = 9.81f;           
static const float H_MIN = 0.001f;      
uint max_particles;
float fr_threshold;
float grad_threshold;
float laplacian_threshold;
float conversion_rate_multiplier;
float push_z_multiplier;
float splash_velocity_multiplier;
int2 shift_amount;
float sea_bottom_z;

float2 mouse_pos;
float2 mouse_dir;
float mouse_radius;
float mouse_force;
int mouse_active;

Texture2D<float4> FFT_DispLOD0;
Texture2D<float4> FFT_DispLOD1;
Texture2D<float4> FFT_DispLOD2;
float FFT_Size0, FFT_Size1, FFT_Size2;
float2 swe_world_offset; 

SamplerState sampler_LinearRepeat
{
    Filter = MIN_MAG_MIP_LINEAR;
    AddressU = Wrap;
    AddressV = Wrap;
};

float3 GetFFTState(float2 worldPos)
{
    float2 uv0 = worldPos / FFT_Size0;
    float2 uv1 = worldPos / FFT_Size1;
    float2 uv2 = worldPos / FFT_Size2;

    float4 d0 = FFT_DispLOD0.SampleLevel(sampler_LinearRepeat, uv0, 0);
    float4 d1 = FFT_DispLOD1.SampleLevel(sampler_LinearRepeat, uv1, 0);
    float4 d2 = FFT_DispLOD2.SampleLevel(sampler_LinearRepeat, uv2, 0);

    float2 disp = float2(d0.x + d1.x + d2.x, d0.z + d1.z + d2.z);
    float2 samplePos = worldPos - disp;
    
    uv0 = samplePos / FFT_Size0;
    uv1 = samplePos / FFT_Size1;
    uv2 = samplePos / FFT_Size2;

    d0 = FFT_DispLOD0.SampleLevel(sampler_LinearRepeat, uv0, 0);
    d1 = FFT_DispLOD1.SampleLevel(sampler_LinearRepeat, uv1, 0);
    d2 = FFT_DispLOD2.SampleLevel(sampler_LinearRepeat, uv2, 0);

    float h_fft = -sea_bottom_z + d0.y + d1.y + d2.y;
    return float3(h_fft, 0.0f, 0.0f);
}

float3 GetSWEStateOrFFT(int cx, int cy)
{
    int grid_w = (int)swe_grid_size.x;
    int grid_h = (int)swe_grid_size.y;
    if (cx < 0 || cx >= grid_w || cy < 0 || cy >= grid_h) 
    {
        float2 worldPos = swe_world_offset + float2(cx, cy) * dx_swe;
        return GetFFTState(worldPos);
    }
    SWECell cell = SWE_State_Read[cy * grid_w + cx];
    return float3(cell.h, cell.hu, cell.hv);
}

inline float random(float2 uv) { return frac(sin(dot(uv, float2(12.9898f, 78.233f))) * 43758.5453f); }

inline float3 MinMod(float3 a, float3 b)
{
    float3 sign_a = sign(a);
    float3 sign_b = sign(b);
    float3 min_abs = min(abs(a), abs(b));
    return 0.5f * (sign_a + sign_b) * min_abs;
}

inline float2 GetVelocity(float h, float hu, float hv)
{
    if (h < H_MIN) return float2(0.0f, 0.0f);
    float h2 = h * h;
    float den = h2 + max(h2, 1e-6f);
    return float2((2.0f * h * hu) / den, (2.0f * h * hv) / den);
}

inline float3 ComputeFluxX(float h, float u, float v) { float q = h * u; return float3(q, q * u + 0.5f * G * h * h, q * v); }
inline float3 ComputeFluxY(float h, float u, float v) { float q = h * v; return float3(q, q * u, q * v + 0.5f * G * h * h); }

inline float3 HLL_FluxX(float3 UL, float3 UR)
{
    float2 vL = GetVelocity(UL.x, UL.y, UL.z);
    float2 vR = GetVelocity(UR.x, UR.y, UR.z);
    float cL = sqrt(G * max(UL.x, H_MIN));
    float cR = sqrt(G * max(UR.x, H_MIN));
    float sL = min(vL.x - cL, vR.x - cR);
    float sR = max(vL.x + cL, vR.x + cR);
    float3 FL = ComputeFluxX(UL.x, vL.x, vL.y);
    float3 FR = ComputeFluxX(UR.x, vR.x, vR.y);
    if (sL >= 0.0f) return FL;
    else if (sR <= 0.0f) return FR;
    else return (sR * FL - sL * FR + sL * sR * (UR - UL)) / (sR - sL);
}

inline float3 HLL_FluxY(float3 UB, float3 UT)
{
    float2 vB = GetVelocity(UB.x, UB.y, UB.z);
    float2 vT = GetVelocity(UT.x, UT.y, UT.z);
    float cB = sqrt(G * max(UB.x, H_MIN));
    float cT = sqrt(G * max(UT.x, H_MIN));
    float sL = min(vB.y - cB, vT.y - cT);
    float sR = max(vB.y + cB, vT.y + cT);
    float3 FB = ComputeFluxY(UB.x, vB.x, vB.y);
    float3 FT = ComputeFluxY(UT.x, vT.x, vT.y);
    if (sL >= 0.0f) return FB;
    else if (sR <= 0.0f) return FT;
    else return (sR * FB - sL * FT + sL * sR * (UT - UB)) / (sR - sL);
}

[numthreads(8, 8, 1)]
void UpdateSWE (uint3 id : SV_DispatchThreadID)
{
    int grid_w = (int)swe_grid_size.x;
    int grid_h = (int)swe_grid_size.y; 
    
    // スレッドIDをそのままグリッド座標として扱う
    int ix = (int)id.x;
    int iy = (int)id.y;

    if (ix >= grid_w || iy >= grid_h) return;
    uint index = iy * grid_w + ix;
    SWECell current = SWE_State_Read[index];

    // (ここから下は既存の流体計算ロジックと全く同じです)
    float3 U_LL = GetSWEStateOrFFT(ix - 2, iy);
    float3 U_L  = GetSWEStateOrFFT(ix - 1, iy);
    float3 U_C  = float3(current.h, current.hu, current.hv);
    float3 U_R  = GetSWEStateOrFFT(ix + 1, iy);
    float3 U_RR = GetSWEStateOrFFT(ix + 2, iy);

    float3 U_BB = GetSWEStateOrFFT(ix, iy - 2);
    float3 U_B  = GetSWEStateOrFFT(ix, iy - 1);
    float3 U_T  = GetSWEStateOrFFT(ix, iy + 1);
    float3 U_TT = GetSWEStateOrFFT(ix, iy + 2);

    float3 slopeX_L = MinMod(U_L - U_LL, U_C - U_L);
    float3 slopeX_C = MinMod(U_C - U_L,  U_R - U_C);
    float3 slopeX_R = MinMod(U_R - U_C,  U_RR - U_R);

    float3 UL_right_face = U_C + 0.5f * slopeX_C;
    float3 UR_right_face = U_R - 0.5f * slopeX_R;
    float3 UL_left_face  = U_L + 0.5f * slopeX_L;
    float3 UR_left_face  = U_C - 0.5f * slopeX_C;

    float3 slopeY_B = MinMod(U_B - U_BB, U_C - U_B);
    float3 slopeY_C = MinMod(U_C - U_B,  U_T - U_C);
    float3 slopeY_T = MinMod(U_T - U_C,  U_TT - U_T);

    float3 UB_top_face = U_C + 0.5f * slopeY_C;
    float3 UT_top_face = U_T - 0.5f * slopeY_T;
    float3 UB_bottom_face = U_B + 0.5f * slopeY_B;
    float3 UT_bottom_face = U_C - 0.5f * slopeY_C;

    float3 fluxX_right = HLL_FluxX(UL_right_face, UR_right_face);
    float3 fluxX_left  = HLL_FluxX(UL_left_face, UR_left_face);
    float3 fluxY_up    = HLL_FluxY(UB_top_face, UT_top_face);
    float3 fluxY_down  = HLL_FluxY(UB_bottom_face, UT_bottom_face);

    float dtdx = dt_swe / dx_swe;
    float3 dU = -dtdx * (fluxX_right - fluxX_left) - dtdx * (fluxY_up - fluxY_down);

    current.h  += dU.x;
    current.hu += dU.y;
    current.hv += dU.z;
    
    if (current.h < 0.001f) {
        current.h = 0.001f; current.hu = 0.0f; current.hv = 0.0f;
    }
    
    float new_h  = current.h;
    float new_hu = current.hu;
    float new_hv = current.hv;

    float n_manning = 0.01f; 
    float2 vel = GetVelocity(new_h, new_hu, new_hv);
    float speed = length(vel);
    float friction = (G * n_manning * n_manning * speed) / (pow(max(new_h, H_MIN), 0.3333f) + EPSILON);
    
    float damp = max(0.0f, 1.0f - dt_swe * friction);
    new_hu *= damp; new_hv *= damp;

    float max_safe_speed = 10.0f;
    if (speed > max_safe_speed) {
        float excess_speed = speed - max_safe_speed;
        float drag = max(0.0f, 1.0f - dt_swe * excess_speed * excess_speed * 0.05f);
        new_hu *= drag; new_hv *= drag;
    }

    float sponge_width = 12.0f; 
    float dist_x = min((float)ix, (float)(grid_w - 1 - ix));
    float dist_y = min((float)iy, (float)(grid_h - 1 - iy));
    float dist = min(dist_x, dist_y);
    float alpha = smoothstep(0.0f, 1.0f, dist / sponge_width);

    float2 cellWorldPos = swe_world_offset + float2(ix, iy) * dx_swe;
    float3 fft_state = GetFFTState(cellWorldPos);

    new_h  = lerp(fft_state.x, new_h, alpha);

    float vel_damp = lerp(0.95f, 1.0f, alpha); 
    new_hu *= vel_damp;
    new_hv *= vel_damp;

    SWECell nextState;
    nextState.h  = max(new_h, 0.0f);
    nextState.hu = (nextState.h > H_MIN) ? new_hu : 0.0f;
    nextState.hv = (nextState.h > H_MIN) ? new_hv : 0.0f;
    nextState.padding = 0.0f;
    SWE_State_Write[index] = nextState;
}

[numthreads(8, 8, 1)]
void SublimateSWEtoAPIC (uint3 id : SV_DispatchThreadID)
{
    int grid_w = (int)swe_grid_size.x;
    int ix = (int)id.x;
    int iy = (int)id.y;
    if (ix >= grid_w || iy >= (int)swe_grid_size.y) return;

    uint index = iy * grid_w + ix;
    SWECell current = SWE_State_Read[index];

    int margin = 14; 
    if (ix < margin || ix >= grid_w - margin || iy < margin || iy >= grid_w - margin) {
        SWE_State_Write[index] = current; return;
    }

    float h_min = 2.0f; 
    if (current.h <= h_min + 0.1f) {
        SWE_State_Write[index] = current; return;
    }

    float smooth_h = 0.0f; float smooth_hu = 0.0f; float smooth_hv = 0.0f; float weight_sum = 0.0f;
    [unroll]
    for (int i = -1; i <= 1; i++) {
        [unroll]
        for (int j = -1; j <= 1; j++) {
            int nx = clamp(ix + i, 0, grid_w - 1);
            int ny = clamp(iy + j, 0, grid_w - 1);
            SWECell n_swe = SWE_State_Read[ny * grid_w + nx];
            float w = (i == 0 && j == 0) ? 0.25f : ((abs(i) + abs(j) == 1) ? 0.125f : 0.0625f);
            smooth_h += n_swe.h * w; smooth_hu += n_swe.hu * w; smooth_hv += n_swe.hv * w; weight_sum += w;
        }
    }
    smooth_h /= weight_sum; smooth_hu /= weight_sum; smooth_hv /= weight_sum;

    float safe_dx = max(dx_swe, 0.001f);
    float safe_h = max(smooth_h, 0.001f);

    SWECell cL = SWE_State_Read[iy * grid_w + max(ix - 1, 0)];
    SWECell cR = SWE_State_Read[iy * grid_w + min(ix + 1, grid_w - 1)];
    SWECell cD = SWE_State_Read[max(iy - 1, 0) * grid_w + ix];
    SWECell cU = SWE_State_Read[min(iy + 1, grid_w - 1) * grid_w + ix];

    float u_c = smooth_hu / safe_h;
    float v_c = smooth_hv / safe_h;

    float dhdx = (cR.h - cL.h) / (2.0f * safe_dx);
    float dhdy = (cU.h - cD.h) / (2.0f * safe_dx);
    float grad_mag = sqrt(max(0.0f, dhdx * dhdx + dhdy * dhdy));
    float laplacian_h = (cL.h + cR.h + cD.h + cU.h - 4.0f * current.h) / (safe_dx * safe_dx);
    
    float speed = sqrt(max(0.0f, u_c * u_c + v_c * v_c));
    float fr = speed / sqrt(9.81f * safe_h);

    bool is_breaking = false;
    if (grad_mag > grad_threshold) is_breaking = true;          
    if (laplacian_h < laplacian_threshold) is_breaking = true;  
    if (fr > fr_threshold) is_breaking = true;               

    if (is_breaking)
    {
        float conversion_rate = 1.0f - exp(-conversion_rate_multiplier * dt_swe); 
        float delta_h = (current.h - h_min) * conversion_rate;
        if (delta_h < 0.05f) { SWE_State_Write[index] = current; return; }

        float sublimated_mass = rho * delta_h * safe_dx * safe_dx; 
        uint count = (uint)max(1.0f, sublimated_mass / base_mass);
        count = min(count, 50);

        float mass_per_particle = sublimated_mass / max(1.0f, (float)count);

        uint p_len, p_stride;
        APIC_Particle_Buffer.GetDimensions(p_len, p_stride);
        if (p_len == 0) p_len = 1000000;
        
        uint start_idx;
        InterlockedAdd(ParticleCounter[0], count, start_idx);
        uint spawned_count = 0;

        for (uint i = 0; i < count; i++)
        {
            uint p_idx = (start_idx + i) % p_len;
            if (APIC_Particle_Buffer[p_idx].mass > 0.001f) continue; 

            APICParticle p = (APICParticle)0;
            p.mass = mass_per_particle;
            p.age = 0.0f;

            float rx = frac(sin((ix + i) * 12.9898f + iy * 78.233f) * 43758.5453f);
            float ry = frac(sin(ix * 93.989f  + (iy + i) * 67.345f) * 43758.5453f);
            float rz = frac(sin((ix * iy) * 45.123f + i * 13.567f) * 43758.5453f);

            p.position.x = swe_world_offset.x + ((float)ix + rx) * dx_swe;
            p.position.y = swe_world_offset.y + ((float)iy + ry) * dx_swe;
            float spawn_base_z = sea_bottom_z + current.h - delta_h; 
            p.position.z = spawn_base_z + rz * delta_h;

            float2 flow_dir = float2(u_c, v_c);
            float flow_speed = length(flow_dir);
            if (flow_speed > 0.001f) flow_dir /= flow_speed;
            else flow_dir = float2(0.0f, 0.0f);

            float c_wave = sqrt(9.81f * safe_h);
            float curl_boost = c_wave * 0.8f; 
            float push_z = clamp(max(0.0f, -laplacian_h) * push_z_multiplier, 0.0f, c_wave);

            p.velocity.x = u_c + flow_dir.x * curl_boost + (rx - 0.5f) * 2.0f * dx_swe; 
            p.velocity.y = v_c + flow_dir.y * curl_boost + (ry - 0.5f) * 2.0f * dx_swe;
            p.velocity.z = push_z + (rz * splash_velocity_multiplier) * c_wave; 
            p.c1 = float3(0,0,0); p.c2 = float3(0,0,0); p.c3 = float3(0,0,0);

            APIC_Particle_Buffer[p_idx] = p;
            spawned_count++;
        }

        float actual_sublimated_mass = mass_per_particle * (float)spawned_count;
        float actual_delta_h = actual_sublimated_mass / (rho * safe_dx * safe_dx);
        current.h -= actual_delta_h;
        float remain_ratio = (current.h > 0.001f) ? (current.h / (current.h + actual_delta_h)) : 0.0f;
        current.hu *= remain_ratio;
        current.hv *= remain_ratio;
    }
    SWE_State_Write[index] = current;
}

[numthreads(8, 8, 1)]
void ApplyCondensation (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)swe_grid_size.x || id.y >= (uint)swe_grid_size.y) return;
    uint index = id.y * swe_grid_size.x + id.x;

    SWECell current = SWE_State_Read[index];
    current.h  += asfloat(Delta_H_Buffer[index]);
    current.hu += asfloat(Delta_HU_Buffer[index]);
    current.hv += asfloat(Delta_HV_Buffer[index]);
    SWE_State_Write[index] = current;
}

[numthreads(8, 8, 1)]
void InteractSWE (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)swe_grid_size.x || id.y >= (uint)swe_grid_size.y) return;

    uint index = id.y * swe_grid_size.x + id.x;
    SWECell current = SWE_State_Read[index];

    // マウスがアクティブな時だけ力を加算する
    if (mouse_active == 1)
    {
        float2 cell_world_pos = swe_world_offset + float2(id.x, id.y) * dx_swe;
        if (distance(cell_world_pos, mouse_pos) < mouse_radius)
        {
            current.hu += mouse_dir.x * mouse_force * dt_swe;
            current.hv += mouse_dir.y * mouse_force * dt_swe;
        }
    }

    // マウスの状態に関わらず、必ずWriteに書き戻す
    SWE_State_Write[index] = current;
}

[numthreads(8, 8, 1)]
void ShiftSWEGrid(uint3 id : SV_DispatchThreadID)
{
    int grid_w = (int)swe_grid_size.x;
    int grid_h = (int)swe_grid_size.y;
    int ix = (int)id.x;
    int iy = (int)id.y;
    if (ix >= grid_w || iy >= grid_h) return;

    int src_x = ix + shift_amount.x;
    int src_y = iy + shift_amount.y;
    uint dst_index = iy * grid_w + ix;
    SWECell nextState;

    if (src_x >= 0 && src_x < grid_w && src_y >= 0 && src_y < grid_h) {
        nextState = SWE_State_Read[src_y * grid_w + src_x];
    } else {
        float2 worldPos = swe_world_offset + float2(ix, iy) * dx_swe;
        float3 fft_state = GetFFTState(worldPos);
        nextState.h = max(fft_state.x, 0.001f);
        nextState.hu = 0.0f; nextState.hv = 0.0f; nextState.padding = 0.0f;
    }
    SWE_State_Write[dst_index] = nextState;
}